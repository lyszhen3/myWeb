{"type":"message","id":"35666949","parentId":"521ac0ed","timestamp":"2026-05-28T11:33:28.941Z","message":{"role":"toolResult","toolCallId":"call_89052c6df7864e2c8efe5e15","toolName":"read","content":[{"type":"text","text":"package com.alibaba.adp.fee.core.calculator;\r\n\r\nimport com.alibaba.adp.fee.api.model.AdpFeeCalcException;\r\nimport com.alibaba.adp.fee.api.model.fee.AdpLogisticsFee;\r\nimport com.alibaba.adp.fee.api.model.fee.PostFreeInfo;\r\nimport com.alibaba.adp.fee.api.model.request.AdpItemInfo;\r\nimport com.alibaba.adp.fee.api.model.request.AdpLogicOrder;\r\nimport com.alibaba.adp.fee.api.model.response.FreightSnapshot;\r\nimport com.alibaba.adp.fee.api.model.response.ItemLogisticsFeeDetail;\r\nimport com.alibaba.adp.fee.api.model.response.OrderFreightSnapshot;\r\nimport com.alibaba.adp.fee.api.model.response.OrderLogisticsFeeDetail;\r\nimport com.alibaba.adp.fee.api.model.response.template.FreightTemplateDTO;\r\nimport com.alibaba.adp.fee.api.model.response.template.PricingRuleDTO;\r\nimport com.alibaba.adp.fee.api.model.response.template.WeightPricingRuleDTO;\r\nimport com.alibaba.adp.fee.core.session.FreightItemInfo;\r\nimport com.alibaba.adp.fee.core.spi.FreightCalculator;\r\nimport com.alibaba.adp.fee.core.spi.FreightCollector;\r\nimport com.alibaba.adp.fee.core.spi.LogisticsGrouping;\r\nimport com.alibaba.adp.fee.core.spi.model.*;\r\nimport com.alibaba.adp.fee.core.spi.model.template.FreightTemplate;\r\nimport com.alibaba.adp.fee.core.spi.model.template.PricingRule;\r\nimport com.alibaba.adp.fee.core.spi.model.template.WeightPricingRule;\r\nimport com.alibaba.delivery.common.code.AdpServiceErrorCode;\r\nimport com.google.common.collect.Lists;\r\nimport com.google.common.collect.Maps;\r\nimport org.apache.commons.lang3.StringUtils;\r\nimport org.apache.commons.lang3.tuple.ImmutablePair;\r\nimport org.apache.commons.lang3.tuple.Pair;\r\nimport org.springframework.core.annotation.Order;\r\n\r\nimport java.util.List;\r\nimport java.util.Map;\r\nimport java.util.Objects;\r\nimport java.util.stream.Collectors;\r\n\r\n/**\r\n * 默认的运费计算实现\r\n * @Order 数字越大排序越靠后，运费计算仅取第一个准入的计算器\r\n * @author jiajun.njj 2021/6/15 5:58 下午\r\n */\r\n@Order(1000)\r\npublic class DefaultFreightCalculator implements LogisticsGrouping, FreightCalculator, FreightCollector {\r\n\r\n    private final String NORMAL = \"nomal\";\r\n\r\n    /**\r\n     * 运费计算准入\r\n     * @return 默认的运费计算器，全部准入\r\n     */\r\n    @Override\r\n    public boolean canCalculate(FreightGroup group) {\r\n        return true;\r\n    }\r\n\r\n    /**\r\n     * 当前分组的运费计算\r\n     * @param freightGroup 待计算分组\r\n     * @return 当前分组的运费信息\r\n     */\r\n    @Override\r\n    public GroupLogisticsFee calculate(FreightGroup freightGroup) {\r\n        GroupLogisticsFee groupLogisticsFee = new GroupLogisticsFee();\r\n        groupLogisticsFee.setIdentity(freightGroup.getIdentity());\r\n        groupLogisticsFee.setSeller(freightGroup.getSeller());\r\n\r\n        Pair<AdpLogisticsFee, FreightSnapshot> groupFeePair = doCalculate(freightGroup);\r\n        FreightSnapshot groupSnapshot = groupFeePair.getRight();\r\n        Map<String, FreightSnapshot> uniqueKeyToSnapshot = Maps.newHashMap();\r\n        for (AdpItemInfo itemInfo : freightGroup.getItemInfos()) {\r\n            uniqueKeyToSnapshot.put(itemInfo.getUniqueKey(), groupSnapshot);\r\n        }\r\n        AdpLogisticsFee groupFee = groupFeePair.getLeft();\r\n        List<ItemLogisticsFeeDetail> itemLogisticsFeeDetails = FeeApportionUtils.apportionToItem(groupFee, freightGroup.getItemInfos(), uniqueKeyToSnapshot, FreightAppointStrategy.PRICE);\r\n        groupLogisticsFee.setGroupFee(groupFee);\r\n        groupLogisticsFee.setItemLogisticsFees(itemLogisticsFeeDetails);\r\n        groupLogisticsFee.setFreightSnapshot(groupSnapshot);\r\n        return groupLogisticsFee;\r\n    }\r\n\r\n    /**\r\n     * 执行运费计算\r\n     * @param group 当前分组信息，包含商品列表和运费模版\r\n     * @return 当前分组的运费和运费快照\r\n     */\r\n    protected Pair<AdpLogisticsFee, FreightSnapshot> doCalculate(FreightGroup group) {\r\n        FreightTemplate freightTemplate = group.getFreightTemplate();\r\n        if (freightTemplate == null) {\r\n            throw new AdpFeeCalcException(AdpServiceErrorCode.DELIVEY_TEMPLATE_NOT_EXIST.getCode(), AdpServiceErrorCode.DELIVEY_TEMPLATE_NOT_EXIST.getMessage());\r\n        }\r\n        // 获取运费计价规则\r\n        PricingRule rule = freightTemplate.getRule(group);\r\n        // 计价规则为空时异常抛出阻断\r\n        if (rule == null) {\r\n            throw new AdpFeeCalcException(AdpServiceErrorCode.DELIVEY_TEMPLATE_NOT_EXIST.getCode(), AdpServiceErrorCode.DELIVEY_TEMPLATE_NOT_EXIST.getMessage());\r\n        }\r\n        // 运费计价\r\n        int currentFee = rule.pricing(group);\r\n        AdpLogisticsFee groupFee = new AdpLogisticsFee();\r\n        groupFee.setRealFee((long) currentFee);\r\n        // 构建运费快照信息\r\n        FreightSnapshot groupSnapshot = buildSnapshot(group);\r\n        groupSnapshot.setPostFee((long) currentFee);\r\n        groupSnapshot.setPricingType(rule.getPricingType());\r\n        groupFee.setFreeRequire(buildPostFreeInfo(freightTemplate, group, currentFee));\r\n        groupFee.setPostFree(freightTemplate.isPostFree());\r\n        return ImmutablePair.of(groupFee,groupSnapshot);\r\n    }\r\n\r\n    /**\r\n     * 依赖当前分组信息构建运费快照\r\n     * @param freightGroup 当前分组\r\n     * @return 运费快照\r\n     */\r\n    private FreightSnapshot buildSnapshot(FreightGroup freightGroup) {\r\n        FreightSnapshot freightSnapshot = new FreightSnapshot();\r\n        freightSnapshot.setCalculator(NORMAL);\r\n        freightSnapshot.setCount(freightGroup.getCount());\r\n        freightSnapshot.setPrice(freightGroup.getRealPrice());\r\n        freightSnapshot.setSize(freightGroup.getVolume());\r\n        freightSnapshot.setWeight(freightGroup.getWeight());\r\n        FreightTemplate freightTemplate = freightGroup.getFreightTemplate();\r\n        freightSnapshot.setTemplateId(freightTemplate.getTemplateId());\r\n        freightSnapshot.setTemplateVersion(freightTemplate.getVersion());\r\n        freightSnapshot.setToAreaCode(freightTemplate.getToAreaId());\r\n        freightSnapshot.setPostFree(freightTemplate.isPostFree());\r\n        return freightSnapshot;\r\n    }\r\n\r\n    /**\r\n     * 构建包邮信息\r\n     */\r\n    private PostFreeInfo buildPostFreeInfo(FreightTemplate freightTemplate, FreightGroup group, int currentFee) {\r\n        // 如果当前运费已经是0，不需要再构建包邮信息\r\n        if (currentFee <= 0) {\r\n            return null;\r\n        }\r\n        PricingRule postFreeRule = getPostFreeRule(freightTemplate, group);\r\n        if (postFreeRule == null) {\r\n            return null;\r\n        }\r\n        PostFreeInfo postFreeInfo = new PostFreeInfo();\r\n        long priceGap = postFreeRule.getPriceRange().lowerEndpoint() - group.getRealPrice();\r\n        postFreeInfo.setPriceGap(priceGap);\r\n        postFreeInfo.setDecreaseFreight((long) currentFee);\r\n        postFreeInfo.setMinPriceLimited(postFreeRule.getPriceRange().lowerEndpoint());\r\n        return postFreeInfo;\r\n    }\r\n\r\n    /**\r\n     * 忽略计价门槛获取包邮的计价规则\r\n     * @return 包邮的计价规则\r\n     */\r\n    private PricingRule getPostFreeRule(FreightTemplate freightTemplate, FreightGroup group) {\r\n        for (PricingRule pricingRule : freightTemplate.getPricingRules()) {\r\n            int pricing = pricingRule.pricing(group);\r\n            if (pricing == 0) {\r\n                return pricingRule;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * 默认的汇总\r\n     * 1. 把分组级的运费分摊到商品维度；\r\n     * 2. 在订单维度上对商品运费进行汇总；\r\n     */\r\n    @Override\r\n    public List<OrderLogisticsFeeDetail> collect(LogisticsPackage logisticsPackage, List<GroupLogisticsFee> groupFees) {\r\n        List<OrderLogisticsFeeDetail> orderFees = Lists.newArrayList();\r\n        List<FreightSnapshot> sourceSnapshots = Lists.newArrayList();\r\n\r\n        // 商品的运费明细\r\n        Map<String, ItemLogisticsFeeDetail> itemLogisticsFeeDetailMap = Maps.newHashMap();\r\n        for (GroupLogisticsFee groupFee : groupFees) {\r\n            for (ItemLogisticsFeeDetail itemLogisticsFee : groupFee.getItemLogisticsFees()) {\r\n                itemLogisticsFeeDetailMap.put(itemLogisticsFee.getUniqueKey(), itemLogisticsFee);\r\n            }\r\n            FreightSnapshot freightSnapshot = groupFee.getFreightSnapshot();\r\n            sourceSnapshots.add(freightSnapshot);\r\n        }\r\n        for (AdpLogicOrder order : logisticsPackage.getOrders()) {\r\n            long orderPostFee = 0L;\r\n            List<ItemLogisticsFeeDetail> itemFees = Lists.newArrayList();\r\n            for (AdpItemInfo item : order.getItems()) {\r\n                ItemLogisticsFeeDetail itemLogisticsFeeDetail = itemLogisticsFeeDetailMap.get(item.getUniqueKey());\r\n                if (itemLogisticsFeeDetail == null) {\r\n                    continue;\r\n                }\r\n                itemFees.add(itemLogisticsFeeDetail);\r\n                orderPostFee += itemLogisticsFeeDetail.getPostFee();\r\n            }\r\n            OrderLogisticsFeeDetail orderLogisticsFeeDetail = new OrderLogisticsFeeDetail();\r\n            orderLogisticsFeeDetail.setOrderId(order.getOrderId());\r\n            orderLogisticsFeeDetail.setItemLogisticsFeeDetails(itemFees);\r\n\r\n            // 订单维度快照\r\n            OrderFreightSnapshot orderFreightSnapshot = new OrderFreightSnapshot();\r\n            orderFreightSnapshot.setSourceSnapshots(sourceSnapshots);\r\n            orderFreightSnapshot.setAggregateFreight(orderPostFee);\r\n            orderFreightSnapshot.setApportionedFreight(orderPostFee);\r\n            orderFreightSnapshot.setCollectType(\"GROUPSUM\");\r\n            orderLogisticsFeeDetail.setOrderFreightSnapshot(orderFreightSnapshot);\r\n\r\n            // 订单维度运费\r\n            AdpLogisticsFee orderFee = new AdpLogisticsFee();\r\n            orderFee.setRealFee(orderPostFee);\r\n            orderFee.setPostFree(orderPostFee == 0L);\r\n            orderLogisticsFeeDetail.setLogisticsFee(orderFee);\r\n\r\n            List<FreightTemplate> freightTemplates = logisticsPackage.getFreightItems().stream()\r\n                    .filter(Objects::nonNull)\r\n                    .filter(item -> StringUtils.equals(item.getSourceOrderId(), order.getOrderId()))\r\n                    .map(FreightItemInfo::getFreightTemplate)\r\n                    .filter(Objects::nonNull)\r\n                    .collect(Collectors.toList());\r\n            for (FreightTemplate freightTemplate : freightTemplates) {\r\n                if (freightTemplate.getTemplateId() != 0L) {\r\n                    orderLogisticsFeeDetail.setFreightTemplateDTO(convertFreightTemplate(freightTemplate));\r\n                    break;\r\n                }\r\n            }\r\n            orderFees.add(orderLogisticsFeeDetail);\r\n        }\r\n        return orderFees;\r\n    }\r\n\r\n    private FreightTemplateDTO convertFreightTemplate(FreightTemplate freightTemplate) {\r\n        FreightTemplateDTO freightTemplateDTO = new FreightTemplateDTO();\r\n        freightTemplateDTO.setTemplateId(freightTemplate.getTemplateId());\r\n        freightTemplateDTO.setTemplateType(freightTemplate.getTemplateType());\r\n        freightTemplateDTO.setUserId(freightTemplate.getUserId());\r\n        freightTemplateDTO.setToAreaId(freightTemplate.getToAreaId());\r\n        freightTemplateDTO.setVersion(freightTemplate.getVersion());\r\n        List<PricingRuleDTO> pricingRuleDTOList = freightTemplate.getPricingRules().stream().map(this::convertPricingRule).collect(Collectors.toList());\r\n        freightTemplateDTO.setPricingRuleDTOs(pricingRuleDTOList);\r\n        return freightTemplateDTO;\r\n    }\r\n\r\n    private PricingRuleDTO convertPricingRule(PricingRule pricingRule) {\r\n        if (Objects.isNull(pricingRule)) {\r\n            return new WeightPricingRuleDTO();\r\n        }\r\n        if (pricingRule instanceof WeightPricingRule) {\r\n            WeightPricingRule weightPricingRule = (WeightPricingRule) pricingRule;\r\n            WeightPricingRuleDTO weightPricingRuleDTO = new WeightPricingRuleDTO();\r\n            weightPricingRuleDTO.setAddWeight(weightPricingRule.getAddWeight());\r\n            weightPricingRuleDTO.setStartWeight(weightPricingRule.getStartWeight());\r\n            weightPricingRuleDTO.setStartFee(weightPricingRule.getStartFee());\r\n            weightPricingRuleDTO.setAddFee(weightPricingRule.getAddFee());\r\n            weightPricingRuleDTO.setPriceRange(weightPricingRule.getPriceRange());\r\n            return weightPricingRuleDTO;\r\n        } else {\r\n            return new WeightPricingRuleDTO();\r\n        }\r\n    }\r\n\r\n    /**\r\n     * 包邮要求合并\r\n     * 以包邮差值最小的为准，如果包邮差值一样则减免运费相加\r\n     * @param sourceRequire 原包邮要求\r\n     * @param targetRequire 待合并包邮要求\r\n     * @return 合并后的包邮要求\r\n     */\r\n    private PostFreeInfo mergePostFreeRequire(PostFreeInfo sourceRequire, PostFreeInfo targetRequire) {\r\n        PostFreeInfo requireResult = sourceRequire;\r\n        if (null == targetRequire) {\r\n            return requireResult;\r\n        }\r\n        if (null == sourceRequire || sourceRequire.getPriceGap() > targetRequire.getPriceGap()) {\r\n            requireResult = new PostFreeInfo();\r\n            requireResult.setPriceGap(targetRequire.getPriceGap());\r\n            requireResult.setMaxWeightLimited(targetRequire.getMaxWeightLimited());\r\n            requireResult.setMinPriceLimited(targetRequire.getMinPriceLimited());\r\n            requireResult.setDecreaseFreight(targetRequire.getDecreaseFreight());\r\n            return requireResult;\r\n        }\r\n        if (requireResult.getPriceGap() < targetRequire.getPriceGap()) {\r\n            return requireResult;\r\n        }\r\n        // TODO 待完善逻辑\r\n        return sourceRequire;\r\n    }\r\n\r\n    /**\r\n     * 默认实现是按照运费模版分组计算运费\r\n     */\r\n    @Override\r\n    public List<FreightGroup> grouping(LogisticsPackage logisticsPackage) {\r\n        List<FreightGroup> freightGroups = Lists.newArrayList();\r\n        Map<FreightTemplate, List<FreightItemInfo>> templateGroups = logisticsPackage.getFreightItems().stream().collect(Collectors.groupingBy(FreightItemInfo::getFreightTemplate));\r\n        for (Map.Entry<FreightTemplate, List<FreightItemInfo>> entry : templateGroups.entrySet()) {\r\n            FreightGroup freightGroup = new FreightGroup();\r\n            freightGroup.setIdentity(logisticsPackage.getIdentity());\r\n            List<AdpItemInfo> itemInfos = entry.getValue().stream().map(FreightItemInfo::getItemInfo).collect(Collectors.toList());\r\n            freightGroup.setItemInfos(itemInfos);\r\n            freightGroup.setFreightTemplate(entry.getKey());\r\n            freightGroup.setSeller(logisticsPackage.getSeller());\r\n            freightGroups.add(freightGroup);\r\n        }\r\n        return freightGroups;\r\n    }\r\n\r\n\r\n    @Override\r\n    public String identity() {\r\n        return NORMAL;\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779968008941}}
