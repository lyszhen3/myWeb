rn null;\r\n        }\r\n        // �����е�ӣ�detail��buy��̫һ�£���ʱ��������skuShipTime����ʱ��û�У����ﶵ��ȡһ��\r\n        return getSkuShipTime(carrier.getSkuShipTime(), carrier.getSkuFeatures());\r\n    }\r\n\r\n    public static String getSkuShipTime(String skuShipTime, Map<String, String> skuFeatures) {\r\n        if (StringUtils.isNotBlank(skuShipTime)) {\r\n            return skuShipTime;\r\n        }\r\n        if (MapUtils.isNotEmpty(skuFeatures)) {\r\n            return skuFeatures.get(SHIP_TIME);\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ��ȡ��Ʒ�ϵķ���ʱ��\r\n     */\r\n    public static String getItemShipTime(DeliveryCarrierDTO carrier) {\r\n        if (carrier == null) {\r\n            return null;\r\n        }\r\n        // �����е�ӣ�detail��buy��̫һ�£���ʱ��������itemShipTime����ʱ��û�У����ﶵ��ȡһ��\r\n        return getItemShipTime(carrier.getItemShipTime(), carrier.getFeatures());\r\n    }\r\n\r\n    public static String getItemShipTime(String itemShipTime, Map<String, String> itemFeatures) {\r\n        if (StringUtils.isNotBlank(itemShipTime)) {\r\n            return itemShipTime;\r\n        }\r\n        if (MapUtils.isNotEmpty(itemFeatures)) {\r\n            return itemFeatures.get(SHIP_TIME);\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ����ʽ������2019-10-11ת��Ϊ2019��10��11������\r\n     *\r\n     * @param time ��2019-10-11\r\n     * @return ��2019��10��11��\r\n     */\r\n    public static String formatAbsoluteText(String time) {\r\n        if (StringUtils.isBlank(time)) {\r\n            return null;\r\n        }\r\n\r\n        SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT);\r\n        try {\r\n            Date parsed = format.parse(time);\r\n            if (parsed != null) {\r\n                SimpleDateFormat display = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT2);\r\n                return display.format(parsed);\r\n            }\r\n        } catch (ParseException e) {\r\n            // ignore\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ����ʽ��2019-02-01ת��Ϊ2��1��\r\n     *\r\n     * @param time 2019-02-01\r\n     * @return 2��1��\r\n     */\r\n    public static String formatAbsoluteTextUseFmt4(String time) {\r\n        if (StringUtils.isBlank(time)) {\r\n            return null;\r\n        }\r\n\r\n        SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT);\r\n        try {\r\n            Date parsed = format.parse(time);\r\n            if (parsed != null) {\r\n                SimpleDateFormat display = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT4);\r\n                return display.format(parsed);\r\n            }\r\n        } catch (ParseException e) {\r\n            // ignore\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ����ʽ2019-10-11ת��Ϊ2019.10.12\r\n     *\r\n     * @param time 2019-10-11\r\n     * @return 2019.10.12\r\n     */\r\n    public static String formatNewPreSaleAbsoluteText(String time) {\r\n        if (StringUtils.isBlank(time)) {\r\n            return null;\r\n        }\r\n        SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT);\r\n        try {\r\n            Date parsed = format.parse(time);\r\n            if (parsed != null) {\r\n                Date afterAddOneDayDate = DateUtils.addDays(parsed, 1);\r\n                SimpleDateFormat display = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT3);\r\n                return display.format(afterAddOneDayDate);\r\n            }\r\n\r\n        } catch (ParseException e) {\r\n            // ignore\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ����ʽ������2019-10-11ת��Ϊ2019��10��11������\r\n     *\r\n     * @param time ��2019-10-11\r\n     * @return ��2019��10��11��\r\n     */\r\n    public static String formatAbsoluteText(String time, String pattern, String format) {\r\n        if (StringUtils.isBlank(time) || StringUtils.isBlank(pattern) || StringUtils.isBlank(format)) {\r\n            return null;\r\n        }\r\n\r\n        SimpleDateFormat simpleDateFormat = DateFormatCacheUtils.getSimpleDateFormat(pattern);\r\n        try {\r\n            Date parsed = simpleDateFormat.parse(time);\r\n            if (parsed != null) {\r\n                SimpleDateFormat display = DateFormatCacheUtils.getSimpleDateFormat(format);\r\n                return display.format(parsed);\r\n            }\r\n        } catch (ParseException e) {\r\n            // ignore\r\n        }\r\n        return null;\r\n    }\r\n\r\n    public static boolean isAbsoluteTime(String timeTag) {\r\n        return ABSOLUTE_TAG.equals(timeTag);\r\n    }\r\n\r\n    public static boolean isAbsoluteTimeByPrefix(String shipTime){\r\n        if(StringUtils.isBlank(shipTime)){\r\n            return false;\r\n        }\r\n        return shipTime.startsWith(PREFIX_ABSOLUTE_TIME_KEY);\r\n    }\r\n\r\n    public static boolean isRelativeTime(String timeTag) {\r\n        return RELATIVE_TIME_TAG.equals(timeTag);\r\n    }\r\n\r\n    public static boolean isRelativeTimeByPrefix(String shipTime){\r\n        if(StringUtils.isBlank(shipTime)){\r\n            return false;\r\n        }\r\n        return shipTime.startsWith(PREFIX_RELATIVE_TIME_KEY);\r\n    }\r\n\r\n    public static boolean isHour(String hourStr) {\r\n        return NumberUtils.isNumber(hourStr);\r\n    }\r\n\r\n    /**\r\n     * ��ȡ�ṹ�����ʱ�䣬leftΪ���ͣ�rightΪvalue\r\n     * ����\"1_2019-11-20\"��\"2_7\"��left��1��2��value��2019-11-20��7\r\n     */\r\n    public static Pair<String, String> getStructShipTime(String shipTime) {\r\n        if (StringUtils.isBlank(shipTime)) {\r\n            return null;\r\n        }\r\n\r\n        String[] split = shipTime.split(\"_\");\r\n        if (split.length != 2) {\r\n            return null;\r\n        }\r\n        //����ʱ�����ͣ�1�ǹ̶���2�����\r\n        String type = split[0];\r\n        //�̶�����ʱ��д����yyyy-MM-dd��ʽ����Է���ʱ��д��������\r\n        String time = split[1];\r\n\r\n        return Pair.of(type, time);\r\n    }\r\n\r\n    /**\r\n     * check������ķ���ʱ���Ƿ���ã���һЩ��è/�Ա��Ĺ���Ҫ��\r\n     *\r\n     * @param shipTime ����ʱ�䣬��\"1_2019-11-20\"��\"2_7\"\r\n     * @param userType �̼����ͣ��Ա�����è\r\n     * @return ���õķ���ʱ�䣬leftΪ���ͣ���ABSOLUTE_TAG = \"1\";RELATIVE_TIME_TAG = \"2\"; rightΪ�����ʱ��ֵ������Ϊ2019-11-20�����Ϊ7����\r\n     */\r\n    public static Pair<String, String> getValidShipTime(String shipTime, Integer userType) {\r\n        if (StringUtils.isBlank(shipTime) || userType == null) {\r\n            return null;\r\n        }\r\n        if (UserType.TAOBAO.getType() != userType && UserType.TMALL.getType() != userType && UserType.KAOLA.getType() != userType) {\r\n            // ������è/�Ա��ͷ���null\r\n            return null;\r\n        }\r\n\r\n        // �����Сʱ�������Ǽ���һ���Ա�������Լ�������ݣ�����1_xxx����2_xxx���֣�����Сʱ����\r\n        if (isHour(shipTime)) {\r\n            Integer day = convertFromHour2Day(shipTime);\r\n            if (day == null) {\r\n                return null;\r\n            }\r\n            // ������ϵ���������ȡ����ȫ��תΪ���ģʽ\r\n            return Pair.of(RELATIVE_TIME_TAG, String.valueOf(day));\r\n        }\r\n\r\n        String[] split = shipTime.split(\"_\");\r\n\r\n        if (split.length == 2) {\r\n            //����ʱ�����ͣ�1�ǹ̶���2�����\r\n            String type = split[0];\r\n            //�̶�����ʱ��д����yyyy-MM-dd��ʽ����Է���ʱ��д��������\r\n            String time = split[1];\r\n\r\n            // �Ա��̼Ҳ��ܸ�����\r\n            if (UserType.TAOBAO.getType() == userType) {\r\n                return Pair.of(type, time);\r\n            }\r\n\r\n            // ��Է���ʱ��\r\n            if (isRelativeTime(type)) {\r\n                if (StringUtils.isNumeric(time)) {\r\n                    // ֻ��>=3�����ϵķ���ʱ��ű���\r\n                    if (Integer.parseInt(time) >= AdpShipTimeConfig.getInstance().getDefaultRelativeShipTime()) {\r\n                        return Pair.of(type, time);\r\n                    } else {\r\n                        Bresson.newMetric(\"shipTime.invalid\", MapHelper.of(\"type\", \"���ʱ��\", \"time\", time)).increase();\r\n                    }\r\n                }\r\n            }\r\n\r\n            // ���Է���ʱ��\r\n            if (isAbsoluteTime(type)) {\r\n\t\t\t\tif (validAbsoluteTime(time, userType)) {\r\n\t\t\t\t\treturn Pair.of(type, time);\r\n\t\t\t\t} else {\r\n\t\t\t\t\tBresson.newMetric(\"shipTime.invalid\", MapHelper.of(\"type\", \"����ʱ��\", \"time\", time)).increase();\r\n\t\t\t\t}\r\n            }\r\n\r\n        }\r\n\r\n        return null;\r\n    }\r\n\r\n    public static boolean validAbsoluteTime(String time, Integer userType) {\r\n        try {\r\n            if (StringUtils.isBlank(time) || userType == null) {\r\n                return false;\r\n            }\r\n            SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT);\r\n            Date parsed = format.parse(time);\r\n\r\n            int beforeDays = 2;\r\n            // ��è���̼�У׼������1��\r\n            if (UserType.TMALL.getType() == userType || UserType.TAOBAO.getType() == userType) {\r\n                beforeDays = 1;\r\n            }\r\n\r\n            // ��ǰʱ��+beforeDays������ڷ���ʱ��֮�󣬾Ͳ����﷢��ʱ����\r\n            if (DateUtils.addDays(new Date(), beforeDays).before(parsed)) {\r\n                return true;\r\n            }\r\n\r\n        } catch (ParseException e) {\r\n            // ignore\r\n        }\r\n        return false;\r\n    }\r\n\r\n    public static Date parseAbsoluteShipTime(String shipTimeText){\r\n        if(StringUtils.isBlank(shipTimeText)){\r\n            return null;\r\n        }\r\n        String[] split = shipTimeText.split(\"_\");\r\n        if(split.length!=2){\r\n            return null;\r\n        }\r\n        return DateTimeUtil.toDate(split[1], DateTimeUtil.FORMAT_YEAR_MONTH_DAY_NO_ZONE);\r\n    }\r\n\r\n    /**\r\n     * ����shipTime ���������ڵ�����\r\n     * �����\"1_2023-07-05\"�򷵻�1\r\n     * ���\"2_7\"�򷵻�7��\r\n     */\r\n    public static Integer analysisShipTimeToDays(String shipTime){\r\n        if (StringUtils.isBlank(shipTime)) {\r\n            return null;\r\n        }\r\n        Pair<String, String> structShipTime = getStructShipTime(shipTime);\r\n        if (structShipTime == null){\r\n            return null;\r\n        }\r\n        String type = structShipTime.getLeft();\r\n        String time = structShipTime.getRight();\r\n        Integer timingDays = null;\r\n        //���ʱ��\r\n        if (ShipTimeUtils.isRelativeTime(type) && StringUtils.isNumeric(time)){\r\n            timingDays = Integer.valueOf(time);\r\n            return timingDays;\r\n        }\r\n        //����ʱ��\r\n        if (ShipTimeUtils.isAbsoluteTime(type)){\r\n            SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT);\r\n            try {\r\n                Date parsed = format.parse(time);\r\n                Integer dayBetweenDate = com.alibaba.delivery.logistics.utils.DateUtils.getDayBetweenDate(new Date(), parsed);\r\n                if (dayBetweenDate == null){\r\n                    return null;\r\n                }\r\n                timingDays = dayBetweenDate;\r\n                return timingDays;\r\n            } catch (ParseException e) {\r\n                return null;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ��ȡ��è8130Ԥ�۵���Ч����ʱ��\r\n     *\r\n     * @param shipTime\r\n     * @param userType\r\n     * @return\r\n     */\r\n    public static Pair<String, String> getTmallStepPreSaleValidShipTime(String shipTime, Integer userType) {\r\n        if (StringUtils.isBlank(shipTime) || userType == null) {\r\n            return null;\r\n        }\r\n        if (UserType.TMALL.getType() != userType) {\r\n            // ������è�ͷ���null\r\n            return null;\r\n        }\r\n\r\n        String[] split = shipTime.split(\"_\");\r\n\r\n        if (split.length == 2) {\r\n            //����ʱ�����ͣ�1�ǹ̶���2�����\r\n            String type = split[0];\r\n            //�̶�����ʱ��д����yyyy-MM-dd��ʽ����Է���ʱ��д��������\r\n            String time = split[1];\r\n            // ��Է���ʱ��\r\n            if (isRelativeTime(type)) {\r\n                if (StringUtils.isNumeric(time)) {\r\n                    // ֻ��>=3�����ϵķ���ʱ��ű���\r\n                    if (Integer.parseInt(time) >= AdpShipTimeConfig.getInstance().getTmallPreSaleRelativeDay()) {\r\n                        return Pair.of(type, time);\r\n                    } else {\r\n                        Bresson.newMetric(\"shipTime.invalid\", MapHelper.of(\"type\", \"���ʱ��\", \"time\", time)).increase();\r\n                    }\r\n                }\r\n            }\r\n\r\n            // ���Է���ʱ��\r\n            if (isAbsoluteTime(type)) {\r\n                try {\r\n                    SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT);\r\n                    Date parsed = format.parse(time);\r\n\r\n                    int beforeDays = AdpShipTimeConfig.getInstance().getTmallPreSaleAbsoluteBetweenDays();\r\n\r\n                    // ��ǰʱ��+beforeDays������ڷ���ʱ��֮�󣬾Ͳ����﷢��ʱ����\r\n                    if (DateUtils.addDays(new Date(), beforeDays).before(parsed)) {\r\n                        return Pair.of(type, time);\r\n                    } else {\r\n                        Bresson.newMetric(\"shipTime.invalid\", MapHelper.of(\"type\", \"����ʱ��\", \"time\", time)).increase();\r\n                    }\r\n                } catch (ParseException e) {\r\n                    // ignore\r\n                }\r\n            }\r\n\r\n        }\r\n\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ��ȡ�̼�Эͬ�ֵ���Ч����ʱ��\r\n     *\r\n     * @param shipTime ����ʱ��\r\n     * @param carrierDTO skuƷ\r\n     * @return ���õķ���ʱ�䣬leftΪ���ͣ���ABSOLUTE_TAG = \"1\";RELATIVE_TIME_TAG = \"2\"; rightΪ�����ʱ��ֵ������Ϊ2019-11-20�����Ϊ7����\r\n     