{"type":"message","id":"def44da1","parentId":"fd11a126","timestamp":"2026-05-28T11:18:46.755Z","message":{"role":"toolResult","toolCallId":"call_b6e0a2a50e1644b78d437010","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.logistics.ability.order.kaola;\r\n\r\nimport com.alibaba.delivery.common.diamond.order.OrderConfig;\r\nimport com.alibaba.delivery.common.dto.order.KaolaOrderDeliveryParamDTO;\r\nimport com.alibaba.delivery.common.dto.order.PromiseType;\r\nimport com.alibaba.delivery.common.util.JsonUtils;\r\nimport com.alibaba.delivery.logistics.ability.order.kaola.bean.KaolaExpressTimingValue;\r\nimport com.alibaba.delivery.logistics.ability.order.kaola.bean.KaolaOrderTimingTag;\r\nimport com.alibaba.delivery.logistics.ability.order.kaola.bean.KaolaPromiseBean;\r\nimport com.alibaba.delivery.logistics.ability.order.utils.DateTimeUtils;\r\nimport com.alibaba.delivery.logistics.ability.order.utils.KaolaTimeUtils;\r\nimport com.alibaba.delivery.logistics.entity.core.order.kaola.KaolaCalculatorResult;\r\nimport com.alibaba.delivery.logistics.entity.core.order.kaola.KaolaLogisticsServiceDO;\r\nimport com.alibaba.delivery.logistics.entity.core.order.kaola.KaolaOrderCalculatorDeliveryTiming;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeDTO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeFeatureConstant;\r\nimport com.alibaba.delivery.logistics.utils.FlaProcessor;\r\nimport com.google.common.collect.Lists;\r\nimport com.google.common.collect.Maps;\r\nimport com.netease.kaola.dict.order.enums.OrderStatus;\r\nimport org.apache.commons.collections4.MapUtils;\r\nimport org.apache.commons.lang3.StringUtils;\r\nimport org.joda.time.DateTime;\r\n\r\nimport java.util.Arrays;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\n/**\r\n * @author LinYuanSheng\r\n * @date 2020/10/16\r\n */\r\npublic class KaolaOrderCalculator {\r\n\r\n\tpublic KaolaCalculatorResult calTiming(KaolaOrderDeliveryParamDTO kaolaOrderDeliveryParamDTO) {\r\n\r\n\t\tInteger orderStatus = kaolaOrderDeliveryParamDTO.getOrderStatus();\r\n\t\tif (orderStatus == 0 || orderStatus == 5) {\r\n\t\t\treturn null;\r\n\t\t}\r\n\r\n\t\tif (MapUtils.isEmpty(kaolaOrderDeliveryParamDTO.getAttributes())) {\r\n\t\t\treturn null;\r\n\t\t}\r\n\r\n\t\tKaolaCalculatorResult kaolaCalculatorResult = new KaolaCalculatorResult();\r\n\t\tkaolaCalculatorResult.setOrderId(kaolaOrderDeliveryParamDTO.getOrderId());\r\n\t\t// ������������ʱЧ\r\n\t\tprocessShipTime(kaolaOrderDeliveryParamDTO, kaolaCalculatorResult);\r\n\r\n\t\t//������\r\n\t\tMap<String, String> attributes = kaolaOrderDeliveryParamDTO.getAttributes();\r\n\r\n\t\t//��������������ŵʱЧ,��ʹ�����������\r\n\t\tfinal String payIfArrivalLater = attributes.get(\"payIfArrivalLater\");\r\n\r\n\t\tfinal KaolaPromiseBean kaolaPromiseBean = KaolaTimeUtils.parseLogisticServiceTag(payIfArrivalLater);\r\n\t\tif (KaolaTimeUtils.isPromiseTiming(kaolaPromiseBean)) {\r\n\t\t\t//����ֱ�ӷ��س�ŵ����,�����㿼��������ǩ\"asdp_promise\"�ϵ�ֵ. Ŀǰֻ�ǿ�������������뵽����.\r\n\t\t\t//�ǳ�ŵʱЧ,ֱ��д������ά��\r\n\t\t\tKaolaOrderCalculatorDeliveryTiming deliveryTiming = new KaolaOrderCalculatorDeliveryTiming();\r\n\t\t\tDateTime arrivalTime = kaolaPromiseBean.getArrivalTime();\r\n\t\t\tif (arrivalTime != null) {\r\n\t\t\t\t//��ŵʱЧҪ����Ϊ�����23:59:59\r\n\t\t\t\tarrivalTime = arrivalTime.withHourOfDay(23).withMinuteOfHour(59).withSecondOfMinute(59);\r\n\t\t\t\t//��Ա���컯ʱЧ\r\n\t\t\t\tarrivalTime = delayDays(kaolaOrderDeliveryParamDTO,arrivalTime,false);\r\n\t\t\t}\r\n\t\t\tdeliveryTiming.setArriveTime(arrivalTime);\r\n\t\t\tdeliveryTiming.setPromiseType(PromiseType.PROMISE);\r\n\t\t\tdeliveryTiming.setIsMain(1);\r\n\t\t\tdeliveryTiming.setLogisticServices(convertServiceCodes(kaolaPromiseBean.getLogisticServiceCodeList()));\r\n\t\t\tkaolaCalculatorResult.setOrderCalculatorDeliveryTiming(deliveryTiming);\r\n\t\t\tif (deliveryTiming.getArriveTime() != null) {\r\n\t\t\t\treturn kaolaCalculatorResult;\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t\tString timingStr = attributes.get(\"asdp_promise\");\r\n\r\n\t\tKaolaOrderTimingTag kaolaOrderTimingTag = JsonUtils.fromJsonStr(timingStr, KaolaOrderTimingTag.class);\r\n\r\n\t\tif (kaolaOrderTimingTag == null) {\r\n\t\t\treturn kaolaCalculatorResult;\r\n\t\t}\r\n\t\tif (MapUtils.isNotEmpty(kaolaOrderTimingTag.getExpressLogisticsInfo())) {\r\n\t\t\tList<KaolaOrderCalculatorDeliveryTiming> fulfillTimings = Lists\r\n\t\t\t\t\t.newArrayListWithCapacity(kaolaOrderTimingTag.getExpressLogisticsInfo().size());\r\n\t\t\tfor (Map.Entry<String, KaolaExpressTimingValue> fulfillTimingEntry :\r\n\t\t\t\t\tkaolaOrderTimingTag.getExpressLogisticsInfo().entrySet()) {\r\n\t\t\t\t//�˵���\r\n\t\t\t\tString mailNo = fulfillTimingEntry.getKey();\r\n\t\t\t\t//�˵�ʱЧ\r\n\t\t\t\tKaolaExpressTimingValue fulfillTimingEntryValue = fulfillTimingEntry.getValue();\r\n\r\n\t\t\t\tKaolaOrderCalculatorDeliveryTiming fulfillTiming = buildDeliveryTiming(kaolaOrderDeliveryParamDTO,fulfillTimingEntryValue);\r\n\r\n\t\t\t\tif (fulfillTiming == null) {\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\t//�����˵���\r\n\t\t\t\tfulfillTiming.setBillNo(mailNo);\r\n\r\n\t\t\t\tfulfillTimings.add(fulfillTiming);\r\n\t\t\t\tkaolaCalculatorResult.setFulfillCalculatorDeliveryTimings(fulfillTimings);\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (kaolaOrderTimingTag.getTradeLogisticsInfo() != null) {\r\n\t\t\tKaolaExpressTimingValue tradeLogisticsInfo = kaolaOrderTimingTag.getTradeLogisticsInfo();\r\n\r\n\t\t\tKaolaOrderCalculatorDeliveryTiming deliveryTiming = buildDeliveryTiming(kaolaOrderDeliveryParamDTO,tradeLogisticsInfo);\r\n\r\n\t\t\tkaolaCalculatorResult.setOrderCalculatorDeliveryTiming(deliveryTiming);\r\n\t\t}\r\n\r\n\t\treturn kaolaCalculatorResult;\r\n\t}\r\n\r\n\t/**\r\n\t * ������������ʱЧ\r\n\t */\r\n\tprivate void processShipTime(KaolaOrderDeliveryParamDTO kaolaOrderDeliveryParamDTO, KaolaCalculatorResult kaolaCalculatorResult) {\r\n\t\t// ֻ��δ��������֧��״̬���ܱ��﷢��ʱЧ\r\n\t\tif (kaolaOrderDel