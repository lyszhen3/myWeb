cBizConfig;\r\nimport com.google.common.collect.Lists;\r\nimport com.google.common.collect.Maps;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.lang3.StringUtils;\r\nimport org.apache.commons.lang3.tuple.ImmutablePair;\r\nimport org.apache.commons.lang3.tuple.Pair;\r\nimport org.springframework.core.annotation.Order;\r\n\r\nimport java.util.*;\r\nimport java.util.stream.Collectors;\r\n\r\n/**\r\n * @author beitian\r\n * @version 1.0\r\n * @date 2021/12/30 7:45 下午\r\n */\r\n@Order(900)\r\npublic class FcFreightCalculator extends DefaultFreightCalculator implements PackageCombiner, LogisticsGrouping, FreightCalculator {\r\n\r\n    public static final String ITEM_BIZ_TYPE = \"item_biz_type\";\r\n\r\n    public static final String ITEM_BIZ_TYPE_GIFT = \"gift\";\r\n\r\n    @Override\r\n    public String identity() {\r\n        return \"fc_official\";\r\n    }\r\n\r\n    @Override\r\n    public boolean canCombine(List<LogisticsPackage> pickedPackages) {\r\n        if (CollectionUtils.isEmpty(pickedPackages)) {\r\n            return false;\r\n        }\r\n\r\n        for (LogisticsPackage logisticsPackage : pickedPackages) {\r\n            if (logisticsPackage == null) {\r\n                continue;\r\n            }\r\n            Set<Integer> itemTags = logisticsPackage.getFreightItems().stream()\r\n                    .filter(Objects::nonNull)\r\n                    .map(FreightItemInfo::getItemInfo)\r\n                    .filter(Objects::nonNull)\r\n                    .map(AdpItemInfo::getItemTags)\r\n                    .filter(CollectionUtils::isNotEmpty)\r\n                    .findFirst()\r\n                    .orElse(Collections.emptySet());\r\n            if (CollectionUtils.isEmpty(itemTags)) {\r\n                continue;\r\n            }\r\n\r\n            if (CollectionUtils.containsAny(itemTags, AdpNewLogisticBizConfig.fcOfficialItemTag)) {\r\n                return true;\r\n            }\r\n\r\n        }\r\n        return false;\r\n    }\r\n\r\n    @Override\r\n    public List<LogisticsPackage> pickUpPackages(List<LogisticsPackage> sourcePackages) {\r\n        //把所有单据捞出来，在combine拆单\r\n        List<LogisticsPackage> result = Lists.newArrayList();\r\n        result.addAll(sourcePackages);\r\n        return result;\r\n    }\r\n\r\n    @Override\r\n    public List<LogisticsPackage> combine(List<LogisticsPackage> pickedPackages) {\r\n        List<LogisticsPackage> packages = Lists.newArrayList();\r\n        //根据卖家拆分包裹\r\n        Map<AdpUserInfo, List<LogisticsPackage>> seller2Packages = pickedPackages.stream().collect(Collectors.groupingBy(LogisticsPackage::getSeller));\r\n        for (Map.Entry<AdpUserInfo, List<LogisticsPackage>> entry : seller2Packages.entrySet()) {\r\n            LogisticsPackage logisticsPackage = new LogisticsPackage();\r\n            logisticsPackage.setIdentity(identity());\r\n            List<AdpLogicOrder> orders = entry.getValue().stream().flatMap(lp -> lp.getOrders().stream()).collect(Collectors.toList());\r\n            logisticsPackage.setOrders(orders);\r\n            List<FreightItemInfo> items = entry.getValue().stream().flatMap(lp -> lp.getFreightItems().stream()).collect(Collectors.toList());\r\n            logisticsPackage.setFreightItems(items);\r\n            AdpUserInfo seller = orders.stream().filter(Objects::nonNull).findAny().map(AdpLogicOrder::getSeller).orElse(null);\r\n            logisticsPackage.setSeller(seller);\r\n            ReceiverAddress to = entry.getValue().stream().filter(Objects::nonNull).findFirst().map(LogisticsPackage::getTo).orElse(null);\r\n            logisticsPackage.setTo(to);\r\n            packages.add(logisticsPackage);\r\n        }\r\n        return packages;\r\n    }\r\n\r\n    @Override\r\n    public List<FreightGroup> grouping(LogisticsPackage logisticsPackage) {\r\n        if (!identity().equals(logisticsPackage.getIdentity())) {\r\n            return null;\r\n        }\r\n        if (CollectionUtils.isEmpty(logisticsPackage.getFreightItems())) {\r\n            return Collections.emptyList();\r\n        }\r\n\r\n        List<FreightGroup> freightGroups = Lists.newArrayList();\r\n        //过滤出包邮品并计算总价格\r\n        long postFreePriceTotal = logisticsPackage.getFreightItems().stream()\r\n                .filter(Objects::nonNull)\r\n                .map(FreightItemInfo::getItemInfo)\r\n                .filter(FeeUtils::isPostFree)\r\n                .mapToLong(AdpItemInfo::getRealPriceTotal)\r\n                .reduce(Long::sum).orElse(0L);\r\n\r\n        List<AdpItemInfo> postFreeItems = logisticsPackage.getFreightItems().stream()\r\n                .filter(Objects::nonNull)\r\n                .map(FreightItemInfo::getItemInfo)\r\n                //过滤出包邮品和赠品\r\n                .filter(item -> FeeUtils.isPostFree(item) || isGiftItem(item))\r\n                .collect(Collectors.toList());\r\n        if (CollectionUtils.isNotEmpty(postFreeItems)) {\r\n            FreightGroup postFreeGroup = new FreightGroup();\r\n            postFreeGroup.setIdentity(logisticsPackage.getIdentity());\r\n            postFreeGroup.setItemInfos(postFreeItems);\r\n            FreightTemplate postFreeFreightTemplate = logisticsPackage.getFreightItems().stream()\r\n                    .filter(Objects::nonNull)\r\n                    .filter(item -> FeeUtils.isPostFree(item.getItemInfo()) || isGiftItem(item.getItemInfo()))\r\n                    .findFirst()\r\n                    .map(FreightItemInfo::getFreightTemplate)\r\n                    .orElse(null);\r\n            postFreeGroup.setFreightTemplate(postFreeFreightTemplate);\r\n            postFreeGroup.setSeller(logisticsPackage.getSeller());\r\n            freightGroups.add(postFreeGroup);\r\n        }\r\n\r\n        //非包邮品分组构造\r\n        List<AdpItemInfo> itemInfos = logisticsPackage.getFreightItems().stream()\r\n                .map(FreightItemInfo::getItemInfo)\r\n                .filter(adpItemInfo -> !postFreeItems.contains(adpItemInfo))\r\n                .collect(Collectors.toList());\r\n        if (CollectionUtils.isNotEmpty(itemInfos)) {\r\n            FreightGroup freightGroup = new FreightGroup();\r\n            freightGroup.setIdentity(logisticsPackage.getIdentity());\r\n            freightGroup.setItemInfos(itemInfos);\r\n\r\n            Map<String, FreightTemplate> freightTemplateMap = logisticsPackage\r\n                    .getFreightItems()\r\n                    .stream()\r\n                    .filter(Objects::nonNull)\r\n                    .filter(freightItemInfo -> freightItemInfo.getItemInfo() != null)\r\n                    .collect(\r\n                            Collectors.toMap(\r\n                                    item -> item.getItemInfo().getUniqueKey(), FreightItemInfo::getFreightTemplate,\r\n                                    (key1, key2) -> key2\r\n                            )\r\n                    );\r\n            List<FreightTemplate> freightTemplates = itemInfos\r\n                    .stream()\r\n                    .filter(Objects::nonNull)\r\n                    .filter(adpItemInfo -> adpItemInfo.getUniqueKey() != null)\r\n                    .map(adpItemInfo -> freightTemplateMap.get(adpItemInfo.getUniqueKey()))\r\n                    .collect(Collectors.toList());\r\n            String sellerId = Optional.ofNullable(logisticsPackage.getSeller()).map(AdpUserInfo::getUserId).map(String::valueOf).orElse(null);\r\n            freightGroup.setFreightTemplate(decideFreightTemplate(sellerId, freightTemplates));\r\n            freightGroup.setSeller(logisticsPackage.getSeller());\r\n            //该运费分组的总金额加上包邮品的金额\r\n            freightGroup.setRealPrice(freightGroup.getRealPrice() + postFreePriceTotal);\r\n            freightGroups.add(freightGroup);\r\n        }\r\n        return freightGroups;\r\n    }\r\n\r\n    @Override\r\n    public boolean canCalculate(FreightGroup freightGroup) {\r\n\r\n        if (Objects.isNull(freightGroup) || CollectionUtils.isEmpty(freightGroup.getItemInfos())) {\r\n            return false;\r\n        }\r\n\r\n        if (CollectionUtils.isEmpty(AdpNewLogisticBizConfig.fcOfficialItemTag)) {\r\n            return false;\r\n        }\r\n\r\n        Set<Integer> itemTag = freightGroup.getItemInfos().stream()\r\n                .filter(Objects::nonNull)\r\n                .map(AdpItemInfo::getItemTags)\r\n                .filter(CollectionUtils::isNotEmpty)\r\n                .findFirst()\r\n                .orElse(Collections.emptySet());\r\n\r\n        return AdpNewLogisticBizConfig.fcOfficialItemTag.stream().anyMatch(itemTag::contains);\r\n    }\r\n\r\n    @Override\r\n    public GroupLogisticsFee calculate(FreightGroup freightGroup) {\r\n        GroupLogisticsFee groupLogisticsFee = new GroupLogisticsFee();\r\n        groupLogisticsFee.setIdentity(freightGroup.getIdentity());\r\n        groupLogisticsFee.setSeller(freightGroup.getSeller());\r\n\r\n        //调用父类的运费计算方法\r\n        Pair<AdpLogisticsFee, FreightSnapshot> groupFeePair = doCalculate(freightGroup);\r\n        FreightSnapshot groupSnapshot = groupFeePair.getRight();\r\n        Map<String, FreightSnapshot> uniqueKeyToSnapshot = Maps.newHashMap();\r\n        for (AdpItemInfo itemInfo : freightGroup.getItemInfos()) {\r\n            uniqueKeyToSnapshot.put(itemInfo.getUniqueKey(), groupSnapshot);\r\n        }\r\n        AdpLogisticsFee groupFee = groupFeePair.getLeft();\r\n        List<ItemLogisticsFeeDetail> itemLogisticsFeeDetails = FeeApportionUtils.apportionToItemRefine(groupFee, freightGroup.getItemInfos(), uniqueKeyToSnapshot, FreightAppointStrategy.WEIGHT);\r\n        groupLogisticsFee.setGroupFee(groupFee);\r\n        groupLogisticsFee.setItemLogisticsFees(itemLogisticsFeeDetails);\r\n        groupLogisticsFee.setFreightSnapshot(groupSnapshot);\r\n        return groupLogisticsFee;\r\n    }\r\n\r\n    @Override\r\n    public Pair<AdpLogisticsFee, FreightSnapshot> doCalculate(FreightGroup group) {\r\n        FreightTemplate freightTemplate = group.getFreightTemplate();\r\n        if (freightTemplate == null) {\r\n            throw new AdpFeeCalcException(AdpServiceErrorCode.DELIVEY_TEMPLATE_NOT_EXIST.getCode(), AdpServiceErrorCode.DELIVEY_TEMPLATE_NOT_EXIST.getMessage());\r\n        }\r\n        // 获取运费计价规则\r\n        PricingRule rule = freightTemplate.getRule(group);\r\n        // 计价规则为空时异常抛出阻断\r\n        if (rule == null) {\r\n            throw new AdpFeeCalcException(AdpServiceErrorCode.DELIVEY_TEMPLATE_IS_ILLEGAL.getCode(), AdpServiceErrorCode.DELIVEY_TEMPLATE_IS_ILLEGAL.getMessage());\r\n        }\r\n        // 运费计价\r\n        int currentFee = rule.pricing(group);\r\n        AdpLogisticsFee groupFee = new AdpLogisticsFee();\r\n        groupFee.setRealFee((long) currentFee);\r\n        // 构建运费快照信息\r\n        FreightSnapshot groupSnapshot = buildSnapshot(group);\r\n        groupSnapshot.setPostFee((long) currentFee);\r\n        groupSnapshot.setPricingType(rule.getPricingType());\r\n        groupFee.setFreeRequire(buildPostFreeInfo(freightTemplate, group, currentFee));\r\n        groupFee.setPostFree(freightTemplate.isPostFree());\r\n        return ImmutablePair.of(groupFee,groupSnapshot);\r\n    }\r\n\r\n    /**\r\n     * 依赖当前分组信息构建运费快照\r\n     * @param freightGroup 当前分组\r\n     * @return 运费快照\r\n     */\r\n    private FreightSnapshot buildSnapshot(FreightGroup freightGroup) {\r\n        List<AdpItemInfo> itemInfos = freightGroup.getItemInfos();\r\n        AdpItemInfo targetItemInfo = null;\r\n        if (CollectionUtils.isNotEmpty(itemInfos)) {\r\n            targetItemInfo = itemInfos.get(0);\r\n        }\r\n\r\n        FreightSnapshot freightSnapshot = new FreightSnapshot();\r\n        freightSnapshot.setCalculator(\"normal\");\r\n        freightSnapshot.setCount(freightGroup.getCount());\r\n        freightSnapshot.setPrice(freightGroup.getRealPrice());\r\n        freightSnapshot.setSize(freightGroup.getVolume());\r\n        freightSnapshot.setWeight(freightGroup.getWeight());\r\n        FreightTemplate freightTemplate = freightGroup.getFreightTemplate();\r\n        if (targetItemInfo != null) {\r\n            freightSnapshot.setTemplateId(targetItemInfo.getTemplateId());\r\n        } else {\r\n            freightSnapshot.setTemplateId(freightTemplate.getTemplateId());\r\n        }\r\n        freightSnapshot.setTemplateVersion(freightTemplate.getVersion());\r\n        freightSnapshot.setToAreaCode(freightTemplate.getToAreaId());\r\n        freightSnapshot.setPostFree(freightTemplate.isPostFree());\r\n        if (StringUtils.isNotEmpty(freightTemplate.getTemplateType())) {\r\n            //包邮模板，postfree 给true\r\n            if (freightTemplate.getTemplateType().equals(TemplateType.FREE_TEMPLATE)) {\r\n                freightSnapshot.setPostFree(true);\r\n            }\r\n        }\r\n        return freightSnapshot;\r\n    }\r\n\r\n    /**\r\n     * 构建包邮信息\r\n     */\r\n    private PostFreeInfo buildPostFreeInfo(FreightTemplate freightTemplate, FreightGroup group, int currentFee) {\r\n        // 如果当前运费已经是0，不需要再构建包邮信息\r\n        if (currentFee <= 0) {\r\n            return null;\r\n        }\r\n        PricingRule postFreeRule = getPostFreeRule(freightTemplate, group);\r\n        if (postFreeRule == null) {\r\n            return null;\r\n        }\r\n        PostFreeInfo postFreeInfo = new PostFreeInfo();\r\n        long priceGap = postFreeRule.getPriceRange().lowerEndpoint() - group.getRealPrice();\r\n        postFreeInfo.setPriceGap(priceGap);\r\n        postFreeInfo.setDecreaseFreight((long) currentFee);\r\n        postFreeInfo.setMinPriceLimited(postFreeRule.getPriceRange().lowerEndpoint());\r\n        return postFreeInfo;\r\n    }\r\n\r\n    /**\r\n     * 忽略计价门槛获取包邮的计价规则\r\n     * @return 包邮的计价规则\r\n     */\r\n    private PricingRule getPostFreeRule(FreightTemplate freightTemplate, FreightGroup group) {\r\n        for (PricingRule pricingRule : freightTemplate.getPricingRules()) {\r\n            int pricing = pricingRule.pricing(group);\r\n            if (pricing == 0) {\r\n                return pricingRule;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    @Override\r\n    public List<OrderLogisticsFeeDetail> collect(LogisticsPackage logisticsPackage, List<GroupLogisticsFee> groupFees) {\r\n        List<OrderLogisticsFeeDetail> orderFees = Lists.newArrayList();\r\n        List<FreightSnapshot> sourceSnapshots = Lists.newArrayList();\r\n\r\n        // 商品的运费明细\r\n        Map<String, List<ItemLogisticsFeeDetail>> itemLogisticsFeeDetailMap = Maps.newHashMap();\r\n        for (GroupLogisticsFee groupFee : groupFees) {\r\n            FreightSnapshot freightSnapshot = groupFee.getFreightSnapshot();\r\n            sourceSnapshots.add(freightSnapshot);\r\n            for (ItemLogisticsFeeDetail itemLogisticsFee : groupFee.getItemLogisticsFees()) {\r\n                String key = buildUniqueKey(itemLogisticsFee);\r\n                itemLogisticsFeeDetailMap.putIfAbsent(key, Lists.newArrayList());\r\n                itemLogisticsFeeDetailMap.get(itemLogisticsFee.getUniqueKey()).add(itemLogisticsFee);\r\n            }\r\n        }\r\n        for (AdpLogicOrder order : logisticsPackage.getOrders()) {\r\n            long orderPostFee = 0L;\r\n            List<ItemLogisticsFeeDetail> itemFees = Lists.newArrayList();\r\n            for (AdpItemInfo item : order.getItems()) {\r\n                String uniqueKey = buildUniqueKey(item);\r\n                List<ItemLogisticsFeeDetail> itemLogisticsFeeDetails = itemLogisticsFeeDetailMap.get(uniqueKey);\r\n                if (CollectionUtils.isEmpty(itemLogisticsFeeDetails)) {\r\n                    continue;\r\n                }\r\n                itemFees.addAll(itemLogisticsFeeDetails);\r\n                orderPostFee += itemLogisticsFeeDetails.stream()\r\n                        .mapToLong(ItemLogisticsFeeDetail::getPostFee)\r\n                        .reduce(Long::sum)\r\n                        .orElse(0L);\r\n                itemLogisticsFeeDetailMap.remove(uniqueKey);\r\n            }\r\n            OrderLogisticsFeeDetail orderLogisticsFeeDetail = new OrderLogisticsFeeDetail();\r\n            orderLogisticsFeeDetail.setOrderId(order.getOrderId());\r\n            orderLogisticsFeeDetail.setItemLogisticsFeeDetails(itemFees);\r\n\r\n            // 订单维度快照\r\n            OrderFreightSnapshot orderFreightSnapshot = new OrderFreightSnapshot();\r\n            orderFreightSnapshot.setSourceSnapshots(sourceSnapshots);\r\n            orderFreightSnapshot.setAggregateFreight(orderPostFee);\r\n            orderFreightSnapshot.setApportionedFreight(orderPostFee);\r\n            orderFreightSnapshot.setCollectType(\"GROUPSUM\");\r\n            orderLogisticsFeeDetail.setOrderFreightSnapshot(orderFreightSnapshot);\r\n\r\n            // 订单维度运费\r\n            AdpLogisticsFee orderFee = new AdpLogisticsFee();\r\n            orderFee.setRealFee(orderPostFee);\r\n            orderLogisticsFeeDetail.setLogisticsFee(orderFee);\r\n\r\n            orderFees.add(orderLogisticsFeeDetail);\r\n        }\r\n        return orderFees;\r\n\r\n    }\r\n\r\n    /**\r\n     * 商品的唯一键在同一批订单里，在同一个订单里不唯一\r\n     * 需要重新按照以下方式构造唯一键\r\n     * 唯一键设置变为orderId + \"#\" + uniqueKey\r\n     * @param itemLogisticsFeeDetail 运费详情\r\n     * @return 唯一键\r\n     */\r\n    private String buildUniqueKey(ItemLogisticsFeeDetail itemLogisticsFeeDetail) {\r\n        return itemLogisticsFeeDetail.getOrderId() + \"#\" + itemLogisticsFeeDetail.getUniqueKey();\r\n    }\r\n\r\n    private String buildUniqueKey(AdpItemInfo adpItemInfo) {\r\n        return adpItemInfo.getOrderId() + \"#\" + adpItemInfo.getUniqueKey();\r\n    }\r\n\r\n    private boolean isGiftItem(AdpItemInfo adpItemInfo) {\r\n        String giftTag = Optional.ofNullable(adpItemInfo)\r\n                .map(AdpItemInfo::getFeature)\r\n                .map(v -> v.get(ITEM_BIZ_TYPE))\r\n                .orElse(null);\r\n        return Objects.equals(ITEM_BIZ_TYPE_GIFT, giftTag);\r\n    }\r\n\r\n    private FreightTemplate decideFreightTemplate(String sellerId, List<FreightTemplate> freightTemplates) {\r\n        Map<String, List<String>> fcFreightTemplatePriorityMap = AdpNewLogisticBizConfig.getFcFreightTemplatePriorityMap();\r\n        List<String> priorityTemplateIds = fcFreightTemplatePriorityMap.get(sellerId);\r\n        if (CollectionUtils.isEmpty(priorityTemplateIds)) {\r\n            return freightTemplates.stream().findFirst().orElse(null);\r\n        }\r\n        for (String priorityTemplateId : priorityTemplateIds) {\r\n            for (FreightTemplate freightTemplate : freightTemplates) {\r\n                if (Objects.equals(priorityTemplateId, String.valueOf(freightTemplate.getTemplateId()))) {\r\n                    return freightTemplate;\r\n                }\r\n            }\r\n        }\r\n        return freightTemplates.stream().findFirst().orElse(null);\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779968047904}}
