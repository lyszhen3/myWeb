Time.invalid\", MapHelper.of(\"type\", \"ownStore����ʱ��\", \"time\", time))\r\n                                .increase();\r\n                    }\r\n                }\r\n                if (ShipTimeUtils.isRelativeTime(type)) {\r\n                    if (NumberUtils.isCreatable(time)) {\r\n                        if (Integer.parseInt(time) >= AdpShipTimeConfig.getInstance().getOwnStoreRelativeLeastDays()) {\r\n                            //diamond ���ã����ʱ����ڸ�ֵ�����\r\n                            return true;\r\n                        } else {\r\n                            ShipTimeUtils.setUnExpressShipTimeReason(carrierDTO, \"ownStore,���ʱ��=\" + time + \"С��\"\r\n                                    + AdpShipTimeConfig.getInstance().getOwnStoreRelativeLeastDays() + \"��\");\r\n                            //���\r\n                            Bresson.newMetric(\"shipTime.invalid\", MapHelper.of(\"type\", \"ownStore���ʱ��\", \"time\", time))\r\n                                    .increase();\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n\r\n    /**\r\n     * ��è���θ���У��\r\n     * @return\r\n     */\r\n    public static boolean validTmallClothesShipTime(String shipTime,DeliveryCarrierDTO carrierDTO ) {\r\n        if (StringUtils.isNotBlank(shipTime)) {\r\n            String[] s = StringUtils.split(shipTime, \"_\");\r\n            if (s != null && s.length == 2) {\r\n                //����ʱ�����ͣ�1�ǹ̶���2�����\r\n                String type = s[0];\r\n                //�̶�����ʱ��д����yyyy-MM-dd��ʽ����Է���ʱ��д��������\r\n                String time = s[1];\r\n                if (ShipTimeUtils.isAbsoluteTime(type)) {\r\n\r\n                    Date shipTimeDate;\r\n                    try {\r\n                        SimpleDateFormat format = DateFormatCacheUtils.getSimpleDateFormat(DateTimeUtils.FORMAT_YEAR_MONTH_DAY_NO_ZONE);\r\n                        shipTimeDat