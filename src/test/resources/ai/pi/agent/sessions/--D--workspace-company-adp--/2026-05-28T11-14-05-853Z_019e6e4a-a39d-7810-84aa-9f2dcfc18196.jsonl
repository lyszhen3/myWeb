{"type":"message","id":"9f662da1","parentId":"cbff6e20","timestamp":"2026-05-28T11:34:25.108Z","message":{"role":"toolResult","toolCallId":"call_391a65cab4d9420394281dd7","toolName":"read","content":[{"type":"text","text":"package com.alibaba.adp.fee.core.calculator;\r\n\r\nimport com.alibaba.adp.fee.api.model.AdpFeeCalcException;\r\nimport com.alibaba.adp.fee.api.model.fee.AdpLogisticsFee;\r\nimport com.alibaba.adp.fee.api.model.fee.PostFreeInfo;\r\nimport com.alibaba.adp.fee.api.model.request.AdpItemInfo;\r\nimport com.alibaba.adp.fee.api.model.request.AdpLogicOrder;\r\nimport com.alibaba.adp.fee.api.model.response.FreightSnapshot;\r\nimport com.alibaba.adp.fee.api.model.response.ItemLogisticsFeeDetail;\r\nimport com.alibaba.adp.fee.api.model.response.OrderFreightSnapshot;\r\nimport com.alibaba.adp.fee.api.model.response.OrderLogisticsFeeDetail;\r\nimport com.alibaba.adp.fee.core.spi.model.FreightAppointStrategy;\r\nimport com.alibaba.fastjson.JSON;\r\nimport com.google.common.collect.Lists;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\n\r\nimport java.util.Iterator;\r\nimport java.util.List;\r\nimport java.util.Map;\r\nimport java.util.Objects;\r\n\r\n/**\r\n * 运费分摊工具\r\n * @author jiajun.njj 2021/6/18 4:21 下午\r\n */\r\npublic class FeeApportionUtils {\r\n\r\n    /**\r\n     * 运费分摊到订单\r\n     * 按照各个订单所占总体比例来分摊\r\n     * @param sourceSnapshot 整组的运费\r\n     * @param adpLogicOrders 订单列表\r\n     * @param freightAppointStrategy 运费分配策略\r\n     * @return 各个订单分摊的费用\r\n     */\r\n    public static List<OrderLogisticsFeeDetail> apportionToOrder(Long sumPostFee, OrderFreightSnapshot sourceSnapshot, List<AdpLogicOrder> adpLogicOrders, Map<String, FreightSnapshot> uniqueKeyToSnapshot, FreightAppointStrategy freightAppointStrategy) {\r\n        List<OrderLogisticsFeeDetail> orderLogisticsFeeDetails = Lists.newArrayList();\r\n        long totalItemPrice = adpLogicOrders.stream().map(FeeApportionUtils::getOrderRealPrice).reduce(Long::sum).orElse(0L);\r\n        // 商品分摊的运费总金额\r\n        long itemPostFeeSum = 0L;\r\n        Iterator<AdpLogicOrder> iterator = adpLogicOrders.iterator();\r\n        while (iterator.hasNext()) {\r\n            AdpLogicOrder adpLogicOrder = iterator.next();\r\n            OrderLogisticsFeeDetail orderLogisticsFeeDetail = new OrderLogisticsFeeDetail();\r\n            orderLogisticsFeeDetail.setOrderId(adpLogicOrder.getOrderId());\r\n            Long orderRealPrice = getOrderRealPrice(adpLogicOrder);\r\n            long orderPostFee;\r\n            if (iterator.hasNext() && totalItemPrice != 0L) {\r\n                orderPostFee = sumPostFee * orderRealPrice / totalItemPrice;\r\n            } else {\r\n                // 避免丢失最后一分钱，加到最后一个订单上\r\n                orderPostFee = sumPostFee - itemPostFeeSum;\r\n            }\r\n            itemPostFeeSum += orderPostFee;\r\n            AdpLogisticsFee orderFee = new AdpLogisticsFee();\r\n            orderFee.setRealFee(orderPostFee);\r\n            orderLogisticsFeeDetail.setLogisticsFee(orderFee);\r\n\r\n            OrderFreightSnapshot orderFreightSnapshot = new OrderFreightSnapshot();\r\n            orderFreightSnapshot.setAggregateFreight(sumPostFee);\r\n            orderFreightSnapshot.setApportionedFreight(orderPostFee);\r\n            orderFreightSnapshot.setSourceSnapshots(sourceSnapshot.getSourceSnapshots());\r\n            orderFreightSnapshot.setCollectType(sourceSnapshot.getCollectType());\r\n            orderLogisticsFeeDetail.setOrderFreightSnapshot(orderFreightSnapshot);\r\n\r\n            List<ItemLogisticsFeeDetail> itemLogisticsFees = apportionToItem(orderFee, adpLogicOrder.getItems(), uniqueKeyToSnapshot, freightAppointStrategy);\r\n            orderLogisticsFeeDetail.setItemLogisticsFeeDetails(itemLogisticsFees);\r\n            orderLogisticsFeeDetails.add(orderLogisticsFeeDetail);\r\n        }\r\n        return orderLogisticsFeeDetails;\r\n    }\r\n\r\n    /**\r\n     * 运费分摊到商品\r\n     * 按照各个商品的价格所占总体比例来分摊\r\n     * @param orderFee 订单的运费\r\n     * @param itemInfos 需要分摊的商品列表\r\n     * @return 各个商品分摊的费用\r\n     */\r\n    public static List<ItemLogisticsFeeDetail> apportionToItem(AdpLogisticsFee orderFee, List<AdpItemInfo> itemInfos, Map<String, FreightSnapshot> uniqueKeyToSnapshot, FreightAppointStrategy freightAppointStrategy) {\r\n        List<ItemLogisticsFeeDetail> itemLogisticsFees = Lists.newArrayList();\r\n        Long denominator = getDenominatorFromAllItem(itemInfos, freightAppointStrategy);\r\n        // 商品分摊的运费总金额\r\n        // 避免丢失最后一分钱，加到第一个商品上\r\n        long itemPostFeeSum = 0L;\r\n        Iterator<AdpItemInfo> iterator = itemInfos.iterator();\r\n        while (iterator.hasNext()) {\r\n            AdpItemInfo itemInfo = iterator.next();\r\n            ItemLogisticsFeeDetail itemLogisticsFee = new ItemLogisticsFeeDetail();\r\n            itemLogisticsFee.setUniqueKey(itemInfo.getUniqueKey());\r\n            itemLogisticsFee.setOrderId(itemInfo.getOrderId());\r\n            long itemPostFee;\r\n            if (iterator.hasNext() && denominator != 0L) {\r\n                itemPostFee = orderFee.getRealFee() * getNumeratorFromItem(itemInfo, freightAppointStrategy) / denominator;\r\n            } else {\r\n                // 避免丢失最后一分钱，加到最后一个商品上\r\n                itemPostFee = orderFee.getRealFee() - itemPostFeeSum;\r\n            }\r\n            itemLogisticsFee.setPostFee(itemPostFee);\r\n            // 分组维度的包邮信息也要分摊到商品上\r\n            itemLogisticsFee.setFreeRequire(buildItemFreeInfo(orderFee.getFreeRequire(), itemPostFee));\r\n\r\n            FreightSnapshot groupSnapshot = uniqueKeyToSnapshot.get(itemInfo.getUniqueKey());\r\n            if (null != groupSnapshot) {\r\n                FreightSnapshot freightSnapshot = buildItemSnapshot(groupSnapshot, itemInfo, itemPostFee);\r\n                itemLogisticsFee.setFreightSnapshot(freightSnapshot);\r\n            }\r\n            itemPostFeeSum += itemPostFee;\r\n            itemLogisticsFees.add(itemLogisticsFee);\r\n        }\r\n        return itemLogisticsFees;\r\n    }\r\n\r\n    /**\r\n     * 运费分摊到商品,优化后的方法,假如分摊标的物为0,那么就进行随机分配\r\n     * 按照各个商品的价格所占总体比例来分摊\r\n     * @param orderFee 订单的运费\r\n     * @param itemInfos 需要分摊的商品列表\r\n     * @return 各个商品分摊的费用\r\n     */\r\n    public static List<ItemLogisticsFeeDetail> apportionToItemRefine(AdpLogisticsFee orderFee, List<AdpItemInfo> itemInfos, Map<String, FreightSnapshot> uniqueKeyToSnapshot, FreightAppointStrategy freightAppointStrategy) {\r\n        List<ItemLogisticsFeeDetail> itemLogisticsFees = Lists.newArrayList();\r\n        Long denominator = getDenominatorFromAllItem(itemInfos, freightAppointStrategy);\r\n        // 商品分摊的运费总金额\r\n        // 避免丢失最后一分钱，加到第一个商品上\r\n        long itemPostFeeSum = 0L;\r\n        Long realFee = orderFee.getRealFee();\r\n        Iterator<AdpItemInfo> iterator = itemInfos.iterator();\r\n        while (iterator.hasNext()) {\r\n            AdpItemInfo itemInfo = iterator.next();\r\n            ItemLogisticsFeeDetail itemLogisticsFee = new ItemLogisticsFeeDetail();\r\n            itemLogisticsFee.setUniqueKey(itemInfo.getUniqueKey());\r\n            itemLogisticsFee.setOrderId(itemInfo.getOrderId());\r\n            long itemPostFee = 0;\r\n            if (iterator.hasNext() && denominator != 0L) {\r\n                itemPostFee = realFee * getNumeratorFromItem(itemInfo, freightAppointStrategy) / denominator;\r\n            } else {\r\n                // 处理运费分摊标的物为0的情况\r\n                if (denominator == 0) {\r\n                    if (realFee > 0) {\r\n                        itemPostFee = realFee - itemPostFeeSum;\r\n                        realFee -= itemPostFeeSum;\r\n                    }\r\n                } else {\r\n                    // 避免丢失最后一分钱，加到最后一个商品上\r\n                    itemPostFee = orderFee.getRealFee() - itemPostFeeSum;\r\n                }\r\n            }\r\n            itemLogisticsFee.setPostFee(itemPostFee);\r\n            // 分组维度的包邮信息也要分摊到商品上\r\n            itemLogisticsFee.setFreeRequire(buildItemFreeInfo(orderFee.getFreeRequire(), itemPostFee));\r\n\r\n            FreightSnapshot groupSnapshot = uniqueKeyToSnapshot.get(itemInfo.getUniqueKey());\r\n            if (null != groupSnapshot) {\r\n                FreightSnapshot freightSnapshot = buildItemSnapshot(groupSnapshot, itemInfo, itemPostFee);\r\n                itemLogisticsFee.setFreightSnapshot(freightSnapshot);\r\n            }\r\n            itemPostFeeSum += itemPostFee;\r\n            itemLogisticsFees.add(itemLogisticsFee);\r\n        }\r\n        return itemLogisticsFees;\r\n    }\r\n\r\n    private static PostFreeInfo buildItemFreeInfo(PostFreeInfo orderFreeRequire, Long itemPostFee) {\r\n        if (null == orderFreeRequire) {\r\n            return null;\r\n        }\r\n        PostFreeInfo itemFreeInfo = new PostFreeInfo();\r\n        itemFreeInfo.setDecreaseFreight(itemPostFee);\r\n        itemFreeInfo.setPriceGap(orderFreeRequire.getPriceGap());\r\n        itemFreeInfo.setMinPriceLimited(orderFreeRequire.getMinPriceLimited());\r\n        itemFreeInfo.setMaxWeightLimited(orderFreeRequire.getMaxWeightLimited());\r\n        return itemFreeInfo;\r\n    }\r\n\r\n    private static FreightSnapshot buildItemSnapshot(FreightSnapshot groupSnapshot, AdpItemInfo itemInfo, Long postFee) {\r\n        FreightSnapshot freightSnapshot = new FreightSnapshot();\r\n        freightSnapshot.setCalculator(groupSnapshot.getCalculator());\r\n        freightSnapshot.setTemplateId(groupSnapshot.getTemplateId());\r\n        freightSnapshot.setTemplateVersion(groupSnapshot.getTemplateVersion());\r\n        freightSnapshot.setToAreaCode(groupSnapshot.getToAreaCode());\r\n        freightSnapshot.setPricingType(groupSnapshot.getPricingType());\r\n        freightSnapshot.setPostFreeReason(groupSnapshot.getPostFreeReason());\r\n        freightSnapshot.setCount(itemInfo.getCount());\r\n        freightSnapshot.setPrice(itemInfo.getCalculatePriceTotal());\r\n        if (null != itemInfo.getItemSize()) {\r\n            freightSnapshot.setSize(itemInfo.getItemSize() * itemInfo.getCount());\r\n        }\r\n        if (null != itemInfo.getItemWeight()) {\r\n            freightSnapshot.setWeight(itemInfo.getItemWeight() * itemInfo.getCount());\r\n        }\r\n        freightSnapshot.setPostFee(postFee);\r\n        return freightSnapshot;\r\n    }\r\n\r\n    /**\r\n     * 获取一笔订单的商品总价\r\n     */\r\n    public static Long getOrderRealPrice(AdpLogicOrder order) {\r\n        List<AdpItemInfo> itemInfos = order.getItems();\r\n        return getAllItemRealPrice(itemInfos);\r\n    }\r\n\r\n    private static Long getDenominatorFromAllItem(List<AdpItemInfo> itemInfos, FreightAppointStrategy freightAppointStrategy) {\r\n        switch (freightAppointStrategy) {\r\n            case PRICE:\r\n                return getAllItemRealPrice(itemInfos);\r\n            case WEIGHT:\r\n                return getAllItemWeight(itemInfos);\r\n            default:\r\n                throw new RuntimeException(\"unsupported freightAppointStrategy, the strategy = \" + JSON.toJSONString(freightAppointStrategy));\r\n        }\r\n    }\r\n\r\n    private static Long getNumeratorFromItem(AdpItemInfo itemInfo, FreightAppointStrategy freightAppointStrategy) {\r\n        switch (freightAppointStrategy) {\r\n            case PRICE:\r\n                return itemInfo.getCalculatePriceTotal();\r\n            case WEIGHT:\r\n                return itemInfo.getCalculateWeightTotal();\r\n            default:\r\n                throw new RuntimeException(\"unsupported freightAppointStrategy, the strategy = \" + JSON.toJSONString(freightAppointStrategy));\r\n        }\r\n    }\r\n\r\n    public static Long getAllItemWeight(List<AdpItemInfo> itemInfos) {\r\n        if (CollectionUtils.isEmpty(itemInfos)) {\r\n            return 0L;\r\n        }\r\n        return itemInfos.stream().map(itemInfo -> {\r\n            Long realWeightTotal = itemInfo.getCalculateWeightTotal();\r\n            if (Objects.nonNull(realWeightTotal)) {\r\n                return realWeightTotal;\r\n            }\r\n            return 0L;\r\n        }).reduce(Long::sum).orElse(0L);\r\n    }\r\n\r\n    public static Long getAllItemRealPrice(List<AdpItemInfo> itemInfos) {\r\n        if (CollectionUtils.isEmpty(itemInfos)) {\r\n            return 0L;\r\n        }\r\n        return itemInfos.stream().map(itemInfo -> {\r\n            Long realPriceTotal = itemInfo.getCalculatePriceTotal();\r\n            if (null != realPriceTotal) {\r\n                return realPriceTotal;\r\n            }\r\n            Long tagPricePerItem = itemInfo.getTagPricePerItem();\r\n            if (tagPricePerItem == null) {\r\n                return 0L;\r\n            }\r\n            return tagPricePerItem * itemInfo.getCount();\r\n        }).reduce(Long::sum).orElse(0L);\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779968065108}}
