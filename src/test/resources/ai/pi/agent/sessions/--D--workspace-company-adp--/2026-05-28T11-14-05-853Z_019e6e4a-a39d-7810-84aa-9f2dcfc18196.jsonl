ipTimeProcessors = shipTimeProcessors;\r\n    }\r\n\r\n    public AdpResult<Boolean> parallelInvokeShipTimeCalV1(DeliveryPackageGroupDO groupDO, AdpOption adpOption) throws ParallelRecursiveException {\r\n        String sceneName = Optional.of(adpOption).map(AdpOption::getInterfaceSource).map(AdpInterfaceSource::getSource).orElse(AdpInterfaceSource.UNKNOWN.getSource());\r\n        RpcContext_inner ctx = EagleEye.getRpcContext();\r\n        BiFunction<DeliveryPackageGroupDO, AdpOption, AdpResult<Boolean>> biFunction = (deliveryPackageGroupDO, option) -> {\r\n            try {\r\n                EagleEye.setRpcContext(ctx);\r\n                for (IShipTimeProcessor shipTimeProcessor : shipTimeProcessors) {\r\n                    if (shipTimeProcessor.needProcess(option)) {\r\n                        AdpResult<Boolean> adpResult = shipTimeProcessor.process(deliveryPackageGroupDO, option);\r\n                        //Bresson.newMetric(\"shipTime.ability.fill\",\r\n                        //        MapHelper.of(\"processor\", shipTimeProcessor.description(),\r\n                        //                \"result\", String.valueOf(adpResult.isSuccess()),\r\n                        //                \"source\", option.getInterfaceSource().getSource())).increase();\r\n                        if (!adpResult.isSuccess()) {\r\n                            return adpResult;\r\n                        }\r\n                    }\r\n                }\r\n            } finally {\r\n                EagleEye.clearRpcContext();\r\n                RemoteCache.instance().clear();\r\n            }\r\n            return AdpResult.success();\r\n        };\r\n\r\n        Integer batchSize = ParallelInvokeUtils.getParallelInvokeBatchSize(SHIP_TIME_CALCULATE, sceneName, SHIP_TIME_CALCULATE_PARALLEL_DEFAULT_BATCH_SIZE);\r\n\r\n        AdpCommonBiFunctionParallelRecursiveTask adpCommonBiFunctionParallelRecursiveTask = new AdpCommonBiFunctionParallelRecursiveTask(\r\n                biFunction,\r\n                groupDO,\r\n                adpOption,\r\n                groupDO.getDeliveryPackageDOList().size(),\r\n                batchSize);\r\n\r\n        AdpResult<Boolean> invokeResult = ParallelRecursiveExecutorFactory.getInstance().getParallelRecursiveExecutor().invoke(adpCommonBiFunctionParallelRecursiveTask);\r\n        if (!invokeResult.isSuccess()) {\r\n            return invokeResult;\r\n        }\r\n\r\n        return AdpResult.success();\r\n    }\r\n\r\n}\r\n"}],"isError":false,"timestamp":1779968329449}}
