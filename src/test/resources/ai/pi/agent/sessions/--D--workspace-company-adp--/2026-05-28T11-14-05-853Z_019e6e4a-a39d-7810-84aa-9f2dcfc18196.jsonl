source;\r\nimport java.util.HashMap;\r\n\r\n\r\n\r\n/**\r\n * @author LinYuanSheng\r\n * @date 2021/2/9\r\n * ��è���θ�������ʱЧ\r\n */\r\npublic class TmallClothesSellerSettingShipTimingForwardCalculator implements IShipTimingForwardCalculator {\r\n\r\n\t@Resource\r\n\tprivate ShipTimeWrapperService shipTimeWrapperService;\r\n\r\n\t@Resource\r\n\tprotected ShipTimeSaleRuleService taobaoShipTimeSaleRuleService;\r\n\r\n\t@Resource\r\n\tprotected SpringFestivalShipTimeRuleService springFestivalShipTimeRuleService;\r\n\r\n\r\n\tprotected ChangeSkuControlService changeSkuControlService;\r\n\r\n\r\n\r\n\t@Override\r\n\tpublic ShipTypeEnum getShipType() {\r\n\t\treturn ShipTypeEnum.TMALL_CLOTHES_SELLER_SETTING;\r\n\t}\r\n\r\n\t@Override\r\n\tpublic boolean needCal(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, ClientChannelDTO clientChannelDTO, AdpOption adpOption) {\r\n\t\t//ֻҪ�������Ʒ��ͽ��м���\r\n\r\n\t\treturn deliveryCarrierDO.getDeliveryCarrierDTO().getItemTags().contains(ItemTags.TMALL_CLOTHES.getTag());\r\n\r\n\t}\r\n\r\n\t@Override\r\n\tpublic ShipTimeDO doCal(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, ClientChannelDTO clientChannelDTO, AdpOption adpOption) {\r\n\t\t// 1 ����ִ��ԭʼ�ļ�������\r\n\t\tShipTimeDO shipTimeDO = this.doCalProcess(deliveryPackageDO, deliveryCarrierDO, adpOption);\r\n\r\n\t\t//����ʱЧ����\r\n\t\tPresentShipTimeControlService.doProcess(shipTimeDO, deliveryCarrierDO, clientChannelDTO);\r\n\r\n\t\t//��skuʱЧ����\r\n\t\tchangeSkuControlService.doProcess(shipTimeDO, deliveryCarrierDO, clientChannelDTO, adpOption);\r\n\r\n\t\t//��ٷ���ʱЧ����\r\n\t\ttaobaoShipTimeSaleRuleService.doProcess(shipTimeDO, deliveryCarrierDO);\r\n\r\n\t\t//���䴺�ڲ�����ʱЧ����\r\n\t\tspringFestivalShipTimeRuleService.process(deliveryPackageDO, deliveryCarrierDO, shipTimeDO);\r\n\r\n\t\t// 2 ����ŵ�����ֵ��\r\n\t\tshipTimeWrapperService.wrapShipTimeDOSafety(shipTimeDO, ShipTimeRuleEnum.T_MALL_CLOTHES_SELLER_SETTING_SHIP_TIMING, null,\r\n\t\t\tSellTypeEnum.PRE_SELL, new HashMap<>(0));\r\n\r\n\t\treturn shipTimeDO;\r\n\t}\r\n\r\n\tprivate ShipTimeDO doCalProcess(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, AdpOption adpOption) {\r\n\t\t//����вּƻ������Ȳּƻ�����������Ʒ���ֻ�����ʱ�䣬ѭ����Ʒȡ����ʱ��\r\n\t\tString shipTimeOfInv = ShipTimeUtils.getShipTimeOfInv(deliveryCarrierDO.getDeliveryCarrierDTO());\r\n\r\n\t\tif (!validShipTimeOfInv(shipTimeOfInv, deliveryCarrierDO.getDeliveryCarrierDTO())) {\r\n\t\t\t//���ʱ�䲻����Ч�ģ��������һ��������\r\n\t\t\treturn null;\r\n\t\t}\r\n\r\n\t\treturn ShipTimeDO.builder()\r\n\t\t\t.shipTime(shipTimeOfInv)\r\n\t\t\t.decisionReason(getShipType().getDesc())\r\n\t\t\t.shipType(getShipType())\r\n\t\t\t.build();\r\n\t}\r\n\r\n\tprivate boolean validShipTimeOfInv(String shipTimeOfInv, DeliveryCarrierDTO deliveryCarrierDTO) {\r\n\t\t//�ж�ʱ���Ƿ���Ч\r\n\t\treturn ShipTimeUtils.validTmallClothesShipTime(shipTimeOfInv, deliveryCarrierDTO);\r\n\t}\r\n\r\n\tpublic void setShipTimeWrapperService(ShipTimeWrapperService shipTimeWrapperService) {\r\n\t\tthis.shipTimeWrapperService = shipTimeWrapperService;\r\n\t}\r\n\r\n\tpublic void setChangeSkuControlService(ChangeSkuControlService changeSkuControlService) {\r\n        this.changeSkuControlService = changeSkuControlService;\r\n    }\r\n\r\n\t@Autowired\r\n\tpublic void setTaobaoShipTimeSaleRuleService(ShipTimeSaleRuleService taobaoShipTimeSaleRuleService) {\r\n\t\tthis.taobaoShipTimeSaleRuleService = taobaoShipTimeSaleRuleService;\r\n\t}\r\n\r\n\t@Resource\r\n\tpublic void setSpringFestivalShipTimeRuleService(SpringFestivalShipTimeRuleService springFestivalShipTimeRuleService) {\r\n\t\tthis.springFestivalShipTimeRuleService = springFestivalShipTimeRuleService;\r\n\t}\r\n}\r\n\n---END---\n\n!!! NOT FOUND: adp-logistics/adp-logistics-biz/src/main/java/com/alibaba/delivery/logistics/ability/shiptime/strategy/TmallTimingBrandSellerStorePkgShipTimeStrategy.java\n\n!!! NOT FOUND: adp-logistics/adp-logist