{"type":"message","id":"50227ac2","parentId":"d42670d5","timestamp":"2026-05-28T11:18:41.349Z","message":{"role":"toolResult","toolCallId":"call_60dcbfc96ca941349d31bae2","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.adapter.cn.util;\r\n\r\nimport com.ali.com.google.common.collect.Lists;\r\nimport com.alibaba.ascp.promise.common.constant.PlatformCommonConstants;\r\nimport com.alibaba.delivery.common.constant.AdpInterfaceSource;\r\nimport com.alibaba.delivery.common.constant.LogisticsServiceEnum;\r\nimport com.alibaba.delivery.common.diamond.platform.AdpPlatformBizConfig;\r\nimport com.alibaba.delivery.logistics.entity.core.constant.ShipTypeEnum;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryCarrierDO;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryPackageDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.InnerItemShipTimeTO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.SdpShipTimeResultTO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeDTO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeFeatureConstant;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.SpringFestivalDTO;\r\nimport com.alibaba.delivery.logistics.entity.params.targets.DeliveryCarrierDTO;\r\nimport com.alibaba.delivery.rule.diamond.shiptime.AdpShipTimeConfig;\r\nimport com.cainiao.cdc.common.constant.CommonConstant;\r\nimport com.cainiao.cdc.common.response.common.FeeDesc;\r\nimport com.google.common.collect.Maps;\r\nimport com.taobao.adapter.common.transfer.time.ItemLogisticsInfoTO;\r\nimport com.taobao.adapter.common.transfer.time.ItemShipTimeTO;\r\nimport com.taobao.delivery.common.constant.ShipTimeStandardEnum;\r\nimport com.taobao.delivery.common.transfer.PromiseControlItem;\r\nimport com.taobao.delivery.common.transfer.PromiseItem;\r\nimport com.taobao.delivery.common.transfer.ShipTimeTO;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.collections4.MapUtils;\r\nimport org.apache.commons.lang3.StringUtils;\r\nimport org.slf4j.Logger;\r\nimport org.slf4j.LoggerFactory;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.HashMap;\r\nimport java.util.HashSet;\r\nimport java.util.Iterator;\r\nimport java.util.List;\r\nimport java.util.Map;\r\nimport java.util.Objects;\r\nimport java.util.Optional;\r\nimport java.util.Set;\r\nimport java.util.StringJoiner;\r\n\r\n/**\r\n * @author yizhen 2021/04/23.\r\n */\r\npublic class ShipTimeAdapterUtils {\r\n\r\n    private static final Logger LOGGER = LoggerFactory.getLogger(ShipTimeAdapterUtils.class);\r\n\r\n    public static final String STD_CONSO_BUYER_ADDRESS = \"stdConsoBuyerAddress\";\r\n\r\n    private static final String ORIGIN_SHIP_TIME = \"originShiptime\";\r\n\r\n    private static final String C2M_AB_TEST_TIME = \"c2m_ab_test_time\";\r\n\r\n    private static final String SDP_SHIP_TEXT = \"shipTimeText\";\r\n\r\n    private static final String SDP_SHIP_TYPE = \"originShipType\";\r\n\r\n    public static final String STANDARD_SDP_SHIPTIME = \"StandardSdpShipTime\";\r\n\r\n    private static final String SAMPLE_ROOM_TAG = \"sampleRoomTag\";\r\n\r\n    private static final String SDP_SUPPLY_CONTROL_SCENE = \"supplyControlScene\";\r\n\r\n    /**\r\n     * ��������ʱЧ��׼\r\n     * @param logisticsServiceCode\r\n     * @return\r\n     */\r\n    public static ShipTimeStandardEnum parseShipTimeStandard(String logisticsServiceCode){\r\n        if(logisticsServiceCode == null){\r\n            return null;\r\n        }\r\n        LogisticsServiceEnum logisticsServiceEnum = LogisticsServiceEnum.getEnumByTypeCode(logisticsServiceCode);\r\n        if(logisticsServiceEnum == null){\r\n            return null;\r\n        }\r\n        switch (logisticsServiceEnum){\r\n            case MAOCHAO_TODAY_SEND: return ShipTimeStandardEnum.TODAY_SHIPPING;\r\n            case MAOCHAO_24_HOURS_SEND: return ShipTimeStandardEnum.HOUR24_SHIPPING;\r\n            case MAOCHAO_48_HOURS_SEND: return ShipTimeStandardEnum.HOUR48_SHIPPING;\r\n            default: break;\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * �����б���������ʱЧ��׼\r\n     * ����ʱЧ��׼һ��ֻ��һ��\r\n     * @param logisticsServiceCodes\r\n     * @return\r\n     */\r\n    public static ShipTimeStandardEnum parseShipTimeStandard(List<String> logisticsServiceCodes){\r\n        if(CollectionUtils.isEmpty(logisticsServiceCodes)){\r\n            return null;\r\n        }\r\n        for(String s : logisticsServiceCodes){\r\n            ShipTimeStandardEnum shipTimeStandardEnum = parseShipTimeStandard(s);\r\n            if(shipTimeStandardEnum != null){\r\n                return shipTimeStandardEnum;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    public static Long getStdConsoBuyerAddress(DeliveryCarrierDTO deliveryCarrierDTO) {\r\n        if (Objects.nonNull(deliveryCarrierDTO)) {\r\n            Map<String, Object> extendMap = deliveryCarrierDTO.getExtendMap();\r\n            if (MapUtils.isNotEmpty(extendMap)) {\r\n                Object stdConsoBuyerAddress = extendMap.get(STD_CONSO_BUYER_ADDRESS);\r\n                if (Objects.nonNull(stdConsoBuyerAddress)) {\r\n                    return (Long)stdConsoBuyerAddress;\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    public static SdpShipTimeResultTO getSdpShipTimeResultTO(FeeDesc feeDesc) {\r\n        if (feeDesc != null) {\r\n            Map<String, Object> ext = feeDesc.getExt();\r\n            if (MapUtils.isNotEmpty(ext)) {\r\n                Object c2mAbTestTimeObj = ext.get(C2M_AB_TEST_TIME);\r\n                Object originShipTime = ext.get(ORIGIN_SHIP_TIME);\r\n                SdpShipTimeResultTO sdpShipTimeResultTO = new SdpShipTimeResultTO();\r\n                if (c2mAbTestTimeObj instanceof String) {\r\n                    Map<String, String> sdpExt = new HashMap<>();\r\n                    sdpExt.put(C2M_AB_TEST_TIME, (String)c2mAbTestTimeObj);\r\n                    sdpShipTimeResultTO.setExt(sdpExt);\r\n                }\r\n                if (originShipTime instanceof String) {\r\n                    sdpShipTimeResultTO.setOriginShipTime((String)originShipTime);\r\n\r\n                    if (AdpShipTimeConfig.getInstance().isOpenSdpStandardShipTime()) {\r\n                        final Object sdpShipText = ext.get(SDP_SHIP_TEXT);\r\n                        if (sdpShipText instanceof String) {\r\n                            sdpShipTimeResultTO.setShipTimeText((String) sdpShipText);\r\n                        }\r\n                        final Object sdpShipType = ext.get(SDP_SHIP_TYPE);\r\n                        if (sdpShipType instanceof String) {\r\n                            sdpShipTimeResultTO.setShipTimeType((String) sdpShipType);\r\n                        }\r\n                    }\r\n\r\n                    // sdp������ŵ����䣨������Ҫ��ȡfeeDesc�����shipPromiseItem��shipSellType��shipTimingFeature�ȷ�����Ϣ��\r\n                    sdpShipTimeResultTO.setPromiseItem(SdpPromiseItemAdapterUtil.convertPromiseItem(feeDesc.getShipPromiseItem()));\r\n                    sdpShipTimeResultTO.setSellType(feeDesc.getShipSellType());\r\n                    sdpShipTimeResultTO.setTimingFeature(SdpPromiseItemAdapterUtil.convertTimingFeature(feeDesc.getShipTimingFeature()));\r\n                    sdpShipTimeResultTO.setShipTimeCutOffMinutes(feeDesc.getShipTimeCutOffMinutes());\r\n\r\n                    return sdpShipTimeResultTO;\r\n                }\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * sdp��������䵽adp\r\n     */\r\n    public static void flushShipTimeToAdpModel(FeeDesc feeDesc, SdpShipTimeResultTO sdpShipTimeResultTO,\r\n                                               Map<String, InnerItemShipTimeTO> itemShipTimeTOMap,\r\n                                               DeliveryPackageDO deliveryPackage) {\r\n        // ����ά�����\r\n        if (sdpShipTimeResultTO != null ) {\r\n            for (DeliveryCarrierDO deliveryCarrierDO : deliveryPackage.getDeliveryCarrierList()) {\r\n                deliveryCarrierDO.getDeliveryCarrierDTO().setSdpShipTimeResultTO(sdpShipTimeResultTO);\r\n            }\r\n        }\r\n\r\n        // �ӵ�ά�����\r\n        if (MapUtils.isNotEmpty(itemShipTimeTOMap)) {\r\n            for (DeliveryCarrierDO deliveryCarrierDO : deliveryPackage.getDeliveryCarrierList()) {\r\n                InnerItemShipTimeTO itemShipTimeTO = itemShipTimeTOMap.get(deliveryCarrierDO.getItemSkuId());\r\n                SdpShipTimeResultTO sdpItemShipTimeResultTO = buildSdpShipTimeResultTO(feeDesc, itemShipTimeTO);\r\n                deliveryCarrierDO.getDeliveryCarrierDTO().setSdpItemShipTimeResultTO(sdpItemShipTimeResultTO);\r\n            }\r\n        }\r\n    }\r\n\r\n\r\n    /**\r\n     * ���ӵ�ά�ȹ��� SdpShipTimeResultTO\r\n     */\r\n    private static SdpShipTimeResultTO buildSdpShipTimeResultTO(FeeDesc feeDesc, InnerItemShipTimeTO innerItemShipTimeTO) {\r\n        if (Objects.isNull(innerItemShipTimeTO)) {\r\n            return null;\r\n        }\r\n\r\n        ItemShipTimeTO itemShipTimeTO = innerItemShipTimeTO.getItemShipTimeTO();\r\n        if (Objects.isNull(itemShipTimeTO)) {\r\n            return null;\r\n        }\r\n\r\n        // �ӵ�ά��ʱЧ���\r\n        SdpShipTimeResultTO sdpShipTimeResultTO = new SdpShipTimeResultTO();\r\n        sdpShipTimeResultTO.setTimingFeature(new HashMap<>());\r\n        sdpShipTimeResultTO.setOriginShipTime(itemShipTimeTO.getShipTime());\r\n        sdpShipTimeResultTO.setShipTimeType(itemShipTimeTO.getShipTimeBusinessType());\r\n\r\n        // ���ʶ��Ʊ�\r\n        Map<String, Object> feeDescExt = Optional.ofNullable(innerItemShipTimeTO).map(InnerItemShipTimeTO::getFeeDesc)\r\n                .map(FeeDesc::getExt).orElse(null);\r\n\r\n        if (MapUtils.isNotEmpty(feeDescExt) && Objects.nonNull(feeDescExt.get(CommonConstant.SHIP_TIME_FROM_SDP_TMHK))) {\r\n            StringJoiner sdpTmhkShipTimeFlag = new StringJoiner(\",\");\r\n            sdpTmhkShipTimeFlag.add(itemShipTimeTO.getShipTimeBusinessType());\r\n            sdpTmhkShipTimeFlag.add(itemShipTimeTO.getShipTime());\r\n            sdpShipTimeResultTO.getTimingFeature().put(ShipTimeFeatureConstant.SDP_TMHK_SHIP_TIME_FLAG, sdpTmhkShipTimeFlag.toString());\r\n        }\r\n\r\n        sdpShipTimeResultTO.setShipTimeBusinessType(itemShipTimeTO.getShipTimeBusinessType());\r\n\r\n        return sdpShipTimeResultTO;\r\n    }\r\n\r\n    /**\r\n     * sdp�ܿؽ����䵽adp\r\n     */\r\n    public static void flushPromiseControlToAdpModel(List<PromiseControlItem> promiseControlItems, DeliveryPackageDO deliveryPackage) {\r\n        for (DeliveryCarrierDO deliveryCarrierDO : deliveryPackage.getDeliveryCarrierList()) {\r\n            DeliveryCarrierDTO carrierDTO = deliveryCarrierDO.getDeliveryCarrierDTO();\r\n            if (carrierDTO == null) {\r\n                continue;\r\n            }\r\n            List<PromiseControlItem> controlItems = carrierDTO.getPromiseControlItems();\r\n            if (CollectionUtils.isEmpty(controlItems)) {\r\n                controlItems = new ArrayList<>();\r\n                carrierDTO.setPromiseControlItems(controlItems);\r\n            }\r\n            controlItems.addAll(promiseControlItems);\r\n        }\r\n    }\r\n\r\n    public static Set<String> parseSpringControlScenes(FeeDesc feeDesc){\r\n        if(feeDesc == null){\r\n            return null;\r\n        }\r\n        Map<String,Object> ext = feeDesc.getExt();\r\n        if(MapUtils.isEmpty(ext)){\r\n            return null;\r\n        }\r\n        if(!ext.containsKey(SDP_SUPPLY_CONTROL_SCENE)){\r\n            return null;\r\n        }\r\n        Object object = ext.get(SDP_SUPPLY_CONTROL_SCENE);\r\n        if(object == null){\r\n            return null;\r\n        }\r\n        if(object instanceof Set){\r\n            return (Set<String>)object;\r\n        }\r\n        if(object instanceof List){\r\n            return new HashSet<>((List<String>)object);\r\n        }\r\n        return null;\r\n    }\r\n\r\n    public static void flushSpringFestivalToAdpModelForPackageAndItems(FeeDesc feeDesc, DeliveryPackageDO deliveryPackage, AdpInterfaceSource adpInterfaceSource) {\r\n        if(Objects.isNull(feeDesc)){\r\n            return;\r\n        }\r\n        // ���������Ĵ��ڲ�������Ϣ\r\n        Set<String> mainOrderControlScenes = parseSpringControlScenes(feeDesc);\r\n        if (Objects.nonNull(deliveryPackage.getDeliveryPackageDTO())) {\r\n            SpringFestivalDTO springFestivalDTO = Optional.ofNullable(deliveryPackage.getDeliveryPackageDTO().getSpringFestivalDTO())\r\n                .orElseGet(SpringFestivalDTO::new);\r\n             springFestivalDTO.setControlScenes(mainOrderControlScenes);\r\n             deliveryPackage.getDeliveryPackageDTO().setSpringFestivalDTO(springFestivalDTO);\r\n        }\r\n\r\n        // �����ӵ��Ĵ��ڲ�������Ϣ\r\n        if (MapUtils.isEmpty(feeDesc.getItemLogisticsInfoTOMap())) {\r\n            return;\r\n        }\r\n        Optional.ofNullable(deliveryPackage.getDeliveryCarrierList()).orElse(Lists.newArrayList())\r\n            .forEach(deliveryCarrierDO -> {\r\n                DeliveryCarrierDTO carrierDTO = deliveryCarrierDO.getDeliveryCarrierDTO();\r\n                if (Objects.isNull(carrierDTO)) {\r\n                    return;\r\n                }\r\n                ItemLogisticsInfoTO itemLogisticsInfoTO = feeDesc.getItemLogisticsInfoTOMap()\r\n                    .getOrDefault(buildUniqueKey(carrierDTO.getUniqueKey(), null, carrierDTO.getItemId(), carrierDTO.getSkuId(), adpInterfaceSource), null);\r\n\r\n                if (Objects.isNull(itemLogisticsInfoTO)) {\r\n                    return;\r\n                }\r\n                SpringFestivalDTO itemSpringFestivalDTO = Optional.ofNullable(carrierDTO.getSpringFestivalDTO())\r\n                    .orElseGet(SpringFestivalDTO::new);\r\n                itemSpringFestivalDTO.setControlScenes(itemLogisticsInfoTO.getSupplyControlScene());\r\n                carrierDTO.setSpringFestivalDTO(itemSpringFestivalDTO);\r\n            });\r\n\r\n    }\r\n\r\n    // orderId���µ������·�Ż��У���ADP�ж�û�У����ж���null\r\n    private static String buildUniqueKey(String outId, String orderId, Long itemId, Long skuId, AdpInterfaceSource adpInterfaceSource) {\r\n       if (Objects.equals(adpInterfaceSource, AdpInterfaceSource.DETAIL)) {\r\n           return \"0\" + \"#\"\r\n               + \"0\" + \"#\"\r\n               + Optional.ofNullable(itemId).orElse(0L) + \"#\"\r\n               + Optional.ofNullable(skuId).orElse(0L);\r\n       }\r\n        return Optional.ofNullable(outId).orElse(\"0\") + \"#\"\r\n            + Optional.ofNullable(orderId).orElse(\"0\") + \"#\"\r\n            + Optional.ofNullable(itemId).orElse(0L) + \"#\"\r\n            + Optional.ofNullable(skuId).orElse(0L);\r\n    }\r\n\r\n    /**\r\n     * ��ȡ�ӵ�����ʱЧMap\r\n     * ps.������TmallTimingBrandAdapterProcessor�аᵽ�ù�������\r\n     */\r\n    public static Map<String, InnerItemShipTimeTO> getItemShipTimeTOMap(Map<Long, FeeDesc> feeMap) {\r\n        Map<String, InnerItemShipTimeTO> itemShipTimeTOMap = Maps.newHashMap();\r\n        if (MapUtils.isEmpty(feeMap)) {\r\n            return itemShipTimeTOMap;\r\n        }\r\n\r\n        Iterator<Map.Entry<Long, FeeDesc>> iterator = feeMap.entrySet().iterator();\r\n        while (iterator.hasNext()) {\r\n            Map.Entry<Long, FeeDesc> next = iterator.next();\r\n            FeeDesc value = next.getValue();\r\n            if (value == null) {\r\n                continue;\r\n            }\r\n\r\n            List<ItemShipTimeTO> itemShipTimeTOList = value.getItemShipTimeTOList();\r\n            if (CollectionUtils.isEmpty(itemShipTimeTOList)) {\r\n                continue;\r\n            }\r\n\r\n            for (ItemShipTimeTO itemShipTimeTO : itemShipTimeTOList) {\r\n                if (itemShipTimeTO == null || itemShipTimeTO.getItemId() == null) {\r\n                    continue;\r\n                }\r\n\r\n                Long itemId = itemShipTimeTO.getItemId();\r\n                Long skuId = itemShipTimeTO.getSkuId() == null ? Integer.valueOf(0) : itemShipTimeTO.getSkuId();\r\n\r\n                InnerItemShipTimeTO innerItemShipTimeTO = new InnerItemShipTimeTO();\r\n                innerItemShipTimeTO.setItemShipTimeTO(itemShipTimeTO);\r\n                innerItemShipTimeTO.setFeeDesc(value);\r\n                itemShipTimeTOMap.put(itemId + \"_\" + skuId, innerItemShipTimeTO);\r\n            }\r\n        }\r\n\r\n        return itemShipTimeTOMap;\r\n    }\r\n\r\n    /**\r\n     * ��ȡ�ӵ�����ʱЧMap\r\n     * ps.������TmallTimingBrandAdapterProcessor�аᵽ�ù�������\r\n     */\r\n    public static Map<String, InnerItemShipTimeTO> getItemPredictShipTimeTOMap(Map<Long, FeeDesc> feeMap) {\r\n        Map<String, InnerItemShipTimeTO> itemPredictShipTimeTOMap = Maps.newHashMap();\r\n        if (MapUtils.isEmpty(feeMap)) {\r\n            return itemPredictShipTimeTOMap;\r\n        }\r\n\r\n        Iterator<Map.Entry<Long, FeeDesc>> iterator = feeMap.entrySet().iterator();\r\n        while (iterator.hasNext()) {\r\n            try {\r\n                Map.Entry<Long, FeeDesc> next = iterator.next();\r\n                FeeDesc value = next.getValue();\r\n                if (value == null) {\r\n                    continue;\r\n                }\r\n\r\n                List<ItemShipTimeTO> itemPredictShipTimeTOList = value.getItemPredictShipTimeTOList();\r\n                if (CollectionUtils.isEmpty(itemPredictShipTimeTOList)) {\r\n                    continue;\r\n                }\r\n\r\n                for (ItemShipTimeTO itemPredictShipTimeTO : itemPredictShipTimeTOList) {\r\n                    if (itemPredictShipTimeTO == null || itemPredictShipTimeTO.getItemId() == null) {\r\n                        continue;\r\n                    }\r\n\r\n                    if (!ShipTypeEnum.PREDICT_SHIP_TIMING.getType().equals(itemPredictShipTimeTO.getShipTimeBusinessType())) {\r\n                        continue;\r\n                    }\r\n\r\n                    if (itemPredictShipTimeTO.getPredictShipTimeHour() == null || itemPredictShipTimeTO.getPredictShipTimeHour() <= 0) {\r\n                        continue;\r\n                    }\r\n\r\n                    if (StringUtils.isBlank(itemPredictShipTimeTO.getPredictShipConfidence())) {\r\n                        continue;\r\n                    }\r\n\r\n                    Long itemId = itemPredictShipTimeTO.getItemId();\r\n                    Long skuId = itemPredictShipTimeTO.getSkuId() == null ? 0 : itemPredictShipTimeTO.getSkuId();\r\n\r\n                    InnerItemShipTimeTO innerItemShipTimeTO = new InnerItemShipTimeTO();\r\n                    innerItemShipTimeTO.setItemShipTimeTO(itemPredictShipTimeTO);\r\n                    innerItemShipTimeTO.setFeeDesc(value);\r\n                    itemPredictShipTimeTOMap.put(itemId + \"_\" + skuId, innerItemShipTimeTO);\r\n                }\r\n            } catch (Exception e) {\r\n                LOGGER.error(\"ShipTimeAdapterUtils.getItemPredictShipTimeTOMap.error: \", e);\r\n            }\r\n        }\r\n\r\n        return itemPredictShipTimeTOMap;\r\n    }\r\n\r\n    public static ShipTimeDTO transferToShipTimeDTO(InnerItemShipTimeTO innerItemShipTimeTO) {\r\n        ItemShipTimeTO itemShipTimeTO = innerItemShipTimeTO.getItemShipTimeTO();\r\n        FeeDesc feeDesc = innerItemShipTimeTO.getFeeDesc();\r\n        if (itemShipTimeTO == null || feeDesc == null) {\r\n            return null;\r\n        }\r\n        ShipTimeDTO shipTimeDTOFromSdp = new ShipTimeDTO();\r\n        shipTimeDTOFromSdp.setShipTime(itemShipTimeTO.getShipTime());\r\n        shipTimeDTOFromSdp.setShipType(itemShipTimeTO.getShipTimeBusinessType());\r\n        shipTimeDTOFromSdp.setDecisionReason(itemShipTimeTO.getDecisionReason());\r\n        shipTimeDTOFromSdp.setPredictShipTimeHour(itemShipTimeTO.getPredictShipTimeHour());\r\n        if (AdpPlatformBizConfig.getOpenMcShipTimeTimingMins()) {\r\n            //����ʱЧ������\r\n            shipTimeDTOFromSdp.setTiming(itemShipTimeTO.getIntervalMinutes());\r\n        }\r\n        Map<String, String> feature = shipTimeDTOFromSdp.getFeature();\r\n        if (feature == null) {\r\n            feature = Maps.newHashMap();\r\n            shipTimeDTOFromSdp.setFeature(feature);\r\n        }\r\n        if (MapUtils.isNotEmpty(itemShipTimeTO.getShipTimingFeature())) {\r\n            feature.putAll(itemShipTimeTO.getShipTimingFeature());\r\n        }\r\n        if (itemShipTimeTO.getCutOffMinutes() != null) {\r\n            feature.put(\"cutoffMinutes\", String.valueOf(itemShipTimeTO.getCutOffMinutes()));\r\n            shipTimeDTOFromSdp.setShipTimeCutOffMinutes(String.valueOf(itemShipTimeTO.getCutOffMinutes()));\r\n        }\r\n        if (StringUtils.isNotEmpty(itemShipTimeTO.getShipModel()) ) {\r\n            feature.put(\"2LevelServiceCode\", itemShipTimeTO.getShipModel());\r\n        }\r\n\r\n        feature.put(ShipTimeFeatureConstant.PROMISE_KEY, String.valueOf(itemShipTimeTO.isPromise()));\r\n        if (StringUtils.isNotEmpty(itemShipTimeTO.getFulfillmentType())) {\r\n            feature.put(PlatformCommonConstants.FULFILLMENT_TYPE, itemShipTimeTO.getFulfillmentType());\r\n        }\r\n        if (StringUtils.isNotBlank(itemShipTimeTO.getPredictShipConfidence())) {\r\n            feature.put(ShipTimeFeatureConstant.PREDICT_SHIP_CONFIDENCE, itemShipTimeTO.getPredictShipConfidence());\r\n        }\r\n\r\n        // ����ŵ��\r\n        PromiseItem promiseItem = shipTimeDTOFromSdp.getPromiseItem();\r\n        if (promiseItem != null && StringUtils.isBlank(promiseItem.getSupplySource())) {\r\n            promiseItem.setSupplySource(itemShipTimeTO.getShipTimeBusinessType());\r\n        }\r\n        wrapSdpPromiseItemDataByDTO(itemShipTimeTO, shipTimeDTOFromSdp, feeDesc);\r\n\r\n        if (StringUtils.isNotBlank(itemShipTimeTO.getShipTimeText())) {\r\n            shipTimeDTOFromSdp.setShipTimeText(itemShipTimeTO.getShipTimeText());\r\n        }\r\n        // ʶ������������\r\n        Map<String, Object> ext = feeDesc.getExt();\r\n        if (MapUtils.isNotEmpty(ext)) {\r\n            Object sampleRoomTag = ext.get(SAMPLE_ROOM_TAG);\r\n            if (sampleRoomTag != null) {\r\n                feature.put(SAMPLE_ROOM_TAG, sampleRoomTag.toString());\r\n            }\r\n        }\r\n\r\n        // �ֿ����\r\n        shipTimeDTOFromSdp.setWarehouseCode(itemShipTimeTO.getWarehouseCode());\r\n\r\n        return shipTimeDTOFromSdp;\r\n    }\r\n\r\n    public static ShipTimeTO transferToShipTimeTO(InnerItemShipTimeTO innerItemShipTimeTO) {\r\n        ItemShipTimeTO itemShipTimeTO = innerItemShipTimeTO.getItemShipTimeTO();\r\n        FeeDesc feeDesc = innerItemShipTimeTO.getFeeDesc();\r\n        if (itemShipTimeTO == null || feeDesc == null) {\r\n            return null;\r\n        }\r\n        ShipTimeTO shipTimeTOFromSdp = new ShipTimeTO();\r\n        shipTimeTOFromSdp.setShipTime(itemShipTimeTO.getShipTime());\r\n        shipTimeTOFromSdp.setShipType(itemShipTimeTO.getShipTimeBusinessType());\r\n        if (AdpPlatformBizConfig.getOpenMcShipTimeTimingMins()) {\r\n            //����ʱЧ������\r\n            shipTimeTOFromSdp.setTiming(itemShipTimeTO.getIntervalMinutes());\r\n        }\r\n\r\n        Map<String, Object> ext = shipTimeTOFromSdp.getExts();\r\n        if (ext == null) {\r\n            ext = Maps.newHashMap();\r\n            shipTimeTOFromSdp.setExts(ext);\r\n        }\r\n        if (itemShipTimeTO.getCutOffMinutes() != null) {\r\n            ext.put(\"cutoffMinutes\", String.valueOf(itemShipTimeTO.getCutOffMinutes()));\r\n            shipTimeTOFromSdp.setShipTimeCutOffMinutes(String.valueOf(itemShipTimeTO.getCutOffMinutes()));\r\n        }\r\n        if (StringUtils.isNotEmpty(itemShipTimeTO.getShipModel()) ) {\r\n            ext.put(\"2LevelServiceCode\", itemShipTimeTO.getShipModel());\r\n        }\r\n\r\n        ext.put(\"promise\", String.valueOf(itemShipTimeTO.isPromise()));\r\n        if (StringUtils.isNotEmpty(itemShipTimeTO.getFulfillmentType())) {\r\n            ext.put(PlatformCommonConstants.FULFILLMENT_TYPE, itemShipTimeTO.getFulfillmentType());\r\n        }\r\n\r\n        // ����ŵ��\r\n        PromiseItem promiseItem = shipTimeTOFromSdp.getPromiseItem();\r\n        if (promiseItem != null && StringUtils.isBlank(promiseItem.getSupplySource())) {\r\n            promiseItem.setSupplySource(itemShipTimeTO.getShipTimeBusinessType());\r\n        }\r\n        wrapSdpPromiseItemDataByTO(itemShipTimeTO, shipTimeTOFromSdp, feeDesc);\r\n\r\n        if (StringUtils.isNotBlank(itemShipTimeTO.getShipTimeText())) {\r\n            shipTimeTOFromSdp.setShipTimeText(itemShipTimeTO.getShipTimeText());\r\n        }\r\n\r\n        // ʶ������������\r\n        Map<String, Object> extData = feeDesc.getExt();\r\n        if (MapUtils.isNotEmpty(extData)) {\r\n            Object sampleRoomTag = extData.get(SAMPLE_ROOM_TAG);\r\n            if (sampleRoomTag != null) {\r\n                ext.put(SAMPLE_ROOM_TAG, sampleRoomTag.toString());\r\n            }\r\n        }\r\n\r\n        return shipTimeTOFromSdp;\r\n    }\r\n\r\n    public static List<PromiseControlItem> transferToPromiseControlItems(InnerItemShipTimeTO innerItemShipTimeTO) {\r\n        FeeDesc feeDesc = Optional.ofNullable(innerItemShipTimeTO).map(InnerItemShipTimeTO :: getFeeDesc).orElse(null);\r\n        if (feeDesc == null) {\r\n            return new ArrayList<>();\r\n        }\r\n        return SdpPromiseItemAdapterUtil.convertPromiseControlItems(feeDesc.getPromiseControlItems());\r\n    }\r\n\r\n    private static void wrapSdpPromiseItemDataByDTO(ItemShipTimeTO itemShipTimeTO, ShipTimeDTO shipTimeDTO, FeeDesc feeDesc) {\r\n        if (itemShipTimeTO != null && itemShipTimeTO.getShipPromiseItem() != null) {\r\n            shipTimeDTO.setPromiseItem(SdpPromiseItemAdapterUtil.convertPromiseItem(itemShipTimeTO.getShipPromiseItem()));\r\n            shipTimeDTO.setSellType(itemShipTimeTO.getShipSellType());\r\n            shipTimeDTO.setTimingFeature(SdpPromiseItemAdapterUtil.convertTimingFeature(itemShipTimeTO.getShipTimingFeature()));\r\n        } else {\r\n            shipTimeDTO.setPromiseItem(SdpPromiseItemAdapterUtil.convertPromiseItem(feeDesc.getShipPromiseItem()));\r\n            shipTimeDTO.setSellType(feeDesc.getShipSellType());\r\n            shipTimeDTO.setTimingFeature(SdpPromiseItemAdapterUtil.convertTimingFeature(feeDesc.getShipTimingFeature()));\r\n        }\r\n        /*\r\n            ��Ϊǰ���Ѿ�ͨ�� feature.put(\"cutoffMinutes\", String.valueOf(itemShipTimeTO.getCutOffMinutes())); ��ֵ��һ��shipTimeCutOffMinutes\r\n            �������ֻ��shipTimeDTO�� shipTimeCutOffMinutes û�е�����£��ų���ֱ�ӻ�ȡitemShipTimeTO��shipTimeCutOffMinutes\r\n         */\r\n        if (StringUtils.isBlank(shipTimeDTO.getShipTimeCutOffMinutes())) {\r\n            shipTimeDTO.setShipTimeCutOffMinutes(itemShipTimeTO.getShipTimeCutOffMinutes());\r\n            /*\r\n                FeeDescЭ������ǰͨ��feeDesc.getShipTimeCutOffMinutes()��ȡ���������ŵ��ģ�ͷ���FeeDesc��List<ItemShipTimeTO>�У�\r\n                ��adp��ֱ�Ӵ�itemShipTimeTO��ȡ\r\n             */\r\n//            shipTimeDTO.setShipTimeCutOffMinutes(feeDesc.getShipTimeCutOffMinutes());\r\n        }\r\n    }\r\n\r\n    private static void wrapSdpPromiseItemDataByTO(ItemShipTimeTO itemShipTimeTO, ShipTimeTO shipTimeTOFromSdp, FeeDesc feeDesc) {\r\n        if (itemShipTimeTO != null && itemShipTimeTO.getShipPromiseItem() != null) {\r\n            shipTimeTOFromSdp.setPromiseItem(SdpPromiseItemAdapterUtil.convertPromiseItem(itemShipTimeTO.getShipPromiseItem()));\r\n            shipTimeTOFromSdp.setSellType(itemShipTimeTO.getShipSellType());\r\n            shipTimeTOFromSdp.setTimingFeature(SdpPromiseItemAdapterUtil.convertTimingFeature(itemShipTimeTO.getShipTimingFeature()));\r\n        } else {\r\n            shipTimeTOFromSdp.setPromiseItem(SdpPromiseItemAdapterUtil.convertPromiseItem(feeDesc.getShipPromiseItem()));\r\n            shipTimeTOFromSdp.setSellType(feeDesc.getShipSellType());\r\n            shipTimeTOFromSdp.setTimingFeature(SdpPromiseItemAdapterUtil.convertTimingFeature(feeDesc.getShipTimingFeature()));\r\n        }\r\n        /*\r\n            ��Ϊǰ���Ѿ�ͨ�� feature.put(\"cutoffMinutes\", String.valueOf(itemShipTimeTO.getCutOffMinutes())); ��ֵ��һ��shipTimeCutOffMinutes\r\n            �������ֻ��shipTimeTOFromSdp�� shipTimeCutOffMinutes û�е�����£��ų���ֱ�ӻ�ȡfeeDesc��shipTimeCutOffMinutes\r\n         */\r\n        if (StringUtils.isBlank(shipTimeTOFromSdp.getShipTimeCutOffMinutes())) {\r\n            shipTimeTOFromSdp.setShipTimeCutOffMinutes(itemShipTimeTO.getShipTimeCutOffMinutes());\r\n            /*\r\n                FeeDescЭ������ǰͨ��feeDesc.getShipTimeCutOffMinutes()��ȡ���������ŵ��ģ�ͷ���FeeDesc��List<ItemShipTimeTO>�У�\r\n                ��adp��ֱ�Ӵ�itemShipTimeTO��ȡ\r\n             */\r\n//            shipTimeTOFromSdp.setShipTimeCutOffMinutes(feeDesc.getShipTimeCutOffMinutes());\r\n        }\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779967121349}}
