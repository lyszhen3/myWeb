ty.core.protocol.DeliveryProtocolDO;\r\nimport com.alibaba.delivery.logistics.entity.core.protocol.ProtocolDefinitionDO;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryCarrierDO;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryPackageDO;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryPackageGroupDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.BaseTimingDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.DeliveryTimingDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.SignTimeDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.TimingType;\r\nimport com.alibaba.delivery.logistics.entity.params.tag.TimingOrderTags;\r\nimport com.alibaba.delivery.logistics.entity.params.trade.TradeStageDTO;\r\nimport com.alibaba.delivery.logistics.utils.DateFormatCacheUtils;\r\nimport com.alibaba.delivery.logistics.utils.PlatformSPiInvokeUtil;\r\nimport com.alibaba.delivery.logistics.utils.track.NoTimingReason;\r\nimport com.alibaba.delivery.logistics.utils.track.TrackUtil;\r\nimport com.alibaba.delivery.rule.cache.ProtocolRuleCache;\r\nimport com.alibaba.delivery.rule.util.TimingUtil;\r\nimport com.google.common.collect.Lists;\r\nimport com.taobao.delivery.common.constant.PromiseMarketChannelEnum;\r\nimport com.taobao.delivery.common.constant.PromiseStandardEnum;\r\nimport com.taobao.delivery.common.dataobject.trade.BuyOrderLineTO;\r\nimport com.taobao.delivery.common.dataobject.trade.TradeRouteInput;\r\nimport com.taobao.delivery.common.transfer.DeliveryDetailInput;\r\nimport com.taobao.delivery.common.transfer.PromiseItem;\r\nimport com.taobao.uic.common.domain.BaseDeliverAddressDO;\r\nimport com.taobao.util.CollectionUtil;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.collections4.MapUtils;\r\nimport org.apache.commons.lang.StringUtils;\r\nimport org.joda.time.DateTime;\r\n\r\nimport java.text.SimpleDateFormat;\r\nimport java.util.ArrayList;\r\nimport java.util.Collections;\r\nimport java.util.Date;\r\nimport java.util.HashMap;\r\nimport java.util.Iterator;\r\nimport java.util.List;\r\nimport java.util.Map;\r\nimport java.util.Set;\r\n\r\n/**\r\n * @Description:\r\n * @Author: ���\r\n * @Date: 2020-03-19\r\n */\r\npublic class EstimateTimeUtils {\r\n\r\n    private static final String DATE_FMT2 = \"M��d��\";\r\n\r\n    /**\r\n     * תΪsignTimeDO\r\n     *\r\n     * @param predictiveTimingDO\r\n     * @return\r\n     */\r\n    public static SignTimeDO convert(PredictiveTimingDO predictiveTimingDO, String bizCode, boolean originMobile) {\r\n        if (predictiveTimingDO == null) {\r\n            return null;\r\n        }\r\n\r\n        SignTimeDO signTimeDO = new SignTimeDO();\r\n        DateTime arriveTime = predictiveTimingDO.getArriveTime();\r\n        signTimeDO.setArriveDateTime(arriveTime != null ? arriveTime.toDate() : null);\r\n        signTimeDO.setCutOffTime(predictiveTimingDO.getCutOffTime());\r\n        signTimeDO.setIsPromise(predictiveTimingDO.getPromise());\r\n        signTimeDO.setLineTiming(predictiveTimingDO.getLineTiming());\r\n        signTimeDO.setProbability(predictiveTimingDO.getProbability());\r\n        signTimeDO.setTiming(predictiveTimingDO.getTiming());\r\n        DateTime waveDate = predictiveTimingDO.getWaveDate();\r\n        signTimeDO.setWaveDateTime(waveDate != null ? waveDate.toDate() : null);\r\n        signTimeDO.setBizCode(bizCode);\r\n        signTimeDO.setOriginMobile(originMobile);\r\n        signTimeDO.setShipType(predictiveTimingDO.getShipType());\r\n        signTimeDO.setOnlyShipTime(predictiveTimingDO.getOnlyShipTime());\r\n        // ��ŵ�����\r\n        signTimeDO.setPromiseItem(predictiveTimingDO.getPromiseItem());\r\n        signTimeDO.setSellType(predictiveTimingDO.getSellType());\r\n        signTimeDO.setTimingFeature(predictiveTimingDO.getTimingFeature());\r\n        signTimeDO.setTimingType(predictiveTimingDO.getTimingType());\r\n        // ����ʱЧ����\r\n        signTimeDO.setSignType(predictiveTimingDO.getSignType());\r\n        return signTimeDO;\r\n    }\r\n\r\n    /**\r\n     * ȡ������Ϣ\r\n     * @param groupDO\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static Long extractDistrictId(DeliveryPackageGroupDO groupDO, DeliveryPackageDO packageDO) {\r\n        Long divisionId = null;\r\n        if (groupDO != null\r\n            && groupDO.getDeliveryPackageGroupDTO() != null\r\n            && groupDO.getDeliveryPackageGroupDTO().getTransferObjectMap() != null\r\n            && groupDO.getDeliveryPackageGroupDTO().getTransferObjectMap().get(AdpInterfaceSource.DETAIL.getSource())\r\n            != null) {\r\n            // ������ӿ���˵������ֶη����˽ֵ�\r\n            divisionId = packageDO.getBuyerInfoDO().getBuyerInfoDTO().getBuyerAddressDTO().getDivisionCode();\r\n        } else {\r\n            // �Խ��׽ӿ���˵��DevisionCode�ֶ�Ϊ���أ�����õ�û��������Ϊ��(���綫ݸ)\r\n            // �������ȷ��ؽֵ�TownDivisionCode�ֶΣ���Χ���Խ����Ϸ�\r\n            BaseDeliverAddressDO addressDO = packageDO.getBuyerInfoDO().getBuyerInfoDTO().getBuyerAddressDTO()\r\n                .getBaseDeliverAddressDO();\r\n            if (addressDO != null) {\r\n                if (StringUtils.isNotBlank(addressDO.getTownDivisionCode()) && !\"0\".equals(addressDO.getTownDivisionCode())) {\r\n                    return Long.valueOf(addressDO.getTownDivisionCode());\r\n                } else if (StringUtils.isNotBlank(addressDO.getDevisionCode())) {\r\n                    divisionId = Long.valueOf(addressDO.getDevisionCode());\r\n                }\r\n            }\r\n        }\r\n        return divisionId;\r\n    }\r\n\r\n    /**\r\n     * �Ƿ���Ԥ��ʱЧ\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static boolean hasEstimateTime(DeliveryPackageDO packageDO) {\r\n        return packageDO != null && packageDO.getSignTimeDO() != null;\r\n    }\r\n\r\n    /**\r\n     * ��ȡԤ��ʱЧ����\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static String getEstimateTimeType(DeliveryPackageDO packageDO) {\r\n        if (EstimateTimeUtils.hasEstimateTime(packageDO)) {\r\n            return packageDO.getSignTimeDO().getBizCode();\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * �Ƿ���ƥ�����͵�ʱЧ\r\n     * @param deliveryPackageDO\r\n     * @param timingType\r\n     * @return\r\n     */\r\n    public static boolean matchDeliveryType(DeliveryPackageDO deliveryPackageDO, int timingType) {\r\n        if (timingType <= 0 || deliveryPackageDO == null || CollectionUtils.isEmpty(deliveryPackageDO.getDeliveryProtocolList())) {\r\n            return false;\r\n        }\r\n\r\n        for (DeliveryProtocolDO deliveryProtocolDO : deliveryPackageDO.getDeliveryProtocolList()) {\r\n            List<BaseTimingDO> baseTimingDOS = deliveryProtocolDO.getTimingDOs();\r\n            if (CollectionUtils.isNotEmpty(baseTimingDOS)) {\r\n                for (BaseTimingDO baseTimingDO : baseTimingDOS) {\r\n                    if (baseTimingDO != null && baseTimingDO.getTimingType() != null) {\r\n                        return timingType == baseTimingDO.getTimingType();\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n\r\n    /**\r\n     * ����������ʱЧת��\r\n     * @param signTimeDO\r\n     * @param protocolId\r\n     * @return\r\n     */\r\n    public static DeliveryTimingDO convertSignTime2DeliveryTimeDO(SignTimeDO signTimeDO, int timeType, long protocolId, TimingText timingText) {\r\n        if (signTimeDO == null) {\r\n            return null;\r\n        }\r\n        DeliveryTimingDO deliveryTimingDO = new DeliveryTimingDO();\r\n        deliveryTimingDO.setProtocolId(protocolId);\r\n        deliveryTimingDO.setShowTiming(true);\r\n        deliveryTimingDO.setWaveDate(signTimeDO.getWaveDateTime());\r\n        deliveryTimingDO.setCutOffTime(signTimeDO.getCutOffTime());\r\n        // ��ʱЧ ������������ʹ��������Դ�esTime��\r\n        deliveryTimingDO.setLimitDate(signTimeDO.getTiming() != null ? signTimeDO.getTiming() : Integer.valueOf(-1));\r\n        // ��·ʱЧ\r\n        deliveryTimingDO.setTiming(signTimeDO.getLineTiming());\r\n        deliveryTimingDO.setSignText(timingText.getSignText());\r\n        deliveryTimingDO.setPayTimeTips(timingText.getPayTimeTips());\r\n        deliveryTimingDO.setPromiseTips(timingText.getPromiseTips());\r\n        deliveryTimingDO.setMiniSignText(timingText.getMiniSignText());\r\n        deliveryTimingDO.setPredictiveProbability(signTimeDO.getProbability());\r\n        deliveryTimingDO.setTimingType(timeType);\r\n        deliveryTimingDO.setSignDate(signTimeDO.getArriveDateTime());\r\n        deliveryTimingDO.setShipType(signTimeDO.getShipType());\r\n        deliveryTimingDO.setSignType(signTimeDO.getSignType());\r\n\r\n        // ��ŵ��Ϣ\r\n        deliveryTimingDO.setPromiseItem(signTimeDO.getPromiseItem());\r\n        deliveryTimingDO.setSellType(signTimeDO.getSellType());\r\n        deliveryTimingDO.setTimingFeature(signTimeDO.getTimingFeature());\r\n\r\n\r\n        if (AdpNewLogisticBizConfig.openTimingRecord) {\r\n            if (org.apache.commons.lang3.StringUtils.isNotBlank(signTimeDO.getBizCode())) {\r\n                Map<String, Object> ext = deliveryTimingDO.getExt();\r\n                if (ext == null) {\r\n                    ext = new HashMap<>();\r\n                    deliveryTimingDO.setExt(ext);\r\n                }\r\n                ext.put(CommonConstant.CONTROL_SIGN_TYPE, signTimeDO.getBizCode());\r\n            }\r\n        }\r\n        return deliveryTimingDO;\r\n    }\r\n\r\n\r\n    /**\r\n     * ����ʱЧ����ڵ�ǰ���ڵı�ʾ 0����1����2���� ������n��\r\n     *\r\n     * @param daysFromCurDate\r\n     * @return\r\n     */\r\n    public static String calculateDayShow(Integer daysFromCurDate) {\r\n        String showDay;\r\n        switch (daysFromCurDate) {\r\n            case 0: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            case 1: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            case 2: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            default: {\r\n                showDay = daysFromCurDate + \"��\";\r\n                break;\r\n            }\r\n        }\r\n        return showDay;\r\n    }\r\n\r\n    /**\r\n     * ����ʱЧ����ڵ�ǰ���ڵı�ʾ 0����1����2���� ������n��\r\n     *\r\n     * @param daysFromCurDate\r\n     * @return\r\n     */\r\n    public static String calculateDisplayDay(Integer daysFromCurDate) {\r\n        String showDay = null;\r\n        switch (daysFromCurDate) {\r\n            case 0: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            case 1: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            default: {\r\n                break;\r\n            }\r\n        }\r\n        return showDay;\r\n    }\r\n\r\n    /**\r\n     * ����ʱЧ����ڵ�ǰ���ڵı�ʾ 0����1����2���� ������n��\r\n     *\r\n     * @param daysFromCurDate\r\n     * @return\r\n     */\r\n    public static String calculateDisplayDayNew(Integer daysFromCurDate) {\r\n        String showDay = null;\r\n        switch (daysFromCurDate) {\r\n            case 0: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            case 1: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            case 2: {\r\n                showDay = \"����\";\r\n                break;\r\n            }\r\n            default: {\r\n                break;\r\n            }\r\n        }\r\n        return showDay;\r\n    }\r\n\r\n\r\n    /**\r\n     *\r\n     *\r\n     * @param daysFromCurDate\r\n     * @return\r\n     */\r\n    public static String calculateDayShowDangciri(Integer daysFromCurDate) {\r\n        String showText = \"\";\r\n        switch (daysFromCurDate) {\r\n            case 0: {\r\n                showText = PredictiveLogisticBizConfig.todayArrive;\r\n                break;\r\n            }\r\n            case 1: {\r\n                showText = PredictiveLogisticBizConfig.oneDayArrive;\r\n                break;\r\n            }\r\n            case 2: {\r\n                showText = PredictiveLogisticBizConfig.twoDayArrive;\r\n                break;\r\n            }\r\n            default: {\r\n                showText = String.format(PredictiveLogisticBizConfig.nDayArrive, daysFromCurDate + \"\");\r\n                break;\r\n            }\r\n        }\r\n        return showText;\r\n    }\r\n\r\n    /**\r\n     * ����Ƿ���ָ��smc��\r\n     * @param deliveryPackageDO\r\n     */\r\n    public static boolean hasSubView(DeliveryPackageDO deliveryPackageDO, Long protocolId) {\r\n        if (deliveryPackageDO ==  null || protocolId == null) {\r\n            return false;\r\n        }\r\n        for (DeliveryCarrierDO carrierDO : deliveryPackageDO.getDeliveryCarrierList()) {\r\n            if (carrierDO.getDeliveryProtocolList() != null) {\r\n                for (DeliveryProtocolDO deliveryProtocolDO : carrierDO.getDeliveryProtocolList()) {\r\n                    if (deliveryProtocolDO.getProtocolDefinitionDO() != null) {\r\n                        return protocolId.equals(deliveryProtocolDO.getProtocolDefinitionDO().getProtocolId());\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n\r\n    /**\r\n     * ȥ��ָ��smc��\r\n     * @param deliveryPackageDO\r\n     */\r\n    public static boolean removeSubView(DeliveryPackageDO deliveryPackageDO, Long protocolId) {\r\n        if (deliveryPackageDO ==  null || protocolId == null) {\r\n            return false;\r\n        }\r\n        boolean removeSuccess = false;\r\n        for (DeliveryCarrierDO carrierDO : deliveryPackageDO.getDeliveryCarrierList()) {\r\n            if (carrierDO.getDeliveryProtocolList() != null) {\r\n                Iterator<DeliveryProtocolDO> iterator = carrierDO.getDeliveryProtocolList().iterator();\r\n                while (iterator.hasNext()) {\r\n                    DeliveryProtocolDO deliveryProtocolDO = iterator.next();\r\n                    if (deliveryProtocolDO.getProtocolDefinitionDO() != null\r\n                        && protocolId.equals(deliveryProtocolDO.getProtocolDefinitionDO().getProtocolId())) {\r\n                        removeSuccess = true;\r\n                        iterator.remove();\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return removeSuccess;\r\n    }\r\n\r\n    /**\r\n     * ��pkg����smc��\r\n     * @param deliveryPackageDO\r\n     */\r\n    public static void addSubViewToCarrier(DeliveryPackageDO deliveryPackageDO, Long protocolId) {\r\n        for (DeliveryCarrierDO carrierDO : deliveryPackageDO.getDeliveryCarrierList()) {\r\n            if (carrierDO.getDeliveryProtocolList() == null) {\r\n                carrierDO.setDeliveryProtocolList(new ArrayList<DeliveryProtocolDO>());\r\n            }\r\n\r\n            DeliveryProtocolDO predictSubViewProtocolDO = EstimateTimeUtils.createPredictSubViewProtocol(protocolId);\r\n            carrierDO.getDeliveryProtocolList().add(predictSubViewProtocolDO);\r\n        }\r\n    }\r\n\r\n    public static DeliveryProtocolDO createPredictSubViewProtocol(Long protocolId) {\r\n        ProtocolDefinitionDO protocolDefinitionDO = new ProtocolDefinitionDO();\r\n        RuleProtocolDO ruleProtocolDO = ProtocolRuleCache.getInstance().getProtocolById(protocolId);\r\n        protocolDefinitionDO.setProtocolIcon(ruleProtocolDO.getServiceIcon());\r\n        protocolDefinitionDO.setProtocolId(ruleProtocolDO.getProtocolId());\r\n        protocolDefinitionDO.setProtocolTips(ruleProtocolDO.getDesc());\r\n        protocolDefinitionDO.setProtocolUrl(ruleProtocolDO.getServiceUrl());\r\n        protocolDefinitionDO.setProtocolName(ruleProtocolDO.getName());\r\n        protocolDefinitionDO.setProtocolType(ruleProtocolDO.getType());\r\n\r\n        DeliveryProtocolDO deliveryProtocolDO = new DeliveryProtocolDO();\r\n        deliveryProtocolDO.setProtocolDefinitionDO(protocolDefinitionDO);\r\n        return deliveryProtocolDO;\r\n    }\r\n\r\n    /**\r\n     * ��ȡ��������\r\n     * @param protocolDO\r\n     * @return\r\n     */\r\n    public static Integer extractDeliveryTimingType(DeliveryProtocolDO protocolDO) {\r\n        if (protocolDO == null || CollectionUtils.isEmpty(protocolDO.getTimingDOs())) {\r\n            return null;\r\n        }\r\n\r\n        for (BaseTimingDO baseTimingDO : protocolDO.getTimingDOs()) {\r\n            if (baseTimingDO instanceof DeliveryTimingDO) {\r\n                return baseTimingDO.getTimingType();\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    /**\r\n     * ��ȡ������\r\n     * @param deliveryPackageDO\r\n     * @return\r\n     */\r\n    public static TimingOrderTags getTimingOrderTags(DeliveryPackageDO deliveryPackageDO) {\r\n        if (deliveryPackageDO == null || deliveryPackageDO.getDeliveryPackageDTO() == null) {\r\n            return null;\r\n        }\r\n\r\n        return deliveryPackageDO.getDeliveryPackageDTO().getTimingOrderTags();\r\n    }\r\n\r\n    /**\r\n     * ����ʱ���ʽΪM��D��\r\n     * @param date\r\n     * @return\r\n     */\r\n    public static String parseDateMD(Date date) {\r\n        if (date == null) {\r\n            return \"\";\r\n        }\r\n        try {\r\n            SimpleDateFormat display = DateFormatCacheUtils.getSimpleDateFormat(DATE_FMT2);\r\n            return display.format(date);\r\n        } catch (Exception e) {\r\n            // ignore\r\n        }\r\n        return \"\";\r\n    }\r\n\r\n    /**\r\n     * ��èԤ�Ƶ����İ���Ⱦ\r\n     * @param signTimeDO ����ʱЧ\r\n     * @return\r\n     */\r\n    public static TimingText parseTextMobileMall(SignTimeDO signTimeDO) {\r\n        if (signTimeDO == null) {\r\n            return TimingText.builder().signText(StringUtils.EMPTY)\r\n                .payTimeTips(StringUtils.EMPTY)\r\n                .promiseTips(StringUtils.EMPTY).build();\r\n        }\r\n\r\n        Date arriveDateTime = signTimeDO.getArriveDateTime();\r\n        Integer interval = signTimeDO.getTiming();\r\n\r\n        // ���ڸ��Ԥ�����죨06��11�գ��ʹ� - ���ڷ�Ϊ3�������� ���죨06��10�գ� ���죨06��11�գ� ���죨06��12�գ�\r\n        String text = PredictiveLogisticBizConfig.textMobileMallPrefix;\r\n        String miniText = null;\r\n        if (PredictiveLogisticBizConfig.textMobileMallNeedSuffix) {\r\n            String dateStr = parseDateMD(arriveDateTime);\r\n            // ���㵱�� ���� ����\r\n            String showDay = EstimateTimeUtils.calculateDayShow(interval);\r\n            String wholeDateStr = showDay + \"(\" + dateStr + \")\";\r\n            text = text + wholeDateStr + PredictiveLogisticBizConfig.textMobileMallSuffix;\r\n\r\n            String displayDay = EstimateTimeUtils.calculateDayShow(interval);\r\n            miniText = (displayDay == null ? dateStr : displayDay) + PredictiveLogisticBizConfig.textMobileMallSuffix;\r\n        }\r\n        return translateTimingText(text, miniText);\r\n    }\r\n\r\n    /**\r\n     * Ԥ�Ƶ����İ���Ⱦ\r\n     * @param signTimeDO ����ʱЧ\r\n     * @return\r\n     */\r\n    public static TimingText parseTextCommon(SignTimeDO signTimeDO, SignTextCondition signTextCondition) {\r\n        if (signTimeDO == null || !signTextCondition.isValid()) {\r\n            return TimingText.builder().signText(StringUtils.EMPTY)\r\n                .payTimeTips(StringUtils.EMPTY)\r\n                .promiseTips(StringUtils.EMPTY).build();\r\n        }\r\n\r\n        Integer cutOffMinutes = signTimeDO.getCutOffTime();\r\n        Date waveDateTime = signTimeDO.getWaveDateTime();\r\n        Date arriveDateTime = signTimeDO.getArriveDateTime();\r\n        Integer interval = signTimeDO.getTiming();\r\n\r\n        // e.g. ���շ��������մ18:00ǰ���Ԥ��3��23��(����)�ʹ�\r\n        String text = \"\";\r\n\r\n        // ���շ�����\r\n        if (StringUtils.isNotEmpty(signTextCondition.getConsignText())) {\r\n            text = signTextCondition.getConsignText();\r\n        }\r\n\r\n        // ���մ\r\n        if (interval >= 0 && interval <= signTextCondition.getDangCiRiPreMax()) {\r\n            text = text + calculateDayShowDangciri(interval);\r\n        }\r\n\r\n        // 18:00\r\n        if (signTextCondition.getNeedCutoffTime()) {\r\n            String hour = DateTimeUtils.minutes2HHmm(cutOffMinutes);\r\n            if (!DateTimeUtils.isToday(waveDateTime)) {\r\n                hour = EstimateTimeConst.TODAY_LATEST_PAY_TIME;\r\n            }\r\n            text = text + hour;\r\n        }\r\n\r\n        // ǰ���Ԥ��\r\n        text = text + signTextCondition.getText();\r\n\r\n        String dateStr = parseDateMD(arriveDateTime);\r\n        String showDay = calculateDisplayDay(interval);\r\n        text = assembleTextSuffix(text, dateStr, showDay, signTextCondition);\r\n        String miniText = (showDay == null ? dateStr : showDay) + signTextCondition.getTextSuffix();\r\n        return translateTimingText(text, miniText);\r\n    }\r\n\r\n    /**\r\n     * ��ŵ�����İ���Ⱦ\r\n     * @param signTimeDO ����ʱЧ\r\n     * @return\r\n     */\r\n    public static TimingText parsePromiseTextCommon(SignTimeDO signTimeDO, SignTextCondition signTextCondition) {\r\n        if (signTimeDO == null || !signTextCondition.isValid()) {\r\n            return TimingText.builder().signText(StringUtils.EMPTY)\r\n                .payTimeTips(StringUtils.EMPTY)\r\n                .promiseTips(StringUtils.EMPTY).build();\r\n        }\r\n\r\n        Integer cutOffMinutes = signTimeDO.getCutOffTime();\r\n        Date waveDateTime = signTimeDO.getWaveDateTime();\r\n        Date arriveDateTime = signTimeDO.getArriveDateTime();\r\n        Integer interval = signTimeDO.getTiming();\r\n\r\n        // e.g. ���շ��������մ18:00ǰ�����ŵ3��23��(����)�ʹ�\r\n        String text = \"\";\r\n\r\n        // ���շ�����\r\n        if (StringUtils.isNotEmpty(signTextCondition.getConsignText())) {\r\n            text = signTextCondition.getConsignText();\r\n        }\r\n\r\n        // ���մ\r\n        if (interval >= 0 && interval <= signTextCondition.getDangCiRiPreMax()) {\r\n            text = text + calculateDayShowDangciri(interval);\r\n        }\r\n\r\n        // 18:00\r\n        if (signTextCondition.getNeedCutoffTime()) {\r\n            String hour = DateTimeUtils.minutes2HHmm(cutOffMinutes);\r\n            if (!DateTimeUtils.isToday(waveDateTime)) {\r\n                hour = EstimateTimeConst.TODAY_LATEST_PAY_TIME;\r\n            }\r\n            text = text + hour;\r\n        }\r\n\r\n        //���عٷ�������ŵʱЧ\r\n        text = text + signTextCondition.getPromiseText();\r\n\r\n        String dateStr = parseDateMD(arriveDateTime);\r\n        String showDay = calculateDisplayDayNew(interval);\r\n        text = assembleTextSuffix(text, dateStr, showDay, signTextCondition);\r\n        String miniText = (showDay == null ? dateStr : showDay) + signTextCondition.getTextSuffix();\r\n        return translateTimingText(text, miniText);\r\n    }\r\n\r\n    /**\r\n     * Ԥ�Ƶ����İ���Ⱦ-���մ�\r\n     * @param signTimeDO ����ʱЧ\r\n     * @return\r\n     */\r\n    public static TimingText parseTextNextDay(SignTimeDO signTimeDO, SignTextCondition signTextCondition) {\r\n        if (signTimeDO == null || !signTextCondition.isValid()) {\r\n            return TimingText.builder().signText(StringUtils.EMPTY)\r\n                .payTimeTips(StringUtils.EMPTY)\r\n                .promiseTips(StringUtils.EMPTY).build();\r\n        }\r\n\r\n        Integer cutOffMinutes = signTimeDO.getCutOffTime();\r\n        Date waveDateTime = signTimeDO.getWaveDateTime();\r\n        Date arriveDateTime = signTimeDO.getArriveDateTime();\r\n        Integer interval = signTimeDO.getTiming();\r\n\r\n        // e.g. ���մ18:00ǰ����,���շ���,Ԥ��3��23��(����)�ʹ�\r\n        String text = \"\";\r\n\r\n        // ���մ\r\n        if (interval >= 0 && interval <= signTextCondition.getDangCiRiPreMax()) {\r\n            text = text + calculateDayShowDangciri(interval);\r\n        }\r\n\r\n        // 18:00\r\n        if (signTextCondition.getNeedCutoffTime()) {\r\n            String hour = DateTimeUtils.minutes2HHmm(cutOffMinutes);\r\n            if (!DateTimeUtils.isToday(waveDateTime)) {\r\n                hour = EstimateTimeConst.TODAY_LATEST_PAY_TIME;\r\n            }\r\n            text = text + hour;\r\n        }\r\n\r\n        // ǰ���\r\n        text = text + signTextCondition.getText1();\r\n        // ���շ�����\r\n        if (StringUtils.isNotEmpty(signTextCondition.getConsignText())) {\r\n            text = text + signTextCondition.getConsignText();\r\n        }\r\n        // Ԥ��\r\n        text = text + signTextCondition.getText2();\r\n        String dateStr = parseDateMD(arriveDateTime);\r\n        String showDay = calculateDisplayDay(interval);\r\n        text = assembleTextSuffix(text, dateStr, showDay, signTextCondition);\r\n        String miniText = (showDay == null ? dateStr : showDay) + signTextCondition.getTextSuffix();\r\n        return translateTimingText(text, miniText);\r\n    }\r\n\r\n    private static String assembleTextSuffix(String text, String dateStr, String showDay, SignTextCondition signTextCondition){\r\n        if (signTextCondition.getNeedSuffix()) {\r\n            // 3��23��\r\n            if (showDay == null) {\r\n                text = text + dateStr;\r\n            } else {\r\n                text = text + showDay;\r\n            }\r\n            // (����)\r\n            //            if (interval >= 0 && interval <= signTextCondition.getDangCiRiMidMax()) {\r\n            //                String showDay = EstimateTimeUtils.calculateDayShow(interval);\r\n            //                text = text + \"(\" + showDay + \")\";\r\n            //            }\r\n            // �ʹ�\r\n            text = text + signTextCondition.getTextSuffix();\r\n        }\r\n        return text;\r\n    }\r\n\r\n    /**\r\n     * ���մ�ҵ��������������İ�\r\n     * @param signTimeDO\r\n     * @param consignText\r\n     * @return\r\n     */\r\n    public static TimingText parseTextNextDayOnlyShip(SignTimeDO signTimeDO, String consignText) {\r\n        if (signTimeDO == null || StringUtils.isEmpty(consignText)) {\r\n            return TimingText.builder().signText(StringUtils.EMPTY)\r\n                .payTimeTips(StringUtils.EMPTY)\r\n                .promiseTips(StringUtils.EMPTY).build();\r\n        }\r\n\r\n        Integer cutOffMinutes = signTimeDO.getCutOffTime();\r\n        Date waveDateTime = signTimeDO.getWaveDateTime();\r\n\r\n        // e.g. 18:00ǰ����,���շ���\r\n        String text = \"\";\r\n\r\n        // 18:00\r\n        if (PredictiveLogisticBizConfig.tmallNextDayOnlyShipNeedCutoff) {\r\n            String hour = DateTimeUtils.minutes2HHmm(cutOffMinutes);\r\n            if (!DateTimeUtils.isToday(waveDateTime)) {\r\n                hour = EstimateTimeConst.TODAY_LATEST_PAY_TIME;\r\n            }\r\n            text = text + hour;\r\n        }\r\n\r\n        // ǰ���\r\n        text = text + PredictiveLogisticBizConfig.textTmallNextDayOnlyShipPre;\r\n\r\n        // ���շ���\r\n        text = text + consignText;\r\n\r\n        return translateTimingText(text, consignText);\r\n    }\r\n\r\n    private static TimingText translateTimingText(String signText, String miniText) {\r\n        if (StringUtils.isBlank(signText)) {\r\n            return TimingText.builder().build();\r\n        }\r\n        int index = signText.indexOf(\"��\");\r\n        if (index < 0) {\r\n            return TimingText.builder()\r\n                .signText(signText)\r\n                .promiseTips(signText)\r\n                .miniSignText(miniText)\r\n                .build();\r\n        }\r\n        return TimingText.builder()\r\n            .signText(signText)\r\n            .payTimeTips(signText.substring(0, index))\r\n            .promiseTips(signText.substring(index + 1))\r\n            .miniSignText(miniText)\r\n            .build();\r\n    }\r\n\r\n    /**\r\n     * �Ƿ�Ԥ��ʱЧ���γ���\r\n     * @param groupDO\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static boolean isEstimateShieldedTradeScene(DeliveryPackageGroupDO groupDO, DeliveryPackageDO packageDO) {\r\n        // Ԥ�۶�����\r\n        TradeStageDTO tradeStage = packageDO.getDeliveryPackageDTO().getTradeStage();\r\n        if (tradeStage != null\r\n            && TradeStageDTO.TradeModeConstants.PRE_SALE.equals(tradeStage.getTradeMode())\r\n            && TradeStageDTO.TradeStageConstants.BOOKING.equals(tradeStage.getTradeStage())) {\r\n            TrackUtil.putNoTimingReasonGeneral(packageDO.getOutId(), NoTimingReason.PRE_SELL_BOOKING_STAGE);\r\n            return true;\r\n        }\r\n\r\n        // �ۻ���δ����\r\n        if (groupDO != null\r\n            && groupDO.getDeliveryPackageGroupDTO() != null\r\n            && groupDO.getDeliveryPackageGroupDTO().getTransferObjectMap() != null\r\n            && groupDO.getDeliveryPackageGroupDTO().getTransferObjectMap().get(AdpInterfaceSource.DETAIL.getSource())\r\n            != null) {\r\n            DeliveryDetailInput deliveryDetailInput = (DeliveryDetailInput)groupDO.getDeliveryPackageGroupDTO()\r\n                .getTransferObjectMap().get(AdpInterfaceSource.DETAIL.getSource()).get(\"deliveryDetailInput\");\r\n            if (deliveryDetailInput != null && deliveryDetailInput.getJhsStartTime() != null) {\r\n                TrackUtil.putNoTimingReasonGeneral(packageDO.getOutId(), NoTimingReason.JUHUASUAN_NO_START);\r\n                return true;\r\n            }\r\n        }\r\n\r\n        // ����COD��������\r\n        if (PredictiveLogisticBizConfig.isEstimateTimeShieldCOD) {\r\n            for (DeliveryProtocolDO deliveryProtocolDO : packageDO.getDeliveryProtocolList()) {\r\n                if (deliveryProtocolDO != null\r\n                    && deliveryProtocolDO.getProtocolId() == AdpProtocol.DELIVERY_SERVICETYPE_CODBASE) {\r\n                    TrackUtil.putNoTimingReasonGeneral(packageDO.getOutId(), NoTimingReason.COD);\r\n                    return true;\r\n                }\r\n            }\r\n        }\r\n\r\n        // ������ѡ���\r\n        for (DeliveryCarrierDO carrierDO : packageDO.getDeliveryCarrierList()) {\r\n            if (carrierDO != null\r\n                && carrierDO.getDeliveryCarrierDTO() != null\r\n                && CollectionUtils.isNotEmpty(carrierDO.getDeliveryCarrierDTO().getItemTags())\r\n                && carrierDO.getDeliveryCarrierDTO().getItemTags().contains(ItemTags.PARTNERSELECTED.getTag())) {\r\n                TrackUtil.putNoTimingReasonGeneral(packageDO.getOutId(), NoTimingReason.PARTNER_SELECTED);\r\n                return true;\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n\r\n    /**\r\n     * �Ƿ�Ԥ�Ƶ���ʱЧ\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static boolean isEstimateTiming(DeliveryPackageDO packageDO) {\r\n        if (packageDO == null || CollectionUtils.isEmpty(packageDO.getDeliveryProtocolList())) {\r\n            return false;\r\n        }\r\n        for (DeliveryProtocolDO deliveryProtocolDO : packageDO.getDeliveryProtocolList()) {\r\n            if (CollectionUtils.isNotEmpty(deliveryProtocolDO.getTimingDOs())) {\r\n                BaseTimingDO baseTimingDO = deliveryProtocolDO.getTimingDOs().get(0);\r\n                return TimingType.isValidEstimateSignTime(baseTimingDO.getTimingType());\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n\r\n    /**\r\n     * ���servicetag\r\n     * @return\r\n     */\r\n    public static void removeServiceTag(DeliveryPackageDO packageDO) {\r\n        if (packageDO == null || packageDO.getConfirmDO() == null\r\n            || CollectionUtils.isEmpty(packageDO.getConfirmDO().getServiceTags())) {\r\n            return;\r\n        }\r\n        packageDO.getConfirmDO().setServiceTags(new ArrayList<AdpBuyOrderServiceTag>());\r\n    }\r\n\r\n    /**\r\n     * �Ƿ�����������Ʒ��\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static boolean matchShieldTag(DeliveryPackageDO packageDO) {\r\n        if (packageDO == null || CollectionUtils.isEmpty(packageDO.getDeliveryCarrierList())) {\r\n            return false;\r\n        }\r\n\r\n        List<DeliveryCarrierDO> deliveryCarrierList = packageDO.getDeliveryCarrierList();\r\n        for (DeliveryCarrierDO carrier : deliveryCarrierList) {\r\n            Set<Integer> itemTags = carrier.getDeliveryCarrierDTO().getItemTags();\r\n            if (itemMatchShieldTag(itemTags)) {\r\n                TrackUtil.putNoTimingReasonGeneral(packageDO.getOutId(), NoTimingReason.ITEM_SHIELD);\r\n                return true;\r\n            }\r\n        }\r\n\r\n        return false;\r\n    }\r\n\r\n\r\n    /**\r\n     * �Ƿ�����������Ʒ��\r\n     * @param packageDO\r\n     * @return\r\n     */\r\n    public static boolean matchDemoteEstimatedSignTimeBlackItemTags(DeliveryPackageDO packageDO) {\r\n        if (packageDO == null || CollectionUtils.isEmpty(packageDO.getDeliveryCarrierList())) {\r\n            return false;\r\n        }\r\n\r\n        List<DeliveryCarrierDO> deliveryCarrierList = packageDO.getDeliveryCarrierList();\r\n        for (DeliveryCarrierDO carrier : deliveryCarrierList) {\r\n            if (carrier != null && carrier.getDeliveryCarrierDTO() != null && CollectionUtil.isNotEmpty(carrier.getDeliveryCarrierDTO().getItemTags()) && CollectionUtils.containsAny(carrier.getDeliveryCarrierDTO().getItemTags(), AdpNewLogisticBizConfig.getDemoteEstimatedSignTimeBlackItemTags())) {\r\n                return true;\r\n            }\r\n        }\r\n\r\n        return false;\r\n    }\r\n\r\n    public static boolean itemMatchShieldTag(Set<Integer> itemTags) {\r\n        return CollectionUtil.isNotEmpty(itemTags) && CollectionUtils.containsAny(itemTags, PredictiveLogisticBizConfig.shieldItemTags);\r\n    }\r\n\r\n    public static List<String> buildItemSkuList(DeliveryPackageDO packageDO) {\r\n        if (packageDO == null || CollectionUtils.isEmpty(packageDO.getDeliveryCarrierList())) {\r\n            return Collections.emptyList();\r\n        }\r\n\r\n        List<String> itemSkuList = Lists.newArrayListWithExpectedSize(packageDO.getDeliveryCarrierList().size());\r\n        List<DeliveryCarrierDO> deliveryCarrierList = packageDO.getDeliveryCarrierList();\r\n        for (DeliveryCarrierDO carrier : deliveryCarrierList) {\r\n            if (StringUtils.isNotEmpty(carrier.getItemSkuId())) {\r\n                itemSkuList.add(carrier.getItemSkuId());\r\n            }\r\n        }\r\n        return itemSkuList;\r\n    }\r\n\r\n    public static List<String> buildRouteItemSkuList(TradeRouteInput input) {\r\n        if (input == null || CollectionUtils.isEmpty(input.getBuyOrderLines())) {\r\n            return Collections.emptyList();\r\n        }\r\n\r\n        List<String> itemSkuList = Lists.newArrayListWithExpectedSize(input.getBuyOrderLines().size());\r\n        for (BuyOrderLineTO buyOrderLineTO : input.getBuyOrderLines()) {\r\n            if (buyOrderLineTO.getItemTO() != null && buyOrderLineTO.getItemTO().getItemId() != null) {\r\n                Long skuId = buyOrderLineTO.getItemTO().getSkuId();\r\n                itemSkuList.add(buyOrderLineTO.getItemTO().getItemId() + \"_\" + (skuId == null ? 0 : skuId));\r\n            }\r\n        }\r\n        return itemSkuList;\r\n    }\r\n\r\n    /**\r\n     *\r\n     * @param shipTime ʱ��\r\n     * @param timeType 1 ���� 2 ���\r\n     * @return\r\n     */\r\n    public static String formatShipTime(String shipTime, Integer timeType) {\r\n        if (org.apache.commons.lang3.StringUtils.isBlank(shipTime) || timeType == null) {\r\n            return null;\r\n        }\r\n        return timeType+ \"_\" + shipTime;\r\n    }\r\n\r\n    /**\r\n     *\r\n     * @param shipType\r\n     * @return\r\n     */\r\n    public static String parseShipTimeFromShipType(String shipType) {\r\n        if (org.apache.commons.lang3.StringUtils.isBlank(shipType)) {\r\n            return null;\r\n        }\r\n        String shipTime = null;\r\n        if (ShipTimeType.SHIP_TODAY.getShipType().toString().equals(shipType)) {\r\n            //���շ�\r\n            final DateTime now = new DateTime();\r\n            final String date = now.toLocalDate().toString(DateTimeUtils.FORMAT_YEAR_MONTH_DAY_NO_ZONE);\r\n\r\n            shipTime = EstimateTimeUtils.formatShipTime(date, 1);\r\n        } else if (ShipTimeType.SHIP_24H.getShipType().toString().equals(shipType)) {\r\n            //24Сʱ��\r\n\r\n            shipTime = EstimateTimeUtils.formatShipTime(\"1\", 2);\r\n        }\r\n        return shipTime;\r\n    }\r\n\r\n    public static String parseShipTimeFromPredictiveTiming(PredictiveTimingDO predictiveTimingDO) {\r\n        if (predictiveTimingDO == null) {\r\n            return null;\r\n        }\r\n        String shipTime = null;\r\n        if (ShipTimeType.SHIP_TODAY.getShipType().equals(predictiveTimingDO.getShipType())) {\r\n            //���շ�\r\n            final DateTime now = new DateTime();\r\n            final String date = now.toLocalDate().toString(DateTimeUtils.FORMAT_YEAR_MONTH_DAY_NO_ZONE);\r\n\r\n            shipTime = EstimateTimeUtils.formatShipTime(date, 1);\r\n        } else if (ShipTimeType.SHIP_24H.getShipType().equals(predictiveTimingDO.getShipType())) {\r\n            //24Сʱ��\r\n\r\n            shipTime = EstimateTimeUtils.formatShipTime(\"1\", 2);\r\n        }\r\n        return shipTime;\r\n    }\r\n\r\n    public static PredictLogisticsSignTimeDO getPredictLogisticsSignTimeDO(DeliveryPackageDO packageDO) {\r\n        List<DeliveryProtocolDO> deliveryProtocolList = packageDO.getDeliveryProtocolList();\r\n        if (CollectionUtils.isEmpty(deliveryProtocolList)) {\r\n            return null;\r\n        }\r\n\r\n        for (DeliveryProtocolDO deliveryProtocolDO : deliveryProtocolList) {\r\n            if (deliveryProtocolDO == null) {\r\n                continue;\r\n            }\r\n            DeliveryTimingDO deliveryTimingDO = TimingUtil.getDeliveryTimingDO(deliveryProtocolDO.getTimingDOs());\r\n            if (deliveryTimingDO == null) {\r\n                continue;\r\n            }\r\n\r\n            TimingBizTypeEnum timingBizType = TimingBizTypeUtil.getTimingBizType(deliveryTimingDO);\r\n            if (timingBizType == null) {\r\n                continue;\r\n            }\r\n\r\n            if (AdpPlatformBizConfig.isSkipNullSignDateDeliveryTime()) {\r\n                if (deliveryTimingDO.getSignDate() == null) {\r\n                    return null;\r\n                }\r\n            }\r\n\r\n            PredictLogisticsSignTimeDO predictLogisticsPackageSignTimeDO = new PredictLogisticsSignTimeDO();\r\n            predictLogisticsPackageSignTimeDO.setEstimateTimeType(timingBizType.getBizType());\r\n            predictLogisticsPackageSignTimeDO.setSignDate(deliveryTimingDO.getSignDate() == null ? null : new DateTime(deliveryTimingDO.getSignDate()));\r\n            predictLogisticsPackageSignTimeDO.setWaveDate(deliveryTimingDO.getWaveDate() == null ? null : new DateTime(deliveryTimingDO.getWaveDate()));\r\n            predictLogisticsPackageSignTimeDO.setCutoffMinutes(deliveryTimingDO.getCutOffTime());\r\n            PromiseType promiseType = deliveryTimingDO.getPromiseType();\r\n            if (PromiseType.ESTIMATE.equals(promiseType)) {\r\n                predictLogisticsPackageSignTimeDO.setPromise(false);\r\n            } else if (PromiseType.PROMISE.equals(promiseType)) {\r\n                predictLogisticsPackageSignTimeDO.setPromise(true);\r\n            }\r\n            // ��䵽��ʱЧ����\r\n            if (org.apache.commons.lang3.StringUtils.isNotBlank(deliveryTimingDO.getSignType())) {\r\n                predictLogisticsPackageSignTimeDO.setSignType(SignTypeEnum.getByCode(deliveryTimingDO.getSignType()));\r\n            }\r\n\r\n            // ��ŵ��ת��\r\n            predictLogisticsPackageSignTimeDO.setPromiseItem(PlatformSPiInvokeUtil.convertDeliveryPromiseItem2PlatformPromiseItem(deliveryTimingDO.getPromiseItem()));\r\n            if (org.apache.commons.lang3.StringUtils.isNotBlank(deliveryTimingDO.getSellType())) {\r\n                try {\r\n                    predictLogisticsPackageSignTimeDO.setSellType(SellTypeEnum.getSellTypeEnum(deliveryTimingDO.getSellType()));\r\n                } catch (Exception e) {\r\n\r\n                }\r\n            }\r\n            Map<String, String> timingFeature = new HashMap<>();\r\n            if (MapUtils.isNotEmpty(deliveryTimingDO.getTimingFeature())) {\r\n                timingFeature.putAll(deliveryTimingDO.getTimingFeature());\r\n            }\r\n            predictLogisticsPackageSignTimeDO.setTimingFeature(timingFeature);\r\n\r\n            return predictLogisticsPackageSignTimeDO;\r\n        }\r\n\r\n        return null;\r\n    }\r\n\r\n    public static PredictLogisticsSignTimeDO getPredictLogisticsCarrierSignTimeDO(\r\n        PredictLogisticsSignTimeDO predictLogisticsPackageSignTimeDO) {\r\n        if (predictLogisticsPackageSignTimeDO == null) {\r\n            return null;\r\n        }\r\n        PredictLogisticsSignTimeDO predictLogisticsCarrierSignTimeDO = new PredictLogisticsSignTimeDO();\r\n        predictLogisticsCarrierSignTimeDO.setEstimateTimeType(predictLogisticsPackageSignTimeDO.getEstimateTimeType());\r\n        predictLogisticsCarrierSignTimeDO.setSignDate(predictLogisticsPackageSignTimeDO.getSignDate());\r\n        predictLogisticsCarrierSignTimeDO.setWaveDate(predictLogisticsPackageSignTimeDO.getWaveDate());\r\n        predictLogisticsCarrierSignTimeDO.setCutoffHour(predictLogisticsPackageSignTimeDO.getCutoffHour());\r\n        predictLogisticsCarrierSignTimeDO.setCutoffMinutes(predictLogisticsPackageSignTimeDO.getCutoffMinutes());\r\n        predictLogisticsCarrierSignTimeDO.setPromise(predictLogisticsPackageSignTimeDO.isPromise());\r\n        predictLogisticsCarrierSignTimeDO.setSignType(predictLogisticsPackageSignTimeDO.getSignType());\r\n        // ��ŵ��ת��\r\n        predictLogisticsCarrierSignTimeDO.setPromiseItem(predictLogisticsPackageSignTimeDO.getPromiseItem());\r\n        predictLogisticsCarrierSignTimeDO.setSellType(predictLogisticsPackageSignTimeDO.getSellType());\r\n        predictLogisticsCarrierSignTimeDO.setTimingFeature(predictLogisticsPackageSignTimeDO.getTimingFeature());\r\n        return predictLogisticsCarrierSignTimeDO;\r\n    }\r\n\r\n    public static SignTimeDO convertSignTimeByPredictLogisticsSignTimeDO(PredictLogisticsSignTimeDO predictLogisticsSignTimeDO,\r\n        String bizCode, boolean isOnlyMobile) {\r\n        SignTimeDO signTimeDO = new SignTimeDO();\r\n        if (predictLogisticsSignTimeDO.getWaveDate() != null) {\r\n            signTimeDO.setWaveDateTime(predictLogisticsSignTimeDO.getWaveDate().toDate());\r\n        }\r\n        signTimeDO.setCutOffTime(predictLogisticsSignTimeDO.getCutoffMinutes());\r\n        signTimeDO.setLineTiming(predictLogisticsSignTimeDO.getLineTiming());\r\n        signTimeDO.setTiming(predictLogisticsSignTimeDO.getTiming());\r\n        signTimeDO.setProbability(predictLogisticsSignTimeDO.getProbability());\r\n        if (predictLogisticsSignTimeDO.getSignDate() != null) {\r\n            signTimeDO.setArriveDateTime(predictLogisticsSignTimeDO.getSignDate().toDate());\r\n        }\r\n        signTimeDO.setLineFrom(predictLogisticsSignTimeDO.getLineFrom());\r\n        signTimeDO.setBizCode(bizCode);\r\n        signTimeDO.setOriginMobile(isOnlyMobile);\r\n        signTimeDO.setShipType(predictLogisticsSignTimeDO.getShipType());\r\n        signTimeDO.setOnlyShipTime(predictLogisticsSignTimeDO.getOnlyShipTime());\r\n\r\n        // ��ŵ��ת��\r\n        Map<String, String> timingFeature = new HashMap<>();\r\n        if (MapUtils.isNotEmpty(predictLogisticsSignTimeDO.getTimingFeature())) {\r\n            timingFeature.putAll(predictLogisticsSignTimeDO.getTimingFeature());\r\n        }\r\n        signTimeDO.setTimingFeature(timingFeature);\r\n\r\n        signTimeDO.setPromiseItem(convertPlatformPromiseItem(predictLogisticsSignTimeDO.getPromiseItem()));\r\n        if (predictLogisticsSignTimeDO.getSellType() != null) {\r\n            signTimeDO.setSellType(predictLogisticsSignTimeDO.getSellType().getType());\r\n        }\r\n        SignTypeEnum signTypeEnum = predictLogisticsSignTimeDO.getSignType();\r\n        if (signTypeEnum != null) {\r\n            signTimeDO.setSignType(signTypeEnum.getCode());\r\n            // ��ʱ����signTypeEnumת���ϵ�timingType\r\n            TimingTypeSignTypeMappingEnum mappingEnum = TimingTypeSignTypeMappingEnum.getEnumBySignTypeEnum(signTypeEnum);\r\n            if (mappingEnum != null) {\r\n                signTimeDO.setTimingType(mappingEnum.getTimingType());\r\n            }\r\n        }\r\n        return signTimeDO;\r\n    }\r\n\r\n    private static PromiseItem convertPlatformPromiseItem(com.alibaba.ascp.promise.common.time.base.PromiseItem promiseItem) {\r\n        if (promiseItem == null) {\r\n            return null;\r\n        }\r\n        PromiseItem adpPromiseItem = new PromiseItem();\r\n        adpPromiseItem.setCode(promiseItem.getCode());\r\n        adpPromiseItem.setMarketCode(promiseItem.getMarketCode());\r\n        adpPromiseItem.setActiveCompensationType(promiseItem.getActiveCompensationType());\r\n        adpPromiseItem.setPassiveCompensationType(promiseItem.getPassiveCompensationType());\r\n        adpPromiseItem.setPromiseOwner(promiseItem.getPromiseOwner());\r\n        if (promiseItem.getPromiseStandard() != null) {\r\n            adpPromiseItem.setPromiseStandard(PromiseStandardEnum.getByCode(promiseItem.getPromiseStandard()));\r\n        }\r\n        adpPromiseItem.setPromiseMode(promiseItem.getPromiseMode());\r\n        if (promiseItem.getPromiseMarketChannel() != null) {\r\n            adpPromiseItem.setPromiseMarketChannel(PromiseMarketChannelEnum.getPromiseItemCodeEnum(promiseItem.getPromiseMarketChannel()));\r\n        }\r\n        return adpPromiseItem;\r\n    }\r\n\r\n    public static String decideTimingIcon(DeliveryTimingDO deliveryTimingDO) {\r\n        if (deliveryTimingDO == null) {\r\n            return null;\r\n        }\r\n        String timingIconUrl = null;\r\n        Integer integer = deliveryTimingDO.getLimitDate();\r\n        switch (integer) {\r\n            case 0 : {\r\n                timingIconUrl = PredictiveLogisticBizConfig.todayIcon;\r\n                break;\r\n            }\r\n            case 1 : {\r\n                timingIconUrl = PredictiveLogisticBizConfig.oneDayIcon;\r\n                break;\r\n            }\r\n            case 2 : {\r\n                timingIconUrl = PredictiveLogisticBizConfig.twoDayIcon;\r\n                break;\r\n            }\r\n            default: {\r\n                break;\r\n            }\r\n        }\r\n\r\n        return timingIconUrl;\r\n    }\r\n}"}],"isError":false,"timestamp":1779967148667}}
