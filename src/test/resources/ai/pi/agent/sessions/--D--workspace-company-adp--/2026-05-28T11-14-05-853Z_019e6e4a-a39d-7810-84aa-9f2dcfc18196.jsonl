{"type":"message","id":"de2f3a6f","parentId":"adbc5021","timestamp":"2026-05-28T11:18:37.512Z","message":{"role":"toolResult","toolCallId":"call_ca644608b9ca425bb5912501","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.adapter.adpplus.utils;\r\n\r\nimport java.util.HashMap;\r\nimport java.util.List;\r\nimport java.util.Map;\r\nimport java.util.concurrent.TimeUnit;\r\n\r\nimport com.alibaba.delivery.logistics.entity.core.constant.ShipTypeEnum;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.PlusShipTimeResultTO;\r\nimport com.alibaba.delivery.logistics.entity.params.targets.DeliveryCarrierDTO;\r\nimport com.alibaba.logistics.service.clients.model.aggregate.LogisticsServiceInfoDTO;\r\nimport com.alibaba.logistics.service.clients.model.result.LogisticsPromiseOrderResultDTO;\r\nimport com.alibaba.logistics.service.clients.model.result.LogisticsPromiseSaleOrderGroupItemResultDTO;\r\nimport com.alibaba.logistics.service.clients.model.result.LogisticsPromiseSaleOrderGroupResultDTO;\r\nimport com.alibaba.logistics.service.clients.model.result.shiptime.ShipTimeServiceDTO;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.collections4.MapUtils;\r\nimport org.slf4j.Logger;\r\nimport org.slf4j.LoggerFactory;\r\n\r\n/**\r\n * adp-plus 发货时效解析工具类\r\n * \r\n * 从 adp-plus 决策结果中提取平均发货时效数据，供 ability/confirm/detail 链路复用\r\n *\r\n * @author xianmu\r\n * @date 2026/01/01\r\n */\r\npublic class AdpPlusShipTimeParser {\r\n\r\n    private static final Logger LOG = LoggerFactory.getLogger(AdpPlusShipTimeParser.class);\r\n\r\n    /**\r\n     * 扩展信息中PLUS发货时效结果Map的key\r\n     */\r\n    public static final String PLUS_SHIP_TIME_RESULT_MAP = \"plusShipTimeResultMap\";\r\n\r\n    /**\r\n     * 从 adp-plus 决策结果中解析平均发货时效\r\n     * \r\n     * @param promiseOrderResults adp-plus 返回的订单承诺结果列表\r\n     * @return Map<订单ID/商品ID, PLUS发货时效结果>，如果没有平均发货时效则返回空Map\r\n     */\r\n    public static Map<String, PlusShipTimeResultTO> parsePlusShipTimeResult(List<LogisticsPromiseOrderResultDTO> promiseOrderResults) {\r\n        Map<String, PlusShipTimeResultTO> resultMap = new HashMap<>();\r\n\r\n        if (CollectionUtils.isEmpty(promiseOrderResults)) {\r\n            return resultMap;\r\n        }\r\n\r\n        for (LogisticsPromiseOrderResultDTO orderResult : promiseOrderResults) {\r\n            if (orderResult == null || CollectionUtils.isEmpty(orderResult.getSaleOrderGroupResults())) {\r\n                continue;\r\n            }\r\n            for (LogisticsPromiseSaleOrderGroupResultDTO saleOrderGroup : orderResult.getSaleOrderGroupResults()) {\r\n                if (saleOrderGroup == null) {\r\n                    continue;\r\n                }\r\n                // 从订单组级别的logisticsServiceInfo中提取\r\n                extractAndPutAverageShipTime(saleOrderGroup.getLogisticsServiceInfo(), null, null, resultMap);\r\n                \r\n                // 从商品级别的logisticsServiceInfo中提取（包含itemId和skuId）\r\n                if (CollectionUtils.isNotEmpty(saleOrderGroup.getSaleOrderGroupItemResults())) {\r\n                    for (LogisticsPromiseSaleOrderGroupItemResultDTO itemResult : saleOrderGroup.getSaleOrderGroupItemResults()) {\r\n                        if (itemResult == null) {\r\n                            continue;\r\n                        }\r\n                        extractAndPutAverageShipTime(itemResult.getLogisticsServiceInfo(), \r\n                            itemResult.getItemId(), itemResult.getSkuId(), resultMap);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        return resultMap;\r\n    }\r\n\r\n    /**\r\n     * 从物流服务信息中提取平均发货时效，并放入结果映射中\r\n     *\r\n     * @param serviceInfo 物流服务信息\r\n     * @param itemId 商品ID（可为null）\r\n     * @param skuId SKU ID（可为null）\r\n     * @param resultMap 结果映射\r\n     */\r\n    private static void extractAndPutAverageShipTime(LogisticsServiceInfoDTO serviceInfo, Long itemId, Long skuId,\r\n                                                      Map<String, PlusShipTimeResultTO> resultMap) {\r\n        if (serviceInfo == null || CollectionUtils.isEmpty(serviceInfo.getShipTimeServices())) {\r\n            return;\r\n        }\r\n        \r\n        for (ShipTimeServiceDTO shipTimeService : serviceInfo.getShipTimeServices()) {\r\n            if (shipTimeService == null || !ShipTypeEnum.PREDICT_SHIP_TIMING.getType().equals(shipTimeService.getServiceCode())) {\r\n                continue;\r\n            }\r\n            if (shipTimeService.getTimeInfo() == null || shipTimeService.getTimeInfo().getOffset() == null) {\r\n                continue;\r\n            }\r\n            \r\n            Integer offsetHours = convertOffsetToHours(shipTimeService.getTimeInfo().getOffset(), \r\n                shipTimeService.getTimeInfo().getUnit());\r\n            if (offsetHours == null) {\r\n                continue;\r\n            }\r\n            \r\n            PlusShipTimeResultTO result = new PlusShipTimeResultTO();\r\n            result.setAverageShipTimeHour(offsetHours);\r\n            result.setExt(shipTimeService.getFeature());\r\n\r\n            // 使用itemId_skuId作为key（itemId或skuId为null时也会生成如 \"null_123\" 的key）\r\n            String key = itemId + \"_\" + skuId;\r\n            resultMap.put(key, result);\r\n            break;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * 将时间偏移量转换为小时数\r\n     *\r\n     * @param offset 偏移量\r\n     * @param unit 时间单位（HOUR/DAY等）\r\n     * @return 小时数\r\n     */\r\n    private static Integer convertOffsetToHours(Integer offset, TimeUnit unit) {\r\n        if (offset == null) {\r\n            return null;\r\n        }\r\n        \r\n        // 如果单位为null或者是小时，直接返回\r\n        if (unit == null || unit == TimeUnit.HOURS) {\r\n            return offset;\r\n        } \r\n        // 如果是天，转换为小时\r\n        else if (unit == TimeUnit.DAYS) {\r\n            return offset * 24;\r\n        }\r\n        \r\n        // 默认按小时处理\r\n        return offset;\r\n    }\r\n\r\n\r\n    /**\r\n     * 通用方法：从扩展信息中提取PLUS平均发货时效结果并设置到carrier\r\n     *\r\n     * @param extMap 扩展信息map\r\n     * @param carrier 承运物DTO\r\n     */\r\n    public static void extractAndSetPlusShipTimeResult(Map<String, Object> extMap, DeliveryCarrierDTO carrier) {\r\n        try {\r\n            if (MapUtils.isEmpty(extMap)) {\r\n                return;\r\n            }\r\n\r\n            Map<String, PlusShipTimeResultTO> plusShipTimeResultMap =\r\n                (Map<String, PlusShipTimeResultTO>) extMap.get(AdpPlusShipTimeParser.PLUS_SHIP_TIME_RESULT_MAP);\r\n\r\n            if (MapUtils.isEmpty(plusShipTimeResultMap)) {\r\n                return;\r\n            }\r\n\r\n            String plusShipTimeKey = carrier.getItemId() + \"_\" + carrier.getSkuId();\r\n            PlusShipTimeResultTO plusShipTimeResultTO = plusShipTimeResultMap.get(plusShipTimeKey);\r\n            if (plusShipTimeResultTO != null) {\r\n                carrier.setPlusShipTimeResultTO(plusShipTimeResultTO);\r\n            }\r\n        } catch (Exception e) {\r\n            LOG.error(\"extractAndSetPlusShipTimeResult error, extMap={}, carrier={}\", extMap, carrier, e);\r\n        }\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779967117512}}
