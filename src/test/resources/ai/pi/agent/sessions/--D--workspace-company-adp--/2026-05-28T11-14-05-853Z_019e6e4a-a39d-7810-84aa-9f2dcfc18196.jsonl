c boolean needCal(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, ClientChannelDTO clientChannelDTO, AdpOption adpOption) {\r\n        if (deliveryPackageDO == null || deliveryCarrierDO == null) {\r\n            return false;\r\n        }\r\n        return Optional.of(deliveryCarrierDO)\r\n                .map(DeliveryCarrierDO::getDeliveryCarrierDTO)\r\n                .map(DeliveryCarrierDTO::getShipTimeDTOFromSdp)\r\n                .map(shipTimeDTO -> ShipTypeEnum.FC_SELLER_STORE_SHIP_TIME.getType().equals(shipTimeDTO.getShipType()))\r\n                .orElse(false);\r\n    }\r\n\r\n    @Override\r\n    public ShipTimeDO doCal(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, ClientChannelDTO clientChannelDTO, AdpOption adpOption) {\r\n        final ShipTimeDTO shipTimeDTOFromSdp = deliveryCarrierDO.getDeliveryCarrierDTO().getShipTimeDTOFromSdp();\r\n\r\n        ShipTimeDO shipTimeDO = new ShipTimeDO();\r\n        shipTimeDO.setShipType(ShipTypeEnum.FC_SELLER_STORE_SHIP_TIME);\r\n        shipTimeDO.setFeature(shipTimeDTOFromSdp.getFeature());\r\n        shipTimeDO.setShipTimeCutOffMinutes(shipTimeDTOFromSdp.getShipTimeCutOffMinutes());\r\n        shipTimeDO.setShipTime(shipTimeDTOFromSdp.getShipTime());\r\n\r\n        return shipTimeDO;\r\n    }\r\n}\r\n\n---END---\n\n=== adp-logistics/adp-logistics-biz/src/main/java/com/alibaba/delivery/logistics/ability/shiptime/calculator/impl/C2mSellerShipTimingForwardCalculator.java ===\npackage com.alibaba.delivery.logistics.ability.shiptime.calculator.impl;\r\n\r\nimport java.util.Map;\r\n\r\nimport javax.annotation.Resource;\r\n\r\nimport com.alibaba.ascp.promise.defender.core.trace.diagnosis.DiagnosisFacade;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.calculator.IShipTimingForwardCalculator;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.service.springfestival.SpringFestivalShipTimeRuleService;\r\nimport com.alibaba.delivery.logistics.common.uti