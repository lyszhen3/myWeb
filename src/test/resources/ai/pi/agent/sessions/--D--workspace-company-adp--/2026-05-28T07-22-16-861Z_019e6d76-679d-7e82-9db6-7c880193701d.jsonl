Bean, ActionInput actionInput, ActionOutput actionOutput) {\r\n        actionSave(actionBean.getClass().getName(), actionInput, actionOutput);\r\n    }\r\n\r\n    public void actionSave(Class<?> actionClass, ActionInput actionInput, ActionOutput actionOutput) {\r\n        actionSave(actionClass.getName(), actionInput, actionOutput);\r\n    }\r\n\r\n    public void actionSave(String actionKey, ActionInput actionInput, ActionOutput actionOutput) {\r\n        actionRepository.putIfAbsent(actionKey, new ArrayList<>());\r\n        actionRepository.get(actionKey).add(Pair.of(actionInput, actionOutput));\r\n    }\r\n\r\n    public List<Pair<ActionInput, ActionOutput>> actionQuery(Class<?> actionClass) {\r\n        return actionRepository.get(actionClass.getName());\r\n    }\r\n\r\n    public List<Pair<ActionInput, ActionOutput>> actionQuery(String actionKey) {\r\n        return actionRepository.get(actionKey);\r\n    }\r\n\r\n    public Pair<ActionInput, ActionOutput> actionUniqueQuery(Class<?> actionClass) {\r\n        return actionUniqueQuery(actionClass.getName());\r\n    }\r\n\r\n    public <T> T actionUniqueQueryOutput(Class<?> actionClass, Class<T> outputType) {\r\n        return Optional.ofNullable(actionUniqueQuery(actionClass.getName()))\r\n            .map(Pair::getRight)\r\n            .filter(outputType::isInstance)\r\n            .map(outputType::cast)\r\n            .orElse(null);\r\n    }\r\n\r\n    public Pair<ActionInput, ActionOutput> actionUniqueQuery(String actionKey) {\r\n        List<Pair<ActionInput, ActionOutput>> dataList = actionQuery(actionKey);\r\n        if (CollectionUtils.isNotEmpty(dataList) && dataList.size() == 1) {\r\n            return dataList.get(0);\r\n        }\r\n        throw new AdpServiceException(AdpServiceErrorCode.SERVERERROR,\r\n                \"�����Ψһ\",\r\n                \"ProcessContext\");\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779953117731}}
