{"type":"message","id":"26182135","parentId":"e1c862e1","timestamp":"2026-05-28T07:34:14.417Z","message":{"role":"toolResult","toolCallId":"call_f1300f458e8245e8a3decd6d","toolName":"read","content":[{"type":"text","text":"package com.alibaba.adp.fee.biz.calculate.promotion.impl;\r\n\r\nimport com.alibaba.adp.fee.basic.address.FeeAddressWrapper;\r\nimport com.alibaba.adp.fee.biz.calculate.promotion.model.PostFreePromotion;\r\nimport com.alibaba.adp.fee.biz.calculate.promotion.model.PostFreeRequest;\r\nimport com.alibaba.adp.fee.biz.calculate.promotion.model.PostFreeResponse;\r\nimport com.alibaba.adp.fee.biz.calculate.promotion.repo.PostFreeCheckerRepo;\r\nimport com.alibaba.adp.fee.common.model.postfee.req.PostFeeItem;\r\nimport com.alibaba.adp.fee.common.model.postfee.req.PostFeeItemBizOption;\r\nimport com.alibaba.adp.fee.common.model.postfee.req.PostFeePackage;\r\nimport com.alibaba.ascp.promise.defender.common.track.UserDataTracker;\r\nimport com.alibaba.delivery.common.cache.RemoteCache;\r\nimport com.alibaba.delivery.common.constant.AdpProtocol;\r\nimport com.alibaba.delivery.common.constant.CarrierPostFreeType;\r\nimport com.alibaba.delivery.common.constant.ItemTags;\r\nimport com.alibaba.delivery.common.diamond.AdpLogisticBizConfig;\r\nimport com.alibaba.delivery.common.diamond.AdpPerformRefineConfig;\r\nimport com.alibaba.delivery.logistics.entity.params.targets.DeliveryCarrierDTO;\r\nimport com.alibaba.delivery.promotion.dataobject.PromotionPostageDO;\r\nimport com.alibaba.delivery.promotion.dto.PromotionPostageParam;\r\nimport com.alibaba.delivery.promotion.dto.PromotionPostageResult;\r\nimport com.alibaba.delivery.promotion.service.PromotionPostageService;\r\nimport com.alibaba.delivery.rule.diamond.AdpPromotionConfig;\r\nimport com.alibaba.delivery.template.constant.AdpConstant;\r\nimport com.alibaba.delivery.template.dto.DeliveryTemplateDTO;\r\nimport com.alibaba.delivery.track.UserDataTrackConstant;\r\nimport com.google.common.collect.Sets;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.lang3.StringUtils;\r\n\r\nimport javax.annotation.Resource;\r\nimport java.util.Collections;\r\nimport java.util.HashSet;\r\nimport java.util.List;\r\nimport java.util.Map;\r\nimport java.util.Objects;\r\nimport java.util.Optional;\r\nimport java.util.Set;\r\n\r\n/**\r\n * ��ٰ��ʼ����\r\n *\r\n * @author ī�� lee.jl@alibaba-inc.com\r\n * @version 1.0\r\n * @since 2023/09/26\r\n */\r\npublic class PromotionPostFreeChecker extends BasePostFreeChecker {\r\n\r\n    private static final String ADP_PROMOTION_CHECKER = \"ADP_PROMOTION_CHECKER\";\r\n\r\n    private static final Set<Long> cityRetailSkipPromotionFree = Collections.unmodifiableSet(Sets.newHashSet(\r\n        AdpProtocol.DELIVERY_SERVICE_TYPE_CITY_RETAIL,\r\n        AdpProtocol.DELIVERY_SERVICE_TYPE_CITY_RETAIL_ONE_HOUR\r\n    ));\r\n\r\n    private static final Set<Long> jsdSkipPromotionFree = Collections.unmodifiableSet(Sets.newHashSet(\r\n        AdpProtocol.DELIVERY_SERVICETYPE_MENDIAN_JSD\r\n    ));\r\n\r\n    @Resource\r\n    private PromotionPostageService promotionPostageService;\r\n\r\n    @Resource\r\n    private FeeAddressWrapper feeAddressWrapper;\r\n\r\n    @Override\r\n    public int priority() {\r\n        return PostFreeCheckerRepo.POST_FREE_CHECKER_PRIORITY_PROMOTION;\r\n    }\r\n\r\n    @Override\r\n    public PostFreeResponse checkPostFree(PostFreeRequest checkRequest) {\r\n\r\n        if (Objects.isNull(checkRequest)\r\n            || Objects.isNull(checkRequest.getFeeItem())\r\n            || Objects.isNull(checkRequest.getFeePackage())) {\r\n            return null;\r\n        }\r\n\r\n        PromotionPostageParam promotionPostageParam = assemblePromotionParam(checkRequest);\r\n\r\n        Optional.ofNullable(checkRequest.getTemplate())\r\n            .map(DeliveryTemplateDTO::getTemplateFees)\r\n            .map(Map::keySet)\r\n            .orElseGet(Collections::emptySet);\r\n\r\n        PostFeeItem feeItem = checkRequest.getFeeItem();\r\n        PostFeePackage feePackage = checkRequest.getFeePackage();\r\n        if (Objects.isNull(feeItem) || Objects.isNull(feePackage)) {\r\n            return null;\r\n        }\r\n        String userType = feeItem.getExt(DeliveryCarrierDTO.ExtendFieldKey.UserType.name());\r\n        Set<Integer> itemTags = Optional.ofNullable(feeItem.getItemTags())\r\n            .orElseGet(Collections::emptySet);\r\n\r\n        // ��ѯ�Ż�\r\n        PromotionPostageResult<List<PromotionPostageDO>> result;\r\n        String localScene = null;\r\n        if (UserDataTracker.getUserData() != null) {\r\n            localScene = (String)UserDataTracker.getUserData().get(UserDataTrackConstant.USER_DATA_SCENE);\r\n        }\r\n        if (StringUtils.isNotEmpty(localScene)\r\n            && AdpPerformRefineConfig.openFeeCalculatorPromotionFilterRefine\r\n            && AdpPerformRefineConfig.feeCalculatorPromotionFilterRefineWhiteSets.contains(localScene)) {\r\n            String threadCacheKey = ADP_PROMOTION_CHECKER + feeItem.getItemId();\r\n            result = RemoteCache.instance().get(PromotionPostageResult.class, threadCacheKey);\r\n            if (result == null) {\r\n                result = promotionPostageService.findPostagePromotion(promotionPostageParam);\r\n                if (result == null) {\r\n                    result = new PromotionPostageResult<>();\r\n                    result.setIsSuccess(false);\r\n                }\r\n                RemoteCache.instance().put(PromotionPostageResult.class, threadCacheKey, result);\r\n            }\r\n        } else {\r\n            result = promotionPostageService.findPostagePromotion(promotionPostageParam);\r\n        }\r\n\r\n        // ��ٰ��ʽ������\r\n        Set<Long> promotionLogisTypeFilterSet = Sets.newHashSet();\r\n        Set<Long> promotionDbIdSet = Sets.newHashSet();\r\n        Set<Long> promotionActivityIdSet = Sets.newHashSet();\r\n        Optional.ofNullable(result)\r\n            .filter(PromotionPostageResult::isSuccess)\r\n            .map(PromotionPostageResult::getResult)\r\n            .orElseGet(Collections::emptyList)\r\n            .forEach(promotionPostageDO -> {\r\n                promotionDbIdSet.add(promotionPostageDO.getId());\r\n                promotionActivityIdSet.add(promotionPostageDO.getPromotionId());\r\n                promotionLogisTypeFilterSet.addAll(\r\n                    AdpConstant.USER_TYPE_TMALL.equals(userType)\r\n                        ? promotionPostageDO.getTmallPostList()\r\n                        : promotionPostageDO.getTaobaoPostList());\r\n            });\r\n        if (CollectionUtils.isEmpty(promotionLogisTypeFilterSet)) {\r\n            // �ް��ʻ\r\n            return null;\r\n        }\r\n        PostFreeResponse response = new PostFreeResponse();\r\n        response.setItemPostFree(true);\r\n        response.setPostFreeReason(CarrierPostFreeType.promoFree);\r\n        response.setLogisTypeWhiteSet(promotionLogisTypeFilterSet);\r\n        response.setLogisTypeBlackSet(new HashSet<>());\r\n        if (cityRetailSkipPromotionFree(itemTags)) {\r\n            response.getLogisTypeBlackSet().addAll(cityRetailSkipPromotionFree);\r\n        }\r\n        if (itemTags.contains(ItemTags.TSD_POST_NOTFREE.getTag())) {\r\n            response.getLogisTypeBlackSet().addAll(jsdSkipPromotionFree);\r\n        }\r\n        PostFreePromotion postFreePromotion = new PostFreePromotion();\r\n        postFreePromotion.setPromotionIdSet(promotionDbIdSet);\r\n        postFreePromotion.setPromotionActivityIdSet(promotionActivityIdSet);\r\n        response.setPostFreePromotion(postFreePromotion);\r\n\r\n        return response;\r\n    }\r\n\r\n    private PromotionPostageParam assemblePromotionParam(PostFreeRequest checkRequest) {\r\n\r\n        PostFeeItem feeItem = checkRequest.getFeeItem();\r\n        PostFeePackage feePackage = checkRequest.getFeePackage();\r\n        Set<Integer> itemTags = Optional.ofNullable(feeItem.getItemTags())\r\n            .orElseGet(Collections::emptySet);\r\n        PostFeeItemBizOption itemBizOption = feeItem.bizOption();\r\n\r\n        Long sellerId = feePackage.sellerId();\r\n\r\n        PromotionPostageParam promotionPostageParam = new PromotionPostageParam();\r\n\r\n        // ��ٰ������������ʼ����������Ϣ\r\n        promotionPostageParam.setSellerId(sellerId);\r\n        promotionPostageParam.setCategoryId(feeItem.getCategoryId());\r\n        promotionPostageParam.setItemFeatures(feeItem.getItemFeature());\r\n        promotionPostageParam.setItemTags(feeItem.getItemTags());\r\n        promotionPostageParam.setPayTime(feePackage.getPayTime());\r\n\r\n        // ��ٰ������������ʼ������ַ\r\n        Long areaId = checkRequest.getAreaId();\r\n        boolean overseaAddress = feeAddressWrapper.isOverseaAddress(areaId);\r\n        if (AdpPromotionConfig.openOverseaAreaTransfer && overseaAddress) {\r\n            //����Ǻ����ַ���ҿ��ش򿪣���ַת��Ϊͨ�õĺ����ַ\r\n            promotionPostageParam.setAreaId(AdpConstant.AREA_STRID_OVERSEA);\r\n        } else {\r\n            promotionPostageParam.setAreaId(areaId);\r\n        }\r\n\r\n        // ��ٰ������������ʼ�����Ƿ���Դ�ٰ���\r\n        if (AdpPromotionConfig.ignorePromotionSellers.contains(sellerId)) {\r\n            // �̼Ұ��������Դ�ٰ���\r\n            promotionPostageParam.setIgnore(true);\r\n        } else if (AdpPromotionConfig.isOpenIgnorePromotionItemTagSets\r\n            && CollectionUtils.containsAny(itemTags, AdpPromotionConfig.getIgnorePromotionItemTagSets())) {\r\n            // ��Ʒ����Դ�ٰ���\r\n            promotionPostageParam.setIgnore(true);\r\n        } else {\r\n            // ����������Դ�ٰ���\r\n            promotionPostageParam.setIgnore(itemBizOption.isIgnorePromotionPostFree());\r\n        }\r\n\r\n        return promotionPostageParam;\r\n    }\r\n\r\n    private boolean cityRetailSkipPromotionFree(Set<Integer> itemTags) {\r\n        // ���������ʵ���Ʒ��\r\n        return AdpLogisticBizConfig.cityRetai