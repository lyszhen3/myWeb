] {sceneCode(), processCode()}, null);\r\n        } else {\r\n            throw new AdpServiceException(AdpServiceErrorCode.SERVERERROR,\r\n                    \"�����ظ�ע�᣺\" + processCode(),\r\n                    \"BaseProcess\");\r\n        }\r\n    }\r\n\r\n    @Override\r\n    public I assembleProcessInput(Req req) {\r\n        try {\r\n            I processInput = inputType().newInstance();\r\n            processInput.setRequest(req);\r\n            processInput.setIdentityContext(AdpSceneSession.getSession().getIdentityContext());\r\n            processInput.setInvokeInfo(AdpSceneSession.getSession().getInvokeInfo());\r\n            return processInput;\r\n        } catch (Throwable e) {\r\n            throw new AdpServiceException(AdpServiceErrorCode.SERVERERROR,\r\n                    e,\r\n                    \"BaseProcess\");\r\n        }\r\n    }\r\n\r\n    @Override\r\n    public O execute(I input) {\r\n        C processContext = null;\r\n        try {\r\n            // 1. ��װ������\r\n            processContext = assembleProcessContext(input);\r\n\r\n            // 2. ִ��ǰ�ص�\r\n            onProcessStart(processContext);\r\n\r\n            // 3. ִ������\r\n            executeProcess(processContext);\r\n\r\n            // 4. ִ�гɹ��ص�\r\n            onProcessSuccess(processContext);\r\n\r\n        } catch (Throwable exception) {\r\n            // ִ���쳣�ص�\r\n            onProcessException(exception, processContext);\r\n        } finally {\r\n            // ִ�н����ص�\r\n            onProcessFinish(processContext);\r\n        }\r\n\r\n        return Objects.nonNull(processContext) ? processContext.getProcessOutput() : null;\r\n    }\r\n\r\n    /**\r\n     * ��װ����������\r\n     *\r\n     * @param input ��������\r\n     * @return ����������\r\n     */\r\n    protected C assembleProcessContext(I input) {\r\n        try {\r\n            C processContext = contextType().newInstance();\r\n            processContext.setProcessInput(input);\r\n            return processContext;\r\n        } catch (Throwable e) {\r\n            throw new AdpServiceException(AdpServiceErrorCode.SERVERERROR,\r\n                    e,\r\n                    \"BaseProcess\");\r\n        }\r\n    }\r\n\r\n    /**\r\n     * ����ִ��ǰ�ص�\r\n     *\r\n     * @param processContext ����������\r\n     */\r\n    public void onProcessStart(C processContext) {\r\n\r\n    }\r\n\r\n    /**\r\n     * ִ������\r\n     *\r\n     * @param processContext ����������\r\n     */\r\n    public void executeProcess(C processContext) {\r\n        if (CollectionUtils.isNotEmpty(processActionList)) {\r\n            for (ProcessAction<Req, Res, I, O, C> processAction : processActionList) {\r\n                processAction.executeProcessAction(processContext);\r\n            }\r\n        } else {\r\n            throw new AdpServiceException(AdpServiceErrorCode.SERVERERROR,\r\n                    \"����δ��ʼ���ڵ�\",\r\n                    \"BaseProcess\");\r\n        }\r\n    }\r\n\r\n    /**\r\n     * ����ִ�гɹ��ص�\r\n     *\r\n     * @param processContext ����������\r\n     */\r\n    public void onProcessSuccess(C processContext) {\r\n\r\n    }\r\n\r\n    /**\r\n     * ����ִ���쳣�ص�\r\n     *\r\n     * @param exception      �쳣\r\n     * @param processContext ����������\r\n     */\r\n    public void onProcessException(Throwable exception, C processContext) {\r\n        if (exception instanceof AdpServiceException) {\r\n            throw (AdpServiceException)exception;\r\n        } else {\r\n            throw new AdpServiceException(AdpServiceErrorCode.SERVERERROR,\r\n                    exception,\r\n                    \"BaseProcess\");\r\n        }\r\n    }\r\n\r\n    /**\r\n     * ����ִ�н����ص�����finally�д�����\r\n     *\r\n     * @param processContext ����������\r\n     */\r\n    public void onProcessFinish(C processContext) {\r\n\r\n    }\r\n\r\n    protected Class<I> inputType() {\r\n        return AdpClassUtils.getArgumentType(this.getClass(), 2);\r\n    }\r\n\r\n    protected Class<O> outputType() {\r\n        return AdpClassUtils.getArgumentType(this.getClass(), 3);\r\n    }\r\n\r\n    protected Class<C> contextType() {\r\n        return AdpClassUtils.getArgumentType(this.getClass(), 4);\r\n    }\r\n\r\n    public void setProcessActionList(List<ProcessAction<Req, Res, I, O, C>> processActionList) {\r\n        this.processActionList = processActionList;\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779953133533}}
