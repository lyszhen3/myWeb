th.max(COUNTER_THREAD_LOCAL.get() - 1, 0));\r\n        if (COUNTER_THREAD_LOCAL.get() <= 0) {\r\n            if (null != sessionThreadLocal.get()) {\r\n                sessionThreadLocal.set(null);\r\n            }\r\n        }\r\n    }\r\n\r\n    /**\r\n     * ���÷���Ϣ\r\n     */\r\n    private AdpInvokeInfo invokeInfo;\r\n\r\n    /**\r\n     * ��������\r\n     */\r\n    private String sceneCode;\r\n\r\n    /**\r\n     * ҵ�����̱���\r\n     */\r\n    private String processCode;\r\n\r\n    /**\r\n     * ����������\r\n     */\r\n    private IdentityContext identityContext;\r\n\r\n    /**\r\n     * session����������\r\n     */\r\n    private final Map<String, Object> contextMap = new HashMap<>();\r\n\r\n    public AdpInvokeInfo getInvokeInfo() {\r\n        return invokeInfo;\r\n    }\r\n\r\n    public void setInvokeInfo(AdpInvokeInfo invokeInfo) {\r\n        this.invokeInfo = invokeInfo;\r\n    }\r\n\r\n    public AdpInterfaceSource getInterfaceSource() {\r\n        return Optional.ofNullable(invokeInfo)\r\n            .map(AdpInvokeInfo::getInterfaceSource)\r\n            .orElse(AdpInterfaceSource.UNKNOWN);\r\n    }\r\n\r\n    public String getSceneCode() {\r\n        return sceneCode;\r\n    }\r\n\r\n    public void setSceneCode(String sceneCode) {\r\n        this.sceneCode = sceneCode;\r\n    }\r\n\r\n    public String getProcessCode() {\r\n        return processCode;\r\n    }\r\n\r\n    public void setProcessCode(String processCode) {\r\n        this.processCode = processCode;\r\n    }\r\n\r\n    public IdentityContext getIdentityContext() {\r\n        return identityContext;\r\n    }\r\n\r\n    public void setIdentityContext(IdentityContext identityContext) {\r\n        this.identityContext = identityContext;\r\n    }\r\n\r\n    public void putAttribute(String name, Object value) {\r\n        contextMap.put(name, value);\r\n    }\r\n\r\n    public Object getAttribute(String name) {\r\n        return contextMap.get(name);\r\n    }\r\n\r\n    public String getAttributeStr(String name) {\r\n        return Optional.ofNullable(contextMap.get(name))\r\n            .map(String::valueOf)\r\n            .orElse(null);\r\n    }\r\n\r\n    public <T> T getAttribute(String name, Class<T> klass) {\r\n        Object obj = contextMap.get(name);\r\n        if (Objects.isNull(obj)) {\r\n            return null;\r\n        }\r\n        if (klass.isInstance(obj)) {\r\n            return klass.cast(obj);\r\n        }\r\n        throw new AdpServiceException(\r\n            AdpServiceErrorCode.SERVERERROR,\r\n                \"���������ʹ���key=\" + name + \",expect=\" + klass.getName(),\r\n                \"AdpSceneSession\");\r\n    }\r\n\r\n    public void removeAttribute(String name) {\r\n        contextMap.remove(name);\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779953139282}}
