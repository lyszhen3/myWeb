{"type":"message","id":"8f0c8320","parentId":"eb4fa04b","timestamp":"2026-05-28T07:25:39.282Z","message":{"role":"toolResult","toolCallId":"call_559613bdcc2c427babd46a5b","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.framework.template;\r\n\r\nimport com.alibaba.ascp.promise.defender.core.log.facade.LogApiFacade;\r\nimport com.alibaba.delivery.common.base.AdpInvokeInfo;\r\nimport com.alibaba.delivery.common.cache.RemoteCache;\r\nimport com.alibaba.delivery.common.code.AdpServiceErrorCode;\r\nimport com.alibaba.delivery.common.constant.AdpInterfaceSource;\r\nimport com.alibaba.delivery.common.entity.exception.AdpServiceException;\r\nimport com.alibaba.delivery.common.entity.result.AdpResult;\r\nimport com.alibaba.delivery.framework.entity.model.IdentityContext;\r\nimport com.alibaba.delivery.framework.flow.process.Process;\r\nimport com.alibaba.delivery.framework.flow.process.ProcessInput;\r\nimport com.alibaba.delivery.framework.flow.process.ProcessOutput;\r\nimport com.alibaba.delivery.framework.flow.repo.ProcessEngine;\r\nimport com.alibaba.delivery.record.SlsLogisticsRecordPersistentV2;\r\nimport com.alibaba.delivery.utils.AdpCommonLogV2StrUtil;\r\nimport org.slf4j.Logger;\r\nimport org.slf4j.LoggerFactory;\r\n\r\nimport java.util.Objects;\r\nimport java.util.Optional;\r\n\r\n/**\r\n * ҵ�����ģ�巽��\r\n *\r\n * @author ī�� lee.jl@alibaba-inc.com\r\n * @version 1.0\r\n * @since 2023/08/15\r\n */\r\npublic class AdpSceneTemplate {\r\n\r\n    private static final Logger DEFAULT_LOGGER = LoggerFactory.getLogger(AdpSceneTemplate.class);\r\n\r\n    /**\r\n     * ����ģ�巽��ִ��ҵ�����\r\n     *\r\n     * @param callback     ҵ�����ص�������\r\n     * @param logger       ��־������\r\n     * @param invokeMethod ����ӿ�\r\n     * @param <Req>        �����������\r\n     * @param <Res>        ����������\r\n     * @return ҵ������ʹ��{@link AdpResult}��װ\r\n     */\r\n    public static <Req, Res, I extends ProcessInput<Req>, O extends ProcessOutput<Res>>\r\n    AdpResult<Res> execute(Req request, AdpInvokeInfo invokeInfo, AdpSceneCallback<Res> callback, Logger logger,\r\n                           String invokeMethod) {\r\n        AdpResult<Res> result = null;\r\n        Throwable error = null;\r\n        I processInput = null;\r\n        O processOutput = null;\r\n        long startTime = System.currentTimeMillis();\r\n        logger = Optional.ofNullable(logger).orElse(DEFAULT_LOGGER);\r\n        try {\r\n\r\n            // 1. Session��ʼ��\r\n            AdpSceneSession session = AdpSceneSession.createSession();\r\n            session.setInvokeInfo(invokeInfo);\r\n            String sceneCode = callback.sceneCode();\r\n            session.setSceneCode(callback.sceneCode());\r\n\r\n            // 2. ִ��ǰ�ص�\r\n            callback.onStart();\r\n\r\n            // 3. ����·��\r\n            IdentityContext identityContext = callback.routeIdentity();\r\n\r\n            // 4. ����·��\r\n            Process<Req, Res, I, O> process = ProcessEngine.route(sceneCode, identityContext);\r\n            if (Objects.isNull(process)) {\r\n                throw new AdpServiceException(AdpServiceErrorCode.ADP_FEE_CALCULATE_EXECUTE_ERROR,\r\n                        \"����·��Ϊ��\",\r\n                        \"AdpSceneTemplate\");\r\n            }\r\n            session.setProcessCode(process.processCode());\r\n\r\n            // 5. ������������\r\n            processInput = process.assembleProcessInput(request);\r\n            if (Objects.isNull(processInput)) {\r\n                throw new AdpServiceException(AdpServiceErrorCode.ADP_FEE_CALCULATE_EXECUTE_ERROR,\r\n                        \"�������빹��Ϊ��\",\r\n                        \"AdpSceneTemplate\");\r\n            }\r\n\r\n            // 6. ִ��ҵ������\r\n            processOutput = process.execute(processInput);\r\n            if (Objects.isNull(processOutput)) {\r\n                throw new AdpServiceException(AdpServiceErrorCode.ADP_FEE_CALCULATE_EXECUTE_ERROR,\r\n                        \"����ִ�н��Ϊ��\",\r\n                        \"AdpSceneTemplate\");\r\n            }\r\n\r\n            // 7. ��װ���\r\n            result = processOutput.getBizResult();\r\n\r\n        } catch (AdpServiceException adpException) {\r\n\r\n            // ҵ���쳣������AdpServiceException\r\n            error = adpException;\r\n            result = callback.onException(adpException);\r\n\r\n            // ��¼ҵ���쳣\r\n            String logStr = AdpCommonLogV2StrUtil.buildCompareLogStr(AdpInterfaceSource.FEE_V2_CAL.getInterfaceName(),\r\n                \"fee.calculate.v2.compare\", \"templateAdpException\");\r\n            String exceptionStr = AdpCommonLogV2StrUtil.buildDifference(\"fee.calculate.v2.templateAdpException\", adpException.getMessage());\r\n            SlsLogisticsRecordPersistentV2.LOG.save(logStr + exceptionStr);\r\n\r\n        } catch (Throwable unknownException) {\r\n\r\n            // δ֪�쳣������Throwable\r\n            error = unknownException;\r\n            result = callback.onException(unknownException);\r\n\r\n            // ��¼δ֪�쳣\r\n            String logStr = AdpCommonLogV2StrUtil.buildCompareLogStr(AdpInterfaceSource.FEE_V2_CAL.getInterfaceName(),\r\n                \"fee.calculate.v2.compare\", \"templateThrowableException\");\r\n            String exceptionStr = AdpCommonLogV2StrUtil.buildDifference(\"fee.calculate.v2.templateThrowableException\", unknownException.getMessage());\r\n            SlsLogisticsRecordPersistentV2.LOG.save(logStr + exceptionStr);\r\n\r\n        } finally {\r\n\r\n            // 8. ��ӡ��־\r\n            String rt = (System.currentTimeMillis() - startTime) + \"ms\";\r\n            if (Objects.nonNull(error)) {\r\n                LogApiFacade.errorForBusiness(logger, invokeMethod,\r\n                    \"exception\", new Object[] {rt, processInput}, processOutput, error);\r\n            } else {\r\n                boolean success = Optional.ofNullable(result).map(AdpResult::isSuccess).orElse(false);\r\n                if (!success) {\r\n                    LogApiFacade.errorForBusiness(logger, invokeMethod, \"failed\", new Object[] {rt, processInput}, processOutput);\r\n                }\r\n            }\r\n\r\n            // 9. ִ�н����ص�\r\n            callback.onFinish(result);\r\n\r\n            // 10. �Ự����\r\n            AdpSceneSession.destroySession();\r\n\r\n            // 11. ����̻߳��棬���������ʱ�̻߳���init��clear�ɶԳ��֣�ͨ����ջ�����Զ��ж��Ƿ��ͷţ���������Ʋ�����Ĭ�ϳ�ʼ��\r\n            // ������������������������ѭ�µı�ɷ�ʽ������������˷�ģ������̶�����ȥ��������\r\n            if (Objects.isNull(invokeInfo) || !invokeInfo.fromAdpInternal()) {\r\n                RemoteCache.instance().clear();\r\n            }\r\n        }\r\n\r\n        // ���ؽ��\r\n        return result;\r\n    }\r\n\r\n}\r\n"}],"isError":false,"timestamp":1779953139282}}
