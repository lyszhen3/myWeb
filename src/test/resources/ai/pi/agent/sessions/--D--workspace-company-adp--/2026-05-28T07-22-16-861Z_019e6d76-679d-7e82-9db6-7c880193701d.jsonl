t);\r\n        }\r\n        return newSelects;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.core.option.MendianOptionDO transMendian(MendianOptionDO oldMd) {\r\n        if (oldMd == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.core.option.MendianOptionDO newMd\r\n            = new com.alibaba.delivery.platform.common.model.core.option.MendianOptionDO();\r\n        newMd.setStoreName(oldMd.getStoreName());\r\n        newMd.setStoreCode(oldMd.getStoreCode());\r\n        newMd.setAttributes(oldMd.getAttributes());\r\n        return newMd;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.core.fee.FeeDO transFee(FeeDO oldFee) {\r\n        if (oldFee == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.core.fee.FeeDO newFee\r\n            = new com.alibaba.delivery.platform.common.model.core.fee.FeeDO();\r\n        newFee.setPrice(oldFee.getPrice());\r\n        newFee.setPriceUnit(oldFee.getPriceUnit());\r\n        newFee.setExtendFee(oldFee.getExtendFee());\r\n        newFee.setHasExtendsFee(oldFee.isHasExtendsFee());\r\n        newFee.setPromotionIdList(oldFee.getPromotionIdList());\r\n        return newFee;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.params.option.BizOptionDTO transBizOption(BizOptionDTO oldBiz) {\r\n        if (oldBiz == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.params.option.BizOptionDTO newBiz\r\n            = new com.alibaba.delivery.platform.common.model.params.option.BizOptionDTO();\r\n        newBiz.setConsoDirect(oldBiz.isConsoDirect());\r\n        newBiz.setConsoDirectSelectType(oldBiz.getConsoDirectSelectType());\r\n        newBiz.setIgnoreCalcuAreaLimt(oldBiz.isIgnoreCalcuAreaLimt());\r\n        newBiz.setIgnorePromotion(oldBiz.isIgnorePromotion());\r\n        newBiz.setSelectCOD(oldBiz.isSelectCOD());\r\n        return newBiz;\r\n    }\r\n\r\n}\r\n"}],"isError":false,"timestamp":1779953489910}}
{"type":"message","id":"36b37021","parentId":"746cdf28","timestamp":"2026-05-28T07:31:29.911Z","message":{"role":"toolResult","toolCallId":"call_c6b73170609145f2a462c725","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.client.service.converter;\r\n\r\nimport com.ali.com.google.common.collect.Lists;\r\nimport com.alibaba.delivery.client.service.lgs.model.LgsFeeIndependentSwitchDTO;\r\nimport com.alibaba.delivery.common.code.AdpServiceErrorCode;\r\nimport com.alibaba.delivery.common.diamond.fee.PfPostFeeConfig;\r\nimport com.alibaba.delivery.logistics.entity.core.option.UserChooseLogisticsInfo;\r\nimport com.alibaba.delivery.platform.common.util.KeyUtil;\r\nimport com.alibaba.delivery.servicetype.posttype.core.PfPostTypeEnum;\r\nimport com.alibaba.delivery.servicetype.posttype.core.PfPostTypeGroupEnum;\r\nimport com.alibaba.fastjson.JSON;\r\nimport com.google.common.collect.Maps;\r\nimport com.taobao.delivery.common.constant.ServiceErrorCode;\r\nimport com.taobao.delivery.common.dataobject.trade.*;\r\nimport com.taobao.delivery.common.dataobject.trade.conso.BaseStdConsoSegment;\r\nimport com.taobao.delivery.common.dataobject.trade.conso.result.StdConsoItemConfirmResult;\r\nimport com.taobao.delivery.common.dataobject.trade.conso.result.StdConsoOrderConfirmResult;\r\nimport com.taobao.delivery.common.dataobject.trade.conso.result.StdConsoSegmentShippingDetail;\r\nimport com.taobao.delivery.common.dataobject.trade.conso.result.StdConsoShippingDetail;\r\nimport com.taobao.delivery.common.transfer.FeeDesc;\r\nimport com.taobao.delivery.common.transfer.ShippingDetail;\r\nimport com.wdk.infrastructure.foundation.lang.LangUtils;\r\nimport com.wdk.infrastructure.foundation.lang.ListUtils;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.collections4.MapUtils;\r\nimport org.apache.commons.lang3.StringUtils;\r\nimport org.glassfish.jersey.internal.guava.Sets;\r\nimport org.jetbrains.annotations.NotNull;\r\n\r\nimport java.util.*;\r\nimport java.util.Map.Entry;\r\nimport java.util.function.Function;\r\nimport java.util.function.Predicate;\r\nimport java.util.stream.Collectors;\r\n\r\n/**\r\n * @author zhaixiaoshuang\r\n */\r\n\r\npublic class PfDeliveryTradeMergeConverter {\r\n\r\n    // todo: refactor @���� У��ͷǷ�����\r\n    // todo: refactor @���� �����Щ����߼�����ʱЧ����ô��? ��������ĵ��˳����Ż�;\r\n    public AbilityResultTOGroup assembleAbilityGroup(AbilityResultTOGroup feeResult, AbilityResultTOGroup timingResult, LgsFeeIndependentSwitchDTO lgsFeeIndependentSwitchDTO) {\r\n        if (Objects.isNull(lgsFeeIndependentSwitchDTO) || CollectionUtils.isEmpty(lgsFeeIndependentSwitchDTO.getSwitchPostTypes())) {\r\n            return timingResult;\r\n        }\r\n        if (Objects.isNull(feeResult)) {\r\n            return timingResult;\r\n        }\r\n        if (Objects.isNull(timingResult)) {\r\n            return feeResult;\r\n        }\r\n\r\n        AbilityResultTOGroup result = new AbilityResultTOGroup();\r\n\r\n        result.setAbilityResultTOs(this.assembleAbilityResults(feeResult.getAbilityResultTOs(), timingResult.getAbilityResultTOs(), lgsFeeIndependentSwitchDTO.getSwitchPostTypes()));\r\n        //���� ability result, ���⼸�������˷ѵ�\r\n        result.setPromotionFindDTO(feeResult.getPromotionFindDTO());\r\n        result.setTaoBaoConsoDriectFeeResult(feeResult.getTaoBaoConsoDriectFeeResult());\r\n        result.setMapInfoS(feeResult.getMapInfoS());\r\n\r\n        return result;\r\n    }\r\n\r\n    // todo: refactor @���� У��ͷǷ�����\r\n    public ConfirmResultTOGroup assembleConfirmGroup(ConfirmResultTOGroup timingResult, ConfirmResultTOGroup feeResult, LgsFeeIndependentSwitchDTO lgsFeeIndependentSwitchDTO) {\r\n        if (Objects.isNull(lgsFeeIndependentSwitchDTO) || CollectionUtils.isEmpty(lgsFeeIndependentSwitchDTO.getSwitchPostTypes())) {\r\n            return timingResult;\r\n        }\r\n        if (Objects.isNull(timingResult)) {\r\n            return feeResult;\r\n        }\r\n        if (Objects.isNull(feeResult)) {\r\n            return timingResult;\r\n        }\r\n        ConfirmResultTOGroup result = new ConfirmResultTOGroup();\r\n\r\n        result.setConfirmResultTOs(this.assembleConfirmResults(feeResult.getConfirmResultTOs(), timingResult.getConfirmResultTOs(), lgsFeeIndependentSwitchDTO.getSwitchPostTypes()));\r\n\r\n        // todo: refactor @���� ������û�취���ˣ�list ����û������\r\n        result.setStdConsoConfirmResultList(this.converterStdConsoConfirmResult(feeResult.getStdConsoConfirmResultList(), timingResult.getStdConsoConfirmResultList()));\r\n\r\n        //�˷ѵ�\r\n        result.setTaoBaoConsoDriectFeeResult(feeResult.getTaoBaoConsoDriectFeeResult());\r\n        result.setPromotionUsingDTO(feeResult.getPromotionUsingDTO());\r\n        result.setMapInfos(feeResult.getMapInfos());\r\n\r\n        //ʱЧ�꣬�Ƿ���������\r\n        if (feeResult.isBlockTrade()) {\r\n            result.setBlockTrade(feeResult.isBlockTrade());\r\n            result.setBlockCode(feeResult.getBlockCode());\r\n            result.setBlockMsg(feeResult.getBlockMsg());\r\n            result.setBlockErrorType(feeResult.getBlockErrorType());\r\n            result.setBlockErrorSource(feeResult.getBlockErrorSource());\r\n            result.setBlockErrorLocation(feeResult.getBlockErrorLocation());\r\n            return result;\r\n        }\r\n\r\n        if (timingResult.isBlockTrade()) {\r\n            result.setBlockTrade(timingResult.isBlockTrade());\r\n            result.setBlockCode(timingResult.getBlockCode());\r\n            result.setBlockMsg(timingResult.getBlockMsg());\r\n            result.setBlockErrorType(timingResult.getBlockErrorType());\r\n            result.setBlockErrorSource(timingResult.getBlockErrorSource());\r\n            result.setBlockErrorLocation(timingResult.getBlockErrorLocation());\r\n        }\r\n        return result;\r\n    }\r\n\r\n    private List<StdConsoOrderConfirmResult> converterStdConsoConfirmResult(List<StdConsoOrderConfirmResult> feeStdConsoConfirmResultList, List<StdConsoOrderConfirmResult> timingStdConsoConfirmResultList) {\r\n        if (CollectionUtils.isEmpty(timingStdConsoConfirmResultList)) {\r\n            return feeStdConsoConfirmResultList;\r\n        }\r\n        if (CollectionUtils.isEmpty(feeStdConsoConfirmResultList)) {\r\n            return Lists.newArrayList();\r\n        }\r\n\r\n        Map<String, StdConsoOrderConfirmResult> timingStdMap = timingStdConsoConfirmResultList.stream()\r\n            .collect(Collectors.toMap(std -> std.getRelationList().get(0).getRealOutOrderId(), Function.identity(), (a, b) -> a));\r\n\r\n        return feeStdConsoConfirmResultList.stream().map(feeStd -> {\r\n            String orderRelationKey = feeStd.getRelationList().get(0).getRealOutOrderId();\r\n            StdConsoOrderConfirmResult timingResult = timingStdMap.get(orderRelationKey);\r\n\r\n            StdConsoOrderConfirmResult mergeResult = new StdConsoOrderConfirmResult();\r\n            mergeResult.setRelationList(feeStd.getRelationList());\r\n\r\n            HashMap<String, String> mergeAttributes = Maps.newHashMap();\r\n            mergeAttributes.putAll(feeStd.getAttributes());\r\n            Optional.ofNullable(timingResult)\r\n                .map(StdConsoOrderConfirmResult::getAttributes)\r\n                .ifPresent(mergeAttributes::putAll);\r\n            mergeResult.setAttributes(mergeAttributes);\r\n\r\n            HashMap<String, String> mergeVerticalAttributes = Maps.newHashMap();\r\n            mergeVerticalAttributes.putAll(feeStd.getVerticalAttributes());\r\n            Optional.ofNullable(timingResult)\r\n                .map(StdConsoOrderConfirmResult::getVerticalAttributes)\r\n                .ifPresent(mergeVerticalAttributes::putAll);\r\n            mergeResult.setAttributes(mergeAttributes);\r\n            mergeResult.setVerticalAttributes(mergeVerticalAttributes);\r\n\r\n            mergeResult.setItemConfirmResultList(this.converterStdItemConfirmResult(feeStd.getItemConfirmResultList(),\r\n                Optional.ofNullable(timingResult).map(StdConsoOrderConfirmResult::getItemConfirmResultList).orElse(Lists.newArrayList())));\r\n\r\n            return mergeResult;\r\n\r\n        }).collect(Collectors.toList());\r\n    }\r\n\r\n    private List<StdConsoItemConfirmResult> converterStdItemConfirmResult(List<StdConsoItemConfirmResult> feeItemConfirmResults, List<StdConsoItemConfirmResult> timingItemConfirmResults) {\r\n        if (CollectionUtils.isEmpty(timingItemConfirmResults)) {\r\n            return feeItemConfirmResults;\r\n        }\r\n        if (CollectionUtils.isEmpty(feeItemConfirmResults)) {\r\n            return Lists.newArrayList();\r\n        }\r\n\r\n        Map<String, StdConsoItemConfirmResult> timingStdConfirmMap = timingItemConfirmResults.stream()\r\n            .collect(Collectors.toMap(item -> KeyUtil.getKey(item.getItemId(), item.getSkuId()), Function.identity(), (a, b) -> a));\r\n\r\n        return feeItemConfirmResults.stream().map(feeItem -> {\r\n            StdConsoItemConfirmResult timingItem = timingStdConfirmMap.get(KeyUtil.getKey(feeItem.getItemId(), feeItem.getSkuId()));\r\n\r\n            StdConsoItemConfirmResult mergeResult = new StdConsoItemConfirmResult();\r\n            mergeResult.setItemId(feeItem.getItemId());\r\n            mergeResult.setSkuId(feeItem.getSkuId());\r\n            mergeResult.setRelationList(feeItem.getRelationList());\r\n\r\n            HashMap<String, String> mergeAttributes = Maps.newHashMap();\r\n            mergeAttributes.putAll(feeItem.getAttributes());\r\n            Optional.ofNullable(timingItem)\r\n                .map(StdConsoItemConfirmResult::getAttributes)\r\n                .ifPresent(mergeAttributes::putAll);\r\n            mergeResult.setAttributes(mergeAttributes);\r\n\r\n            HashMap<String, String> mergeVerticalAttributes = Maps.newHashMap();\r\n            mergeVerticalAttributes.putAll(feeItem.getVerticalAttributes());\r\n            Optional.ofNullable(timingItem)\r\n                .map(StdConsoItemConfirmResult::getVerticalAttributes)\r\n                .ifPresent(mergeVerticalAttributes::putAll);\r\n            mergeResult.setVerticalAttributes(mergeVerticalAttributes);\r\n\r\n            return mergeResult;\r\n        }).collect(Collectors.toList());\r\n    }\r\n\r\n    private List<OrderConfirmResultTO> assembleConfirmResults(List<OrderConfirmResultTO> feeResult, List<OrderConfirmResultTO> timingResult, Set<Long> switchPostTypes) {\r\n        if (CollectionUtils.isEmpty(feeResult)) {\r\n            return timingResult;\r\n        }\r\n        if (CollectionUtils.isEmpty(timingResult)) {\r\n            return feeResult;\r\n        }\r\n        Map<String, OrderConfirmResultTO> timingResultMap = timingResult.stream()\r\n            .collect(Collectors.toMap(OrderConfirmResultTO::getOutOrderId, Function.identity(), (a, b) -> a));\r\n        return CollectionUtils.emptyIfNull(feeResult)\r\n            .stream()\r\n            .map(feeConfirm -> {\r\n                OrderConfirmResultTO timingConfirm = timingResultMap.get(feeConfirm.getOutOrderId());\r\n                return this.assembleConfirmResult(feeConfirm, timingConfirm, switchPostTypes);\r\n            })\r\n            .collect(Collectors.toList());\r\n\r\n    }\r\n\r\n    private OrderConfirmResultTO assembleConfirmResult(OrderConfirmResultTO feeConfirm, OrderConfirmResultTO timingConfirm, Set<Long> switchPostTypes) {\r\n        OrderConfirmResultTO mergerConfirm = new OrderConfirmResultTO();\r\n\r\n        // ͨ�û����ֶ�\r\n        mergerConfirm.setOutOrderId(feeConfirm.getOutOrderId());\r\n        mergerConfirm.setBizIdentityTO(timingConfirm.getBizIdentityTO());\r\n        mergerConfirm.setIsConfirmed(this.mergeIsConfirmed(feeConfirm.getIsConfirmed(), timingConfirm.getIsConfirmed()));\r\n        mergerConfirm.setConfirmDesc(feeConfirm.getConfirmDesc());\r\n        mergerConfirm.setConfirmErrorCode(feeConfirm.getConfirmErrorCode());\r\n        mergerConfirm.setConfirmErrorType(feeConfirm.getConfirmErrorType());\r\n        mergerConfirm.setConfirmErrorSource(feeConfirm.getConfirmErrorSource());\r\n        mergerConfirm.setConfirmErrorLocation(feeConfirm.getConfirmErrorLocation());\r\n\r\n        //���״�ֱ�����ݣ����ڱ�ǵ���ʱЧ�ֶΣ�ʱЧ���˽��״�ֱ��?\r\n        mergerConfirm.setServiceTags(timingConfirm.getServiceTags());\r\n\r\n        // ��϶���\r\n        mergerConfirm.setAbilityResultTO(this.assembleAbilityResult(feeConfirm.getAbilityResultTO(), timingConfirm.getAbilityResultTO(), switchPostTypes));\r\n        //postFeeClient �����templateSnapshot ��ֱ���ı꣬��Ҫ�ϲ�\r\n        mergerConfirm.setVerticalTags(this.mergeVerticalTags(feeConfirm.getVerticalTags(), timingConfirm.getVerticalTags()));\r\n        mergerConfirm.setLogisticsOrderServiceTO(this.mergeLogisticsOrderServiceTO(feeConfirm.getLogisticsOrderServiceTO(), timingConfirm.getLogisticsOrderServiceTO()));\r\n\r\n        // �˷��ֶ�\r\n        mergerConfirm.setPostFeeSnapshotDTOs(feeConfirm.getPostFeeSnapshotDTOs());\r\n        mergerConfirm.setResultCodeMap(feeConfirm.getResultCodeMap());\r\n\r\n        // ʱЧ�ֶ�\r\n        mergerConfirm.setShipTimeGray(timingConfirm.getShipTimeGray());\r\n        mergerConfirm.setOrderSavedInfo(timingConfirm.getOrderSavedInfo());\r\n        mergerConfirm.setOrderLineAtrribute(timingConfirm.getOrderLineAtrribute());\r\n        mergerConfirm.setOrderAttribute(timingConfirm.getOrderAttribute());\r\n        mergerConfirm.setOrderWeight(timingConfirm.getOrderWeight());\r\n        mergerConfirm.setOrderPromiseItemAttribute(timingConfirm.getOrderPromiseItemAttribute());\r\n        mergerConfirm.setOrderLinePromiseItemAtrribute(timingConfirm.getOrderLinePromiseItemAtrribute());\r\n        mergerConfirm.setMainBizOrderServiceTO(timingConfirm.getMainBizOrderServiceTO());\r\n        mergerConfirm.setSubOrderServiceTOMap4Buy(timingConfirm.getSubOrderServiceTOMap4Buy());\r\n        mergerConfirm.setSubOrderServiceTOUniqueKeyMap4Buy(timingConfirm.getSubOrderServiceTOUniqueKeyMap4Buy());\r\n        mergerConfirm.setSubOrderServiceTOMap(timingConfirm.getSubOrderServiceTOMap());\r\n        mergerConfirm.setLscInfoTO(timingConfirm.getLscInfoTO());\r\n        mergerConfirm.setSubOrderLscInfoMap(timingConfirm.getSubOrderLscInfoMap());\r\n\r\n        return mergerConfirm;\r\n    }\r\n\r\n    private Boolean mergeIsConfirmed(Boolean feeIsConfirmed, Boolean timingIsConfirmed) {\r\n        //�ο���com.alibaba.delivery.logistics.adaptor.AdpResultAdapter.toConfirmResultTO 3740 timingIsConfirmed����Ϊnull��������һ�±���\r\n        if (Objects.isNull(timingIsConfirmed)) {\r\n            return feeIsConfirmed;\r\n        }\r\n        if (Objects.isNull(feeIsConfirmed)) {\r\n            return false;\r\n        }\r\n        return feeIsConfirmed && timingIsConfirmed;\r\n    }\r\n\r\n    private List<VerticalTag> mergeVerticalTags(List<VerticalTag> feeVerticalTags, List<VerticalTag> timingVerticalTags) {\r\n        if (Objects.isNull(timingVerticalTags)) {\r\n            return feeVerticalTags;\r\n        }\r\n        if (Objects.isNull(feeVerticalTags)) {\r\n            return timingVerticalTags;\r\n        }\r\n        for (VerticalTag verticalTag : feeVerticalTags) {\r\n            this.merge(timingVerticalTags, verticalTag);\r\n        }\r\n        return timingVerticalTags;\r\n    }\r\n\r\n    private void merge(List<VerticalTag> targetVerticalTags, VerticalTag sourceVerticalTag) {\r\n        boolean isExistOrderId = false;\r\n        for(VerticalTag targetVerticalTag : targetVerticalTags) {\r\n            if (StringUtils.equals(targetVerticalTag.outOrderId, sourceVerticalTag.getOutOrderId())\r\n                && StringUtils.equals(targetVerticalTag.getSubOrderId(), sourceVerticalTag.getSubOrderId())) {\r\n                if (Objects.isNull(targetVerticalTag.getAttribute())) {\r\n                    targetVerticalTag.setAttribute(Maps.newHashMap());\r\n                }\r\n                targetVerticalTag.getAttribute().putAll(sourceVerticalTag.getAttribute());\r\n                isExistOrderId = true;\r\n            }\r\n        }\r\n        if (!isExistOrderId) {\r\n            targetVerticalTags.add(sourceVerticalTag);\r\n        }\r\n    }\r\n\r\n    private LogisticsOrderServiceTO mergeLogisticsOrderServiceTO(LogisticsOrderServiceTO feeLogisticsOrderServiceTO, LogisticsOrderServiceTO timingLogisticsOrderServiceTO) {\r\n        if (Objects.isNull(timingLogisticsOrderServiceTO)) {\r\n            return feeLogisticsOrderServiceTO;\r\n        }\r\n        if (Objects.isNull(feeLogisticsOrderServiceTO)) {\r\n            return timingLogisticsOrderServiceTO;\r\n        }\r\n\r\n        if (Objects.isNull(timingLogisticsOrderServiceTO.getUpdateAttrs())) {\r\n            timingLogisticsOrderServiceTO.setUpdateAttrs(Maps.newHashMap());\r\n        }\r\n        if (MapUtils.isNotEmpty(feeLogisticsOrderServiceTO.getUpdateAttrs())) {\r\n            timingLogisticsOrderServiceTO.getUpdateAttrs().putAll(feeLogisticsOrderServiceTO.getUpdateAttrs());\r\n        }\r\n        if (Objects.isNull(timingLogisticsOrderServiceTO.getDeleteAttrs())) {\r\n            timingLogisticsOrderServiceTO.setDeleteAttrs(Maps.newHashMap());\r\n        }\r\n        if (MapUtils.isNotEmpty(feeLogisticsOrderServiceTO.getDeleteAttrs())) {\r\n            timingLogisticsOrderServiceTO.getDeleteAttrs().putAll(feeLogisticsOrderServiceTO.getDeleteAttrs());\r\n        }\r\n        return timingLogisticsOrderServiceTO;\r\n    }\r\n\r\n    private List<AbilityResultTO> assembleAbilityResults(List<AbilityResultTO> feeResult, List<AbilityResultTO> timingResult, Set<Long> switchPostTypes) {\r\n        if (CollectionUtils.isEmpty(feeResult)) {\r\n            return timingResult;\r\n        }\r\n\r\n        if (CollectionUtils.isEmpty(timingResult)) {\r\n            return feeResult;\r\n        }\r\n\r\n        Map<String, AbilityResultTO> timingResultMap = timingResult.stream()\r\n            .collect(Collectors.toMap(AbilityResultTO::getOutOrderId, Function.identity(), (a, b) -> a));\r\n        return CollectionUtils.emptyIfNull(feeResult)\r\n            .stream()\r\n            .map(feeAbility -> {\r\n                AbilityResultTO timingAbility = timingResultMap.get(feeAbility.getOutOrderId());\r\n                return this.assembleAbilityResult(feeAbility, timingAbility, switchPostTypes);\r\n            })\r\n            .collect(Collectors.toList());\r\n    }\r\n\r\n    private AbilityResultTO assembleAbilityResult(AbilityResultTO feeAbility, AbilityResultTO timingAbility, Set<Long> switchPostTypes) {\r\n        if (Objects.isNull(timingAbility)) {\r\n            return feeAbility;\r\n        }\r\n        if (Objects.isNull(feeAbility)) {\r\n            return timingAbility;\r\n        }\r\n        AbilityResultTO mergedAbility = new AbilityResultTO();\r\n        // ͨ�û����ֶ�\r\n        mergedAbility.setOutOrderId(feeAbility.getOutOrderId());\r\n        mergedAbility.setBizIdentityTO(timingAbility.getBizIdentityTO());\r\n        mergedAbility.setPromiseControlItems(timingAbility.getPromiseControlItems());\r\n        mergedAbility.setPromiseItems(timingAbility.getPromiseItems());\r\n        mergedAbility.setRenderText(timingAbility.getRenderText());\r\n        mergedAbility.setShipTimeGray(timingAbility.getShipTimeGray());\r\n        mergedAbility.setExt(timingAbility.getExt());\r\n        mergedAbility.setItemServiceMap(timingAbility.getItemServiceMap());\r\n        mergedAbility.setLogisticsSerivce(timingAbility.getLogisticsSerivce());\r\n\r\n        //�˷Ѻ�ʱЧ�������ֶ�\r\n        mergedAbility.setServiceErrorCode(LangUtils.defaultIfNull(feeAbility.getServiceErrorCode(), timingAbility.getServiceErrorCode()));\r\n\r\n        // ��϶���\r\n        // merge ship detail\r\n        if (hasSpecificErrorCode(mergedAbility.getServiceErrorCode())) {\r\n            return mergedAbility;\r\n        }\r\n        mergedAbility.setShippingDetails(this.assembleShippingDetails(feeAbility.getShippingDetails(), timingAbility.getShippingDetails(), switchPostTypes));\r\n        mergedAbility.setStdConsoShippingDetail(this.assembleStdShippingDetails(feeAbility.getStdConsoShippingDetail(), timingAbility.getStdConsoShippingDetail()));\r\n\r\n        // feature �ϲ�, adapter û��feature, ����\r\n        //Map<String, String> feature = MapUtils.emptyIfNull(feeAbility.getFeature());\r\n        //feature.putAll(timingAbility.getFeature());\r\n        //mergedAbility.setFeature(feature);\r\n\r\n        // �˷��ֶ�\r\n        mergedAbility.setConsoDirectFee(feeAbility.getConsoDirectFee());\r\n        mergedAbility.setDemoteLines(feeAbility.getDemoteLines());\r\n\r\n        // ʱЧ�ֶ�\r\n        mergedAbility.setOrderShipTimeTO(timingAbility.getOrderShipTimeTO());\r\n        mergedAbility.setAppointShip(timingAbility.getAppointShip());\r\n        mergedAbility.setOrderWeight(timingAbility.getOrderWeight());\r\n        mergedAbility.setAgreementConsign(timingAbility.getAgreementConsign());\r\n        mergedAbility.setShowMultiSelect(timingAbility.isShowMultiSelect());\r\n        mergedAbility.setLocation(timingAbility.getLocation());\r\n        mergedAbility.setAttributeList(timingAbility.getAttributeList());\r\n\r\n        mergedAbility.setSkuPromiseItems(timingAbility.getSkuPromiseItems());\r\n        mergedAbility.setSkuRenderTexts(timingAbility.getSkuRenderTexts());\r\n        mergedAbility.setItemResultTOS(timingAbility.getItemResultTOS());\r\n        mergedAbility.setSpringFestivalInfoTO(timingAbility.getSpringFestivalInfoTO());\r\n\r\n        //�˷Ѷ���͸ʱЧ��ر���ֶ�\r\n        mergedAbility.setLogisticsServiceFeatures(timingAbility.getLogisticsServiceFeatures());\r\n\r\n        return mergedAbility;\r\n    }\r\n\r\n    private boolean hasSpecificErrorCode(ServiceErrorCode errorCode) {\r\n        if (Objects.isNull(errorCode)) {\r\n            return false;\r\n        }\r\n\r\n        return AdpServiceErrorCode.ADP_BIZ_ERROR_TXD_SYSTEM_ERROR.getCode().equals(errorCode)\r\n            || AdpServiceErrorCode.ADP_BIZ_ERROR_TXD_TIMING_EMPTY.getCode().equals(errorCode)\r\n            || AdpServiceErrorCode.ADP_BIZ_ERROR_TXD_FEE_EMPTY.getCode().equals(errorCode)\r\n            || AdpServiceErrorCode.ADP_BIZ_ERROR_TXD_DISTANCE_EMPTY.getCode().equals(errorCode)\r\n            || AdpServiceErrorCode.ADP_BIZ_ERROR_TXD_SHOP_EMPTY.getCode().equals(errorCode)\r\n            || AdpServiceErrorCode.ADP_BIZ_ERROR_TXD_OVER_WEIGHT.getCode().equals(errorCode);\r\n    }\r\n\r\n\r\n    // todo: refactor @���� ���˵��˷�ʱЧ�ϲ��߼����, ���˵��˷�����ô�����?\r\n    private StdConsoShippingDetail assembleStdShippingDetails(StdConsoShippingDetail feeStdConsoShippingDetail, StdConsoShippingDetail timingStdConsoShippingDetail) {\r\n        if (Objects.isNull(feeStdConsoShippingDetail) || Objects.isNull(timingStdConsoShippingDetail)) {\r\n            return feeStdConsoShippingDetail;\r\n        }\r\n\r\n        ArrayList<StdConsoSegmentShippingDetail> stdConsoSegmentShippingDetails = new ArrayList<>();\r\n\r\n        // ����1�κϲ�\r\n        StdConsoSegmentShippingDetail firstStdConsoSegment = getStdConsoSegmentShippingDetail(feeStdConsoShippingDetail, timingStdConsoShippingDetail, BaseStdConsoSegment::isFirstSegment);\r\n        stdConsoSegmentShippingDetails.add(firstStdConsoSegment);\r\n\r\n        // ����2�κϲ�\r\n        StdConsoSegmentShippingDetail secondStdConsoSegment = getStdConsoSegmentShippingDetail(feeStdConsoShippingDetail, timingStdConsoShippingDetail, BaseStdConsoSegment::isLastSegment);\r\n        stdConsoSegmentShippingDetails.add(secondStdConsoSegment);\r\n\r\n        StdConsoShippingDetail result = new StdConsoShippingDetail();\r\n        result.setSegmentShippingDetailList(stdConsoSegmentShippingDetails);\r\n        return result;\r\n    }\r\n\r\n    private StdConsoSegmentShippingDetail getStdConsoSegmentShippingDetail(StdConsoShippingDetail feeStdConsoShippingDetail, StdConsoShippingDetail timingStdConsoShippingDetail,\r\n                                                                           Predicate<StdConsoSegmentShippingDetail> isFirstSegment) {\r\n        StdConsoSegmentShippingDetail feeFirstSegmentStdConso = CollectionUtils.emptyIfNull(feeStdConsoShippingDetail.getSegmentShippingDetailList())\r\n            .stream()\r\n            .filter(isFirstSegment)\r\n            .findFirst()\r\n            .orElse(null);\r\n\r\n        StdConsoSegmentShippingDetail timingFirstSegmentStdConso = CollectionUtils.emptyIfNull(timingStdConsoShippingDetail.getSegmentShippingDetailList())\r\n            .stream()\r\n            .filter(isFirstSegment)\r\n            .findFirst()\r\n            .orElse(null);\r\n        if (Objects.isNull(feeFirstSegmentStdConso) || Objects.isNull(timingFirstSegmentStdConso)) {\r\n            return feeFirstSegmentStdConso;\r\n        }\r\n\r\n        StdConsoSegmentShippingDetail detail = new StdConsoSegmentShippingDetail();\r\n        detail.setOrderShipTime(timingFirstSegmentStdConso.getOrderShipTime());\r\n        detail.setSkuPromiseItems(timingFirstSegmentStdConso.getSkuPromiseItems());\r\n        detail.setSkuRenderTexts(timingFirstSegmentStdConso.getSkuRenderTexts());\r\n        detail.setFirstSegment(timingFirstSegmentStdConso.isFirstSegment());\r\n        detail.setLastSegment(timingFirstSegmentStdConso.isLastSegment());\r\n        detail.setFrom(timingFirstSegmentStdConso.getFrom());\r\n        detail.setTo(timingFirstSegmentStdConso.getTo());\r\n        detail.setShippingDetails(this.assembleShippingDetails(feeFirstSegmentStdConso.getShippingDetails(), timingFirstSegmentStdConso.getShippingDetails(), Sets.newHashSet()));\r\n        return detail;\r\n    }\r\n    \r\n    private List<ShippingDetail> assembleShippingDetails(List<ShippingDetail> feeShippingDetails, List<ShippingDetail> timingShippingDetails, Set<Long> switchPostTypes) {\r\n        Map<Long, ShippingDetail> timingShipDetailsMap = timingShippingDetails.stream()\r\n            .collect(Collectors.toMap(ShippingDetail::getGroupId, Function.identity(), (a, b) -> a));\r\n\r\n        List<ShippingDetail> mergeShippingDetail = CollectionUtils.emptyIfNull(feeShippingDetails)\r\n            .stream()\r\n            .map(feeShippingDetail -> {\r\n                ShippingDetail timingShippingDetail = timingShipDetailsMap.get(feeShippingDetail.getGroupId());\r\n                if (Objects.isNull(timingShippingDetail)) {\r\n                    return null;\r\n                }\r\n                List<FeeDesc> feeDescs = this.converterFeeDesc(feeShippingDetail.getFeeDescs(), LangUtils.mapIfNotNull(timingShippingDetail, ShippingDetail::getFeeDescs), switchPostTypes);\r\n                ShippingDetail shippingDetail = new ShippingDetail();\r\n                shippingDetail.setGroupId(feeShippingDetail.getGroupId());\r\n                shippingDetail.setGroupName(feeShippingDetail.getGroupName());\r\n                shippingDetail.setFeeDescs(feeDescs);\r\n                return shippingDetail;\r\n            })\r\n            .filter(Objects::nonNull)\r\n            .collect(Collectors.toList());\r\n\r\n        Set<Long> mergedGroupIds = getMergedGroupIds(switchPostTypes, mergeShippingDetail);\r\n\r\n        List<ShippingDetail> remainTimingShippingDetail = timingShipDetailsMap.entrySet().stream()\r\n            .filter(entry -> !mergedGroupIds.contains(entry.getKey()))\r\n            .map(Entry::getValue)\r\n            .collect(Collectors.toList());\r\n\r\n        // ����ط�Ӧ���ж���group�ǲ����ڻҶȷ�Χ�أ�����ڣ�����merge��û�У�Ҳ��Ӧ�üӽ�ȥ��������ʵһ������-4���ף����Ծͱ�����\r\n        return ListUtils.merge(mergeShippingDetail, remainTimingShippingDetail);\r\n\r\n    }\r\n\r\n    private Set<Long> getMergedGroupIds(Set<Long> switchPostTypes, List<ShippingDetail> mergeShippingDetail) {\r\n        if (PfPostFeeConfig.enableFixMergeShippingDetailWhenFeeResultIsNull) {\r\n            return switchPostTypes.stream()\r\n                .map(postType -> {\r\n                    PfPostTypeEnum byCode = PfPostTypeEnum.getByCode(postType);\r\n                    return Optional.ofNullable(byCode).map(PfPostTypeEnum::getGroup).orElse(null);\r\n                })\r\n                .filter(Objects::nonNull)\r\n                .map(PfPostTypeGroupEnum::getValue)\r\n                .collect(Collectors.toSet());\r\n        }\r\n\r\n        return mergeShippingDetail.stream()\r\n            .map(ShippingDetail::getGroupId)\r\n            .collect(Collectors.toSet());\r\n    }\r\n\r\n    private List<FeeDesc> converterFeeDesc(List<FeeDesc> feePosts, List<FeeDesc> timingPosts, Set<Long> switchPostTypes) {\r\n        if (org.apache.commons.collections.CollectionUtils.isEmpty(switchPostTypes)) {\r\n            return timingPosts;\r\n        }\r\n\r\n        Map<String, FeeDesc> mergedFeeDescsMap = Maps.newHashMap();\r\n        Map<String, FeeDesc> remainTimingFeeDescMap = new LinkedHashMap();\r\n        Optional.ofNullable(timingPosts)\r\n            .orElse(com.google.common.collect.Lists.newArrayList())\r\n            .stream()\r\n            .collect(Collectors.toMap(this::getFeeDescUniqueKey, Function.identity(), (v1, v2) -> v1, LinkedHashMap::new))\r\n            .forEach((k, v) -> {\r\n                if (switchPostTypes.contains(Long.valueOf(k))) {\r\n                    mergedFeeDescsMap.put(k, v);\r\n                } else {\r\n                    remainTimingFeeDescMap.put(k, v);\r\n                }\r\n            });\r\n\r\n        List<FeeDesc> mergeResult = Optional.ofNullable(feePosts).orElse(com.google.common.collect.Lists.newArrayList())\r\n            .stream()\r\n            .filter(feeDesc -> switchPostTypes.contains(Long.valueOf(this.getFeeDescUniqueKey(feeDesc))))\r\n            .map(feeFeeDesc -> {\r\n                FeeDesc timingFeeDesc = mergedFeeDescsMap.get(this.getFeeDescUniqueKey(feeFeeDesc));\r\n                FeeDesc mergedFeeDesc = new FeeDesc();\r\n                this.fillFeeInFeeDesc(mergedFeeDesc, feeFeeDesc);\r\n                this.fillTimingInFeeDesc(mergedFeeDesc, timingFeeDesc);\r\n                return mergedFeeDesc;\r\n            }).collect(Collectors.toList());\r\n\r\n        return ListUtils.merge(mergeResult, ListUtils.of(remainTimingFeeDescMap.values()));\r\n    }\r\n\r\n    private String getFeeDescUniqueKey(FeeDesc item) {\r\n        UserChooseLogisticsInfo userChooseLogisticsInfo = JSON.parseObject(item.getUserChooseLogisticsInfoString(), UserChooseLogisticsInfo.class);\r\n        Long uniqueKey = Optional.ofNullable(userChooseLogisticsInfo)\r\n            .map(UserChooseLogisticsInfo::getChildServiceType)\r\n            .orElse(item.getServiceType());\r\n        return String.valueOf(uniqueKey);\r\n    }\r\n    private void fillFeeInFeeDesc(FeeDesc mergedFeeDesc, FeeDesc feeFeeDesc) {\r\n        mergedFeeDesc.setServiceType(feeFeeDesc.getServiceType());\r\n        mergedFeeDesc.setName(feeFeeDesc.getName());\r\n        mergedFeeDesc.setTypeName(feeFeeDesc.getTypeName());\r\n        mergedFeeDesc.setBizShipping(feeFeeDesc.getBizShipping());\r\n        mergedFeeDesc.setMemo(feeFeeDesc.getMemo());\r\n\r\n        mergedFeeDesc.setSellPayWeightHint(feeFeeDesc.getSellPayWeightHint());\r\n        mergedFeeDesc.setSellPayStatus(feeFeeDesc.getSellPayStatus());\r\n        mergedFeeDesc.setSellPayRegionPriceHint(feeFeeDesc.getSellPayRegionPriceHint());\r\n        mergedFeeDesc.setSellPayWeightHint(feeFeeDesc.getSellPayWeightHint());\r\n        mergedFeeDesc.setSellPayThresholdTip(feeFeeDesc.getSellPayThresholdTip());\r\n        mergedFeeDesc.setSellerRate(feeFeeDesc.getSellerRate());\r\n\r\n        mergedFeeDesc.setPriceBalance(feeFeeDesc.getPriceBalance());\r\n        mergedFeeDesc.setInfoBalance(feeFeeDesc.getInfoBalance());\r\n        mergedFeeDesc.setTotalFee(feeFeeDesc.getTotalFee());\r\n        mergedFeeDesc.setFee(feeFeeDesc.getFee());\r\n        mergedFeeDesc.setFeeUnit(feeFeeDesc.getFeeUnit());\r\n        mergedFeeDesc.setPostFee(feeFeeDesc.getPostFee());\r\n        mergedFeeDesc.setCalFeeMethod(feeFeeDesc.getCalFeeMethod());\r\n\r\n        mergedFeeDesc.setPackFee(feeFeeDesc.getPackFee());\r\n        mergedFeeDesc.setExtendedFee(feeFeeDesc.getExtendedFee());\r\n        mergedFeeDesc.setHasExtendedFee(feeFeeDesc.isHasExtendedFee());\r\n        mergedFeeDesc.setCodSellerServiceFee(feeFeeDesc.isCodSellerServiceFee());\r\n        mergedFeeDesc.setPromotionUsageTO(feeFeeDesc.getPromotionUsageTO());\r\n\r\n        mergedFeeDesc.setCompanyId(feeFeeDesc.getCompanyId());\r\n        mergedFeeDesc.setCompanyPosts(feeFeeDesc.getCompanyPosts());\r\n        mergedFeeDesc.setStatusHint(feeFeeDesc.getStatusHint());\r\n        mergedFeeDesc.setPriceHint(feeFeeDesc.getPriceHint());\r\n        mergedFeeDesc.setInfoHint(feeFeeDesc.getInfoHint());\r\n        mergedFeeDesc.setOverweight(feeFeeDesc.getOverweight());\r\n        mergedFeeDesc.setStartingPrice(feeFeeDesc.getStartingPrice());\r\n\r\n        mergedFeeDesc.setDetailService(feeFeeDesc.getDetailService());\r\n        mergedFeeDesc.setOverseasFeeDetailTO(feeFeeDesc.getOverseasFeeDetailTO());\r\n        mergedFeeDesc.setUserChooseLogisticsInfoString(feeFeeDesc.getUserChooseLogisticsInfoString());\r\n        mergedFeeDesc.setFeeCalcPackageInfoDTO(feeFeeDesc.getFeeCalcPackageInfoDTO());\r\n        mergedFeeDesc.setServiceFeeList(feeFeeDesc.getServiceFeeList());\r\n        mergedFeeDesc.setFeeFeature(feeFeeDesc.getFeeFeature());\r\n        mergedFeeDesc.setPostFeeSubjectType(feeFeeDesc.getPostFeeSubjectType());\r\n    }\r\n\r\n    private void fillTimingInFeeDesc(FeeDesc mergedFeeDesc, FeeDesc timingFeeDesc) {\r\n        if (Objects.isNull(timingFeeDesc)) {\r\n            return;\r\n        }\r\n        mergedFeeDesc.setTownSupportService(timingFeeDesc.isTownSupportService());\r\n        mergedFeeDesc.setShowTips(timingFeeDesc.getShowTips());\r\n        mergedFeeDesc.setTownCode(timingFeeDesc.getTownCode());\r\n        mergedFeeDesc.setTownName(timingFeeDesc.getTownNam