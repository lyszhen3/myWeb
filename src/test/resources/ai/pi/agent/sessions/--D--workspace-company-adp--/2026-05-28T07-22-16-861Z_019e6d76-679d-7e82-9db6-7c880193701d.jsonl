{"type":"message","id":"5af9d8d3","parentId":"b4d41268","timestamp":"2026-05-28T07:48:43.337Z","message":{"role":"toolResult","toolCallId":"call_7d48338e73004465bffa77d7","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.logistics.ability.shiptime.calculator.impl;\r\n\r\nimport java.util.HashMap;\r\nimport java.util.List;\r\n\r\nimport com.alibaba.delivery.common.diamond.AdpNewLogisticBizConfig;\r\nimport com.alibaba.delivery.common.diamond.platform.AdpPlatformBizConfig;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.calculator.IShipTimingForwardCalculator;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.promise.ShipTimeRuleEnum;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.promise.ShipTimeWrapperService;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.service.appoint.AppointShipService;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.service.param.AppointShipParam;\r\nimport com.alibaba.delivery.logistics.ability.shiptime.service.springfestival.SpringFestivalShipTimeRuleService;\r\nimport com.alibaba.delivery.logistics.entity.core.constant.ShipTypeEnum;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryCarrierDO;\r\nimport com.alibaba.delivery.logistics.entity.core.targets.DeliveryPackageDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeDO;\r\nimport com.alibaba.delivery.logistics.entity.params.channel.ClientChannelDTO;\r\nimport com.alibaba.delivery.logistics.entity.params.option.AdpOption;\r\nimport com.alibaba.delivery.logistics.utils.ShipTimeUtils;\r\n\r\nimport com.alibaba.delivery.logistics.utils.TimingUtils;\r\nimport com.taobao.delivery.common.constant.SellTypeEnum;\r\nimport com.taobao.delivery.common.transfer.AppointShip;\r\nimport lombok.Setter;\r\nimport lombok.extern.slf4j.Slf4j;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\nimport org.apache.commons.lang3.StringUtils;\r\n\r\nimport javax.annotation.Resource;\r\n\r\n/**\r\n * �����������ʱЧ������\r\n *\r\n * @author ����\r\n * @date 2024-04-06\r\n */\r\n@Slf4j\r\n@Setter\r\npublic class PromotionDeliveryShipTimingForwardCalculator implements IShipTimingForwardCalculator {\r\n\r\n    private ShipTimeWrapperService shipTimeWrapperService;\r\n    private AppointShipService appointShipService;\r\n\r\n    private SpringFestivalShipTimeRuleService springFestivalShipTimeRuleService;\r\n\r\n    @Resource\r\n    public void setSpringFestivalShipTimeRuleService(\r\n            SpringFestivalShipTimeRuleService springFestivalShipTimeRuleService) {\r\n        this.springFestivalShipTimeRuleService = springFestivalShipTimeRuleService;\r\n    }\r\n\r\n    @Override\r\n    public ShipTypeEnum getShipType() {\r\n        return ShipTypeEnum.PROMOTION_DELIVERY_SHIP_TIMING;\r\n    }\r\n\r\n    @Override\r\n    public boolean needCal(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, ClientChannelDTO clientChannelDTO, AdpOption adpOption) {\r\n        if (!AdpPlatformBizConfig.openPromotionDeliveryShipTimingCalculator) {\r\n            return false;\r\n        }\r\n\r\n        return deliveryCarrierDO != null\r\n                && deliveryCarrierDO.getDeliveryCarrierDTO() != null\r\n                && CollectionUtils.isNotEmpty(deliveryCarrierDO.getDeliveryCarrierDTO().getPromotionDeliveryShipTime());\r\n    }\r\n\r\n    @Override\r\n    public ShipTimeDO doCal(DeliveryPackageDO deliveryPackageDO, DeliveryCarrierDO deliveryCarrierDO, ClientChannelDTO clientChannelDTO, AdpOption adpOption) {\r\n\r\n        if (deliveryCarrierDO == null\r\n                || deliveryCarrierDO.getDeliveryCarrierDTO() == null\r\n                || CollectionUtils.isEmpty(deliveryCarrierDO.getDeliveryCarrierDTO().getPromotionDeliveryShipTime())) {\r\n            return null;\r\n        }\r\n\r\n        ShipTimeDO shipTimeDO = new ShipTimeDO();\r\n        shipTimeDO.setNonContinueCalculate(true);\r\n        shipTimeDO.setSellType(SellTypeEnum.REAL_SELL.getType());\r\n        shipTimeDO.setShipType(ShipTypeEnum.PROMOTION_DELIVERY_SHIP_TIMING);\r\n        List<String> promotionDeliveryShipTiming = deliveryCarrierDO.getDeliveryCarrierDTO().getPromotionDeliveryShipTime();\r\n        if (TimingUtils.isDShopSeller(deliveryPackageDO)) {\r\n            shipTimeDO.setNonRenderPromiseItem(true);\r\n        }\r\n        String smallerShipTime = ShipTimeUtils.getSmallerShipTime(promotionDeliveryShipTiming);\r\n        if (StringUtils.isEmpty(smallerShipTime)) {\r\n            return shipTimeDO;\r\n        }\r\n        shipTimeDO.setShipTime(smallerShipTime);\r\n        shipTimeDO.setDecisionReason(ShipTypeEnum.PROMOTION_DELIVERY_SHIP_TIMING.getDesc());\r\n\r\n        //���䴺�ڲ�����ʱЧ����\r\n        if (AdpNewLogisticBizConfig.springFestivalPromotionDeliverySwitch) {\r\n            springFestivalShipTimeRuleService.process(deliveryPackageDO, deliveryCarrierDO, shipTimeDO);\r\n        }\r\n\r\n        // ����ŵ�����ֵ��\r\n        shipTimeWrapperService.wrapShipTimeDOSafety(shipTimeDO, ShipTimeRuleEnum.T_PROMOTION_DELIVERY_SHIP_TIMING, null,\r\n                SellTypeEnum.REAL_SELL, new HashMap<>(0));\r\n\r\n        // ����ԤԼ��������\r\n        AppointShipParam appointShipParam = new AppointShipParam();\r\n        appointShipParam.setDeliveryPackageDO(deliveryPackageDO);\r\n        appointShipParam.setDeliveryCarrierDO(deliveryCarrierDO);\r\n        appointShipParam.setShipTimeDO(shipTimeDO);\r\n        appointShipParam.setShipType(this.getShipType().getType());\r\n        appointShipParam.setClientChannelDTO(clientChannelDTO);\r\n\r\n        AppointShip appointShip = this.appointShipService.process(appointShipParam);\r\n        shipTimeDO.setAppointShip(appointShip);\r\n\r\n        return shipTimeDO;\r\n    }\r\n\r\n}\r\n"}],"isError":false,"timestamp":1779954523337}}
