cessList.sort(processComparator);\r\n    }\r\n\r\n    /**\r\n     * ƥ������\r\n     *\r\n     * @param sceneCode       ��������\r\n     * @param identityContext ����������\r\n     * @return ����ʵ����δƥ���򷵻�null\r\n     */\r\n    @SuppressWarnings(\"unchecked\")\r\n    public static\r\n    <Req, Res, I extends ProcessInput<Req>, O extends ProcessOutput<Res>, P extends Process<Req, Res, I, O>>\r\n    P route(String sceneCode, IdentityContext identityContext) {\r\n        List<Process<?, ?, ?, ?>> processList = processRepo.get(sceneCode);\r\n        if (CollectionUtils.isEmpty(processList)) {\r\n            return null;\r\n        }\r\n        for (Process<?, ?, ?, ?> process : processList) {\r\n            if (process.match(identityContext)) {\r\n                return (P)process;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n}\r\n"}],"isError":false,"timestamp":1779953117729}}
