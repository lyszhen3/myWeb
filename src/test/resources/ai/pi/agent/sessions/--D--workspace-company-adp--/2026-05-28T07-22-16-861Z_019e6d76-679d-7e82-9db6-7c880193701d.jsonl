ery.common.dataobject.trade.SkuLogisticsServiceDetailTO;\r\nimport com.taobao.delivery.common.transfer.PartnerFeeDesc;\r\nimport com.taobao.delivery.common.util.DigitalUtils;\r\nimport com.taobao.usa.util.BooleanUtils;\r\nimport com.wdk.infrastructure.foundation.lang.ListUtils;\r\nimport org.apache.commons.collections4.CollectionUtils;\r\n\r\npublic class DeliveryTradeInputConverter {\r\n\r\n    @Resource\r\n    private PfPostTypeRuleService pfPostTypeRuleService;\r\n    @Resource\r\n    private PfTimingServiceInfoConverter pfTimingServiceInfoConverter;\r\n    @Resource\r\n    private PfPostTypeRuleQueryConverter pfPostTypeRuleQueryConverter;\r\n    @Resource\r\n    private PfAddressInfoConverter pfAddressInfoConverter;\r\n    @Resource\r\n    private PfBuyerInfoConverter pfBuyerInfoConverter;\r\n\r\n    public PfPostFeeRequest converterForAbility(AbilityQueryTOGroup abilityQueryGroup, DeliveryTimingDTO deliveryTimingDTO) {\r\n        if (Objects.isNull(abilityQueryGroup)) {\r\n            return null;\r\n        }\r\n        PfPostFeeRequest pfPostFeeRequest = new PfPostFeeRequest();\r\n        pfPostFeeRequest.setBuyer(this.pfBuyerInfoConverter.converterBuyerInfo(abilityQueryGroup.getBuyerInfoTO()));\r\n\r\n        pfPostFeeRequest.setPackages(ListUtils.transform(abilityQueryGroup.getAbilityQueryTOs(),\r\n            abilityQueryTO -> {\r\n                PackageTimingInfo packageTimingInfo = Optional.ofNullable(deliveryTimingDTO)\r\n                    .map(DeliveryTimingDTO::getPackageTimingInfoMap)\r\n                    .orElse(Maps.newHashMap())\r\n                    .get(abilityQueryTO.getOutOrderId());\r\n\r\n                return this.convertAbilityPackage(abilityQueryGroup, abilityQueryTO, packageTimingInfo);\r\n            }));\r\n        return pfPostFeeRequest;\r\n    }\r\n\r\n    public PfPostFeeRequest converterForConfirm(ConfirmQueryTOGroup confirmQueryTOGroup, DeliveryTimingDTO deliveryTimingDTO) {\r\n        if (Objects.isNull(confirmQueryTOGroup)) {\r\n            return null;\r\n        }\r\n        PfPostFeeRequest pfPostFeeRequest = new PfPostFeeRequest();\r\n        pfPostFeeRequest.setBuyer(this.pfBuyerInfoConverter.converterBuyerInfo(confirmQueryTOGroup.getBuyerInfoTO()));\r\n\r\n        pfPostFeeRequest.setPackages(ListUtils.transform(confirmQueryTOGroup.getOrderConfirmQueryTOs(),\r\n                orderConfirmQueryTO -> {\r\n                    PackageTimingInfo packageTimingInfo = Optional.ofNullable(deliveryTimingDTO)\r\n                        .map(DeliveryTimingDTO::getPackageTimingInfoMap)\r\n                        .orElse(Maps.newHashMap())\r\n                        .get(orderConfirmQueryTO.getOutOrderId());\r\n\r\n                    return this.convertConfirmPackage(confirmQueryTOGroup, orderConfirmQueryTO, packageTimingInfo);\r\n                }));\r\n        return pfPostFeeRequest;\r\n    }\r\n\r\n    private PfPostFeePackage convertAbilityPackage(AbilityQueryTOGroup abilityQueryTOGroup, AbilityQueryTO abilityQueryTO, PackageTimingInfo packageTimingInfo) {\r\n        PfPostFeePackage pfPostFeePackage = new PfPostFeePackage();\r\n        BuyerInfoTO buyerInfoTO = abilityQueryTOGroup.getBuyerInfoTO();\r\n\r\n        Long areaId = DigitalUtils.isPositive(buyerInfoTO.getDevisionCode()) ? buyerInfoTO.getDevisionCode()\r\n                : DeliveryConstant.AREA_ID_CHINA;\r\n        PfAddressInfo destination = pfAddressInfoConverter.toDestination(areaId);\r\n        pfPostFeePackage.setDestination(destination);\r\n        pfPostFeePackage.setPackageKey(abilityQueryTO.getOutOrderId());\r\n\r\n        pfPostFeePackage.setPkgTimeInfo(pfTimingServiceInfoConverter.converterPkgTimeInfo(packageTimingInfo));\r\n        pfPostFeePackage.setPostTypeRules(Lazy.let(() -> pfPostTypeRuleService.queryRule(pfPostTypeRuleQueryConverter.buildPackageRuleQuery(packageTimingInfo))));\r\n\r\n        boolean isConso = Optional.ofNullable(abilityQueryTO).map(AbilityQueryTO::getStdConsoAbilityQuery).isPresent();\r\n        PfConsolidationServiceType pfConsolidationServiceType = this.convertConsoServiceType(abilityQueryTO);\r\n        pfPostFeePackage.setItems(ListUtils.transform(abilityQueryTO.getItemPackageTOs(),\r\n                itemPackageTO -> this.convertPackageItem(itemPackageTO, isConso, pfConsolidationServiceType)));\r\n        pfPostFeePackage.setPostFeePromotionInfo(this.convertPromotionInfo(abilityQueryTO.getPromotionTO()));\r\n        List<LogisticsSaleMode> saleModes = filterLgRangeTypes(pfPostFeePackage.getSaleModes(), abilityQueryTO.getItemPackageTOs());\r\n        pfPostFeePackage.setSaleModes(saleModes);\r\n\r\n        pfPostFeePackage.setTradeStage(this.convertTradeStage(abilityQueryTO.getTradeStageTO()));\r\n        ItemPackageTO itemPackageTO = ListUtils.firstElementOf(abilityQueryTO.getItemPackageTOs());\r\n        pfPostFeePackage.setTradeSellType(LangUtil.defaultIfNull(itemPackageTO.getSellType(), null));\r\n\r\n        PfSellerInfo serviceTypeSeller = new PfSellerInfo();\r\n        final Optional<ItemDesc> itemDescTem = CollectionUtils.emptyIfNull(abilityQueryTO.getItemPackageTOs())\r\n                .stream()\r\n                .map(BaseItemPackageTO::getItemDesc)\r\n                .findFirst();\r\n        serviceTypeSeller.setSellerId(itemDescTem.map(ItemDesc::getUserId).orElse(null));\r\n        serviceTypeSeller.setSellerType(itemDescTem.map(ItemDesc::getUserType).orElse(null));\r\n        if (Objects.nonNull(serviceTypeSeller.getSellerId())) {\r\n            pfPostFeePackage.setSeller(serviceTypeSeller);\r\n        }\r\n        return pfPostFeePackage;\r\n    }\r\n\r\n    private List<LogisticsSaleMode> filterLgRangeTypes(List<LogisticsSaleMode> lgRangeTypes, List<ItemPackageTO> itemPackageTOs) {\r\n        if (CollectionUtils.isEmpty(lgRangeTypes)) {\r\n            return lgRangeTypes;\r\n        }\r\n        List<ItemDesc> itemDescList = ListUtils.emptyIfNull(itemPackageTOs).stream()\r\n            .map(BaseItemPackageTO::getItemDesc)\r\n            .filter(Objects::nonNull)\r\n            .collect(Collectors.toList());\r\n        return LgRangeTypeUtil.filterLgRangeTypes(lgRangeTypes, itemDescList);\r\n    }\r\n\r\n    private PfPostTypeRuleQuery buildPackageRuleQuery(PackageTimingInfo packageTimingInfo) {\r\n        if (Objects.isNull(packageTimingInfo)) {\r\n            return null;\r\n        }\r\n        return PfPostTypeRuleQuery.builder()\r\n            .serviceCodes(packageTimingInfo.getServiceCodes())\r\n            .build();\r\n    }\r\n\r\n    private PfPostFeePromotionInfo convertPromotionInfo(PromotionTO promotionTO) {\r\n        if (Objects.isNull(promotionTO)) {\r\n            return null;\r\n        }\r\n        PfPostFeePromotionInfo pfPostFeePromotionInfo = new PfPostFeePromotionInfo();\r\n        pfPostFeePromotionInfo.setSpecifyPostFee(promotionTO.getSpecifyPostFee());\r\n        DeliveryFeeCouponTO deliveryFeeCouponTO = promotionTO.getDeliveryFeeCouponTO();\r\n        if (Objects.nonNull(deliveryFeeCouponTO)) {\r\n            pfPostFeePromotionInfo.setPostFeeCoupon(new PfPostFeeCoupon(deliveryFeeCouponTO.getCouponId(), deliveryFeeCouponTO.getDiscountFee()));\r\n        }\r\n        return pfPostFeePromotionInfo;\r\n    }\r\n\r\n    private PfPostFeePackage convertConfirmPackage(ConfirmQueryTOGroup confirmQueryTOGroup, OrderConfirmQueryTO confirmQueryTO, PackageTimingInfo packageTimingInfo) {\r\n        PfPostFeePackage pfPostFeePackage = new PfPostFeePackage();\r\n        BuyerInfoTO buyerInfoTO = confirmQueryTOGroup.getBuyerInfoTO();\r\n\r\n        Long areaId = DigitalUtils.isPositive(buyerInfoTO.getDevisionCode()) ? buyerInfoTO.getDevisionCode()\r\n                : DeliveryConstant.AREA_ID_CHINA;\r\n        PfAddressInfo destination = pfAddressInfoConverter.toDestination(areaId);\r\n        pfPostFeePackage.setDestination(destination);\r\n        pfPostFeePackage.setPackageKey(confirmQueryTO.getOutOrderId());\r\n        pfPostFeePackage.setPkgTimeInfo(pfTimingServiceInfoConverter.converterPkgTimeInfo(packageTimingInfo));\r\n\r\n        boolean isConso = Optional.ofNullable(confirmQueryTO).map(OrderConfirmQueryTO::getStdConsoConfirmQuery).isPresent();\r\n        PfConsolidationServiceType pfConsolidationServiceType = this.convertConsoServiceType(confirmQueryTO);\r\n        pfPostFeePackage.setItems(ListUtils.transform(confirmQueryTO.getItemPackageTOs(),\r\n                itemPackageTO -> this.convertPackageItem(itemPackageTO, isConso, pfConsolidationServiceType)));\r\n        pfPostFeePackage.setPostFeePromotionInfo(this.convertPromotionInfo(confirmQueryTO.getPromotionTO()));\r\n        pfPostFeePackage.setSelectedPostType(this.convertSelectedPostType(confirmQueryTO.getSelectedFee()));\r\n        pfPostFeePackage.setUserSelectOptionsInfo(this.convertUserSelectOptionsInfo(confirmQueryTO.getSelectedFee(), confirmQueryTO));\r\n        pfPostFeePackage.setPostTypeRules(Lazy.let(() -> pfPostTypeRuleService.queryRule(pfPostTypeRuleQueryConverter.buildPackageRuleQuery(packageTimingInfo))));\r\n\r\n        pfPostFeePackage.setTradeStage(this.convertTradeStage(confirmQueryTO.getTradeStageTO()));\r\n        ItemPackageTO itemPackageTO = ListUtils.firstElementOf(confirmQueryTO.getItemPackageTOs());\r\n        pfPostFeePackage.setTradeSellType(LangUtil.defaultIfNull(itemPackageTO.getSellType(), null));\r\n\r\n        PfSellerInfo serviceTypeSeller = new PfSellerInfo();\r\n        final Optional<ItemDesc> itemDescTem = CollectionUtils.emptyIfNull(confirmQueryTO.getItemPackageTOs())\r\n                .stream()\r\n                .map(BaseItemPackageTO::getItemDesc)\r\n                .findFirst();\r\n        serviceTypeSeller.setSellerId(itemDescTem.map(ItemDesc::getUserId).orElse(null));\r\n        serviceTypeSeller.setSellerType(itemDescTem.map(ItemDesc::getUserType).orElse(null));\r\n\r\n        if (Objects.nonNull(serviceTypeSeller.getSellerId())) {\r\n            pfPostFeePackage.setSeller(serviceTypeSeller);\r\n        }\r\n\r\n        return pfPostFeePackage;\r\n    }\r\n\r\n    private PfTradeStage convertTradeStage(TradeStageTO tradeStageTO) {\r\n        if (Objects.isNull(tradeStageTO)) {\r\n            return null;\r\n        }\r\n\r\n        PfTradeStage pfTradeStage = new PfTradeStage();\r\n        pfTradeStage.setTradeMode(tradeStageTO.getTradeModel());\r\n        pfTradeStage.setTradeStage(tradeStageTO.getTradeStage());\r\n        return pfTradeStage;\r\n    }\r\n\r\n    private PfSelectedPostType convertSelectedPostType(FeeDesc selectedFee) {\r\n        if (Objects.isNull(selectedFee)) {\r\n            return null;\r\n        }\r\n        return PfSelectedPostType\r\n                .builder()\r\n                .firstPostType(PfPostTypeEnum.getByCode(selectedFee.getServiceType()))\r\n                .build();\r\n    }\r\n\r\n    private PfUserSelectOptionsInfo convertUserSelectOptionsInfo(FeeDesc selectedFee, OrderConfirmQueryTO orderConfirmQueryTO) {\r\n        if (Objects.isNull(selectedFee)) {\r\n            return null;\r\n        }\r\n        PfUserSelectOptionsInfo pfUserSelectOptionsInfo = new PfUserSelectOptionsInfo();\r\n        pfUserSelectOptionsInfo.setUserSelectFastOptionInfo(this.convertUserSelectFastOptionsInfo(selectedFee.getCompanyPosts()));\r\n        pfUserSelectOptionsInfo.setUserSelectPostTypeFee(this.convertUserSelectPostTypeFee(selectedFee, orderConfirmQueryTO));\r\n        return pfUserSelectOptionsInfo;\r\n    }\r\n\r\n    private PfPostFeeEntry convertUserSelectPostTypeFee(FeeDesc selectedFee, OrderConfirmQueryTO orderConfirmQueryTO) {\r\n        if (Objects.isNull(selectedFee)) {\r\n            return null;\r\n        }\r\n        PfPostFeeEntry postFeeEntry = new PfPostFeeEntry();\r\n        postFeeEntry.setPackageKey(orderConfirmQueryTO.getOutOrderId());\r\n        postFeeEntry.setPostType(selectedFee.getServiceType());\r\n        postFeeEntry.setPostFee(selectedFee.getFee());\r\n        postFeeEntry.setPostFeeUnit(selectedFee.getFeeUnit());\r\n        return postFeeEntry;\r\n    }\r\n\r\n    private List<PfUserSelectFastOptionInfo> convertUserSelectFastOptionsInfo(List<PartnerFeeDesc> companyPosts) {\r\n        if (Objects.isNull(companyPosts)) {\r\n            return null;\r\n        }\r\n        return ListUtils.transform(companyPosts, this::convertUserSelectFastOptionInfo);\r\n    }\r\n\r\n    private PfUserSelectFastOptionInfo convertUserSelectFastOptionInfo(PartnerFeeDesc partnerFee) {\r\n        if (Objects.isNull(partnerFee)) {\r\n            return null;\r\n        }\r\n        PfUserSelectFastOptionInfo optionInfo = new PfUserSelectFastOptionInfo();\r\n        optionInfo.setCompanyId(partnerFee.getCompanyId());\r\n        optionInfo.setCompanyCode(partnerFee.getCompanyCode());\r\n        optionInfo.setLimitTime(partnerFee.getLimitTime());\r\n        optionInfo.setPartnerName(partnerFee.getPartnerName());\r\n        optionInfo.setPostFee(partnerFee.getPostFee());\r\n        optionInfo.setPriority(partnerFee.getPriority());\r\n        optionInfo.setServiceIcon(partnerFee.getServiceIcon());\r\n        optionInfo.setSignDate(partnerFee.getSignDate());\r\n        optionInfo.setSignText(partnerFee.getSignText());\r\n        optionInfo.setShowTiming(partnerFee.isTmallConsign());\r\n        return optionInfo;\r\n    }\r\n\r\n\r\n    private PfPostFeePackageItem convertPackageItem(ItemPackageTO itemPackageTO, boolean isConso, PfConsolidationServiceType pfConsolidationServiceType) {\r\n        ItemDesc itemDesc = itemPackageTO.getItemDesc();\r\n        if (Objects.isNull(itemDesc)) {\r\n            return null;\r\n        }\r\n\r\n        PfPostFeePackageItem pfPostFeePackageItem = new PfPostFeePackageItem();\r\n        pfPostFeePackageItem.setCategoryId(itemDesc.getCategoryId());\r\n        pfPostFeePackageItem.setItemFeature(itemDesc.getFeatures());\r\n        pfPostFeePackageItem.setItemKey(KeyUtil.getItemKey(itemDesc.getItemId(), itemDesc.getSkuId()));\r\n        if (isConso) {\r\n            pfPostFeePackageItem.setConsoServiceType(pfConsolidationServiceType);\r\n        }\r\n        pfPostFeePackageItem.setItemTags(\r\n                CollectionUtils.isEmpty(itemDesc.getItemTags()) ? Sets.newHashSet() : itemDesc.getItemTags());\r\n        if (Objects.nonNull(itemDesc.getItemDescInventory()) && Objects.nonNull(\r\n                itemDesc.getItemDescInventory().getAvailableInventory())) {\r\n            pfPostFeePackageItem.setAvailableInventory(itemDesc.getItemDescInventory().getAvailableInventory());\r\n        }\r\n\r\n        pfPostFeePackageItem.setPostTypeRules(\r\n                Lazy.let(() -> pfPostTypeRuleService.queryRule(pfPostTypeRuleQueryConverter.buildRuleQuery(pfPostFeePackageItem))));\r\n\r\n        pfPostFeePackageItem.setItemId(itemDesc.getItemId());\r\n        pfPostFeePackageItem.setSellerId(itemDesc.getUserId());\r\n        pfPostFeePackageItem.setPrice(itemDesc.getItemValueLong());\r\n        pfPostFeePackageItem.setItemFbPrice(LgsItemPropertyUtil.getItemFbValueLong(itemDesc));\r\n        pfPostFeePackageItem.setItemAllFbPrice(LgsItemPropertyUtil.getItemAllFbValueLong(itemDesc));\r\n        pfPostFeePackageItem.setSize(itemDesc.getItemSizeLong());\r\n        pfPostFeePackageItem.setSkuFeature(itemDesc.getSkuFeatures());\r\n        pfPostFeePackageItem.setSkuId(itemDesc.getSkuId());\r\n        pfPostFeePackageItem.setGroupId(itemDesc.getGroupId());\r\n\r\n        pfPostFeePackageItem.setCount(\r\n                Long.valueOf(Optional.ofNullable(itemDesc.getItemCount()).orElse(DigitalUtils.INTEGER_ONE))\r\n        );\r\n\r\n        pfPostFeePackageItem.setStoreCodes(\r\n                new HashSet<>(CollectionUtils.emptyIfNull(itemDesc.getWareHouseCodes())));\r\n\r\n        pfPostFeePackageItem.setWeight(LgsItemPropertyUtil.getItemSkuWeight(itemDesc));\r\n        pfPostFeePackageItem.setItemAlgorithmWeight(\r\n            Optional.ofNullable(itemDesc.getItemLogisticsServiceDetail())\r\n                .map(ItemLogisticsServiceDetailTO::getLogisticsCommonTO)\r\n                .map(ItemLogisticsCommonTO::getCertificationWeight)\r\n                .orElse(null));\r\n        pfPostFeePackageItem.setSkuAlgorithmWeight(\r\n            Optional.ofNullable(itemDesc.getSkuLogisticsServiceDetail())\r\n                .map(SkuLogisticsServiceDetailTO::getLogisticsCommonTO)\r\n                .map(ItemLogisticsCommonTO::getCertificationWeight)\r\n                .orElse(null));\r\n        pfPostFeePackageItem.setSpecifyTemplateId(itemDesc.getTemplateId());\r\n        pfPostFeePackageItem.setTemplateId(itemDesc.getTemplateId());\r\n\r\n        PfPackageItemUnifiedPrice itemPrice = new PfPackageItemUnifiedPrice();\r\n        itemPrice.setSellerPay(!Objects.isNull(itemDesc.isSellerPay()) && itemDesc.isSellerPay());\r\n        itemPrice.setPostPrice(itemDesc.getUnifiedPostLong());\r\n        itemPrice.setExpressPrice(itemDesc.getUnifiedExpressLong());\r\n        itemPrice.setEmsPrice(itemDesc.getUnifiedEmsLong());\r\n        pfPostFeePackageItem.setUnifiedPrice(itemPrice);\r\n        assembleDiscountByItemPostFee(pfPostFeePackageItem,itemDesc.isPostFree());\r\n\r\n        return pfPostFeePackageItem;\r\n    }\r\n\r\n    private PfConsolidationServiceType convertConsoServiceType(AbilityQueryTO abilityQueryTO) {\r\n        PfConsolidationServiceType stdConsoServiceType = new PfConsolidationServiceType();\r\n        if (Objects.isNull(abilityQueryTO)\r\n                || Objects.isNull(abilityQueryTO.getStdConsoAbilityQuery())) {\r\n            return stdConsoServiceType;\r\n        }\r\n\r\n        StdConsoSolutionOptionTO stdConsoSolutionOptionTO = abilityQueryTO.getStdConsoAbilityQuery().getConsoSolutionOption();\r\n        List<StdConsoSegmentAbilityQueryTO> stdConsoSegmentAbilityQueryTOS = abilityQueryTO.getStdConsoAbilityQuery().getSegmentAbilityQueryList();\r\n        if (Objects.nonNull(stdConsoSolutionOptionTO)\r\n                && CollectionUtils.isNotEmpty(stdConsoSegmentAbilityQueryTOS) && stdConsoSegmentAbilityQueryTOS.size() == 2) {\r\n\r\n            Optional<StdConsoSegmentAbilityQueryTO> firstSegment = ListUtils.firstElementOf(stdConsoSegmentAbilityQueryTOS, BaseStdConsoSegment::isFirstSegment);\r\n            Optional<StdConsoSegmentAbilityQueryTO> secondSegment = ListUtils.firstElementOf(stdConsoSegmentAbilityQueryTOS, BaseStdConsoSegment::isLastSegment);\r\n            WarehouseNode secondSegmentFromWarehouse = (WarehouseNode)secondSegment.get().getFrom();\r\n            AddressNode secondSegmentToAddress = (AddressNode)secondSegment.get().getTo();\r\n            stdConsoServiceType.setAddress(Optional.ofNullable(secondSegmentToAddress)\r\n                    .map(AddressNode::getDivisionId)\r\n                    .map(pfAddressInfoConverter::toDestination)\r\n                    .orElse(null));\r\n\r\n            stdConsoServiceType.setStoreCode(\r\n                    Optional.ofNullable(secondSegmentFromWarehouse).map(WarehouseNode::getStoreCode)\r\n                            .orElse(null));\r\n            stdConsoServiceType.setConsoTypes(Sets.newHashSet(stdConsoSolutionOptionTO.getRequestSolutionList()));\r\n        }\r\n        return stdConsoServiceType;\r\n    }\r\n\r\n    private PfConsolidationServiceType convertConsoServiceType(OrderConfirmQueryTO confirmQueryTO) {\r\n        PfConsolidationServiceType stdConsoServiceType = new PfConsolidationServiceType();\r\n        if (Objects.isNull(confirmQueryTO)\r\n                || Objects.isNull(confirmQueryTO.getStdConsoConfirmQuery())) {\r\n            return stdConsoServiceType;\r\n        }\r\n\r\n        StdConsoSolutionOptionTO stdConsoSolutionOptionTO = confirmQueryTO.getStdConsoConfirmQuery().getConsoSolutionOption();\r\n        List<StdConsoSegmentConfirmQueryTO> stdConsoSegmentAbilityQueryTOS = confirmQueryTO.getStdConsoConfirmQuery().getSegmentConfirmQuery();\r\n        if (Objects.nonNull(stdConsoSolutionOptionTO)\r\n                && CollectionUtils.isNotEmpty(stdConsoSegmentAbilityQueryTOS) && stdConsoSegmentAbilityQueryTOS.size() == 2) {\r\n\r\n            Optional<StdConsoSegmentConfirmQueryTO> secondSegment = ListUtils.firstElementOf(stdConsoSegmentAbilityQueryTOS, BaseStdConsoSegment::isLastSegment);\r\n            WarehouseNode secondSegmentFromWarehouse = (WarehouseNode)secondSegment.get().getFrom();\r\n            AddressNode secondSegmentToAddress = (AddressNode)secondSegment.get().getTo();\r\n            stdConsoServiceType.setAddress(Optional.ofNullable(secondSegmentToAddress)\r\n                    .map(AddressNode::getDivisionId)\r\n                    .map(pfAddressInfoConverter::toDestination)\r\n                    .orElse(null));\r\n\r\n            stdConsoServiceType.setStoreCode(\r\n                    Optional.ofNullable(secondSegmentFromWarehouse).map(WarehouseNode::getStoreCode)\r\n                            .orElse(null));\r\n            stdConsoServiceType.setConsoTypes(Sets.newHashSet(stdConsoSolutionOptionTO.getRequestSolutionList()));\r\n        }\r\n        return stdConsoServiceType;\r\n    }\r\n\r\n    private void assembleDiscountByItemPostFee(PfPostFeePackageItem pfPostFeePackageItem,Boolean itemPostFee) {\r\n        PfPostFeeDiscount discount = new PfPostFeeDiscount();\r\n        discount.setPostFree(BooleanUtils.isTrue(itemPostFee));\r\n        pfPostFeePackageItem.setDiscount(discount);\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779953503215}}
