       newProtocol.setUserChooseLogisticsInfoDO(newUserChooseLogisticsInfoDO);\r\n        return newProtocol;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.core.option.ProtocolOptionsDO transProtocolOptionDO(ProtocolOptionsDO oldOption) {\r\n        if (oldOption == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.core.option.ProtocolOptionsDO newOption\r\n            = new com.alibaba.delivery.platform.common.model.core.option.ProtocolOptionsDO();\r\n        newOption.setMendianOptionDO(transMendian(oldOption.getMendianOptionDO()));\r\n        newOption.setBuyerSelectFastOptionDOList(transBuyerSelect(oldOption.getBuyerSelectFastOptionDOList()));\r\n        newOption.setCodOptionDO(transCod(oldOption.getCodOptionDO()));\r\n        newOption.setDistributionTimingOptionDO(transDistributionOption(oldOption.getDistributionTimingOptionDO()));\r\n        return newOption;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.core.option.DistributionTimingOptionDO transDistributionOption(\r\n        DistributionTimingOptionDO oldDistribution) {\r\n        if (oldDistribution == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.core.option.DistributionTimingOptionDO newDistribution\r\n            = new com.alibaba.delivery.platform.common.model.core.option.DistributionTimingOptionDO();\r\n        newDistribution.setServiceIcon(oldDistribution.getServiceIcon());\r\n        newDistribution.setFeeDO(transFee(oldDistribution.getFeeDO()));\r\n        newDistribution.setDistributionTimingDO(transoldDistribution(oldDistribution.getDistributionTimingDO()));\r\n        return newDistribution;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.core.timing.DistributionTimingDO transoldDistribution(DistributionTimingDO oldDistribution) {\r\n        if (oldDistribution == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.core.timing.DistributionTimingDO newDistribution\r\n            = new com.alibaba.delivery.platform.common.model.core.timing.DistributionTimingDO();\r\n        newDistribution.setAppointDateBackword(oldDistribution.getAppointDateBackword());\r\n        newDistribution.setSelectSign(oldDistribution.getSelectSign());\r\n        newDistribution.setSelectStandardSignRange(oldDistribution.getSelectStandardSignRange());\r\n        newDistribution.setProtocolId(oldDistribution.getProtocolId());\r\n        newDistribution.setTimingType(oldDistribution.getTimingType());\r\n        newDistribution.setSignRanges(oldDistribution.getSignRanges());\r\n        newDistribution.setStandardSignRanges(oldDistribution.getStandardSignRanges());\r\n        newDistribution.setTagMap(oldDistribution.getTagMap());\r\n        newDistribution.setWaveTime(oldDistribution.getWaveTime());\r\n        newDistribution.setWayDay(oldDistribution.getWayDay());\r\n        newDistribution.setUpperSign(oldDistribution.getUpperSign());\r\n        newDistribution.setStoreCode(oldDistribution.getStoreCode());\r\n        newDistribution.setPayTimeTip(oldDistribution.getPayTimeTip());\r\n        newDistribution.setLowerSign(oldDistribution.getLowerSign());\r\n        // newDistribution.setAppointPromotionDO();\r\n        // newDistribution.setDateValues();\r\n        newDistribution.setDefaultSelected(oldDistribution.isDefaultSelected());\r\n        return newDistribution;\r\n    }\r\n\r\n    private static com.alibaba.delivery.platform.common.model.core.option.CodOptionDO transCod(CodOptionDO oldCod) {\r\n        if (oldCod == null) {\r\n            return null;\r\n        }\r\n        com.alibaba.delivery.platform.common.model.core.option.CodOptionDO newCod\r\n            = new com.alibaba.delivery.platform.common.model.core.option.CodOptionDO();\r\n        newCod.setServiceFee(oldCod.getServiceFee());\r\n        newCod.setSellerRate