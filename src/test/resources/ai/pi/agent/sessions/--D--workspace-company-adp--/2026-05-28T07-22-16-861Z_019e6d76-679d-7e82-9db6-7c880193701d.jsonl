eStrategy)) {\r\n                continue;\r\n            }\r\n\r\n            String[] bizCodeToOrderShipTimeAggregateStrategy = StringUtils.split(orderShipTimeAggregateStrategy, \"-\");\r\n            if (bizCodeToOrderShipTimeAggregateStrategy == null\r\n                    || bizCodeToOrderShipTimeAggregateStrategy.length != 2) {\r\n                continue;\r\n            }\r\n\r\n            String bizCode = bizCodeToOrderShipTimeAggregateStrategy[0];\r\n            String orderShipTimeAggregateStrategyType = bizCodeToOrderShipTimeAggregateStrategy[1];\r\n            if (StringUtils.isBlank(bizCode) || StringUtils.isBlank(orderShipTimeAggregateStrategyType)) {\r\n                continue;\r\n            }\r\n            map.put(bizCode, orderShipTimeAggregateStrategyType);\r\n        }\r\n        bizCodeToOrderShipTimeAggregateStrategyMap = map;\r\n    }\r\n\r\n    public static void setOpenTmallBrandSdpPredictSignTimeInvalidInAbility(boolean openTmallBrandSdpPredictSignTimeInvalidInAbility) {\r\n        AdpPlatformBizConfig.openTmallBrandSdpPredictSignTimeInvalidInAbility = openTmallBrandSdpPredictSignTimeInvalidInAbility;\r\n    }\r\n\r\n    public static void setOpenTmallBrandAdpPredictSignTimeInvalidInAbility(boolean openTmallBrandAdpPredictSignTimeInvalidInAbility) {\r\n        AdpPlatformBizConfig.openTmallBrandAdpPredictSignTimeInvalidInAbility = openTmallBrandAdpPredictSignTimeInvalidInAbility;\r\n    }\r\n\r\n    public static void setOpenRefineItemSignTimeTransfer(boolean openRefineItemSignTimeTransfer) {\r\n        AdpPlatformBizConfig.openRefineItemSignTimeTransfer = openRefineItemSignTimeTransfer;\r\n    }\r\n\r\n    public static void setAdpProductServiceIAbilityBlackBizCodeSet(Set<String> adpProductServiceIAbilityBlackBizCodeSet) {\r\n        AdpPlatformBizConfig.adpProductServiceIAbilityBlackBizCodeSet = adpProductServiceIAbilityBlackBizCodeSet;\r\n    }\r\n\r\n    public static void setAdpSpiRenderIAbilityWhiteBizCodeSet(Set<String> adpSpiRend