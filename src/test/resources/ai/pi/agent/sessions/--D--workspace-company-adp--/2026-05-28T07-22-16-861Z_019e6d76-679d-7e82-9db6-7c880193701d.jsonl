{"type":"message","id":"a95421c9","parentId":"8fe597aa","timestamp":"2026-05-28T07:48:47.938Z","message":{"role":"toolResult","toolCallId":"call_fbf8fa59d7c24fbaadadeb2a","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.logistics.ability.shiptime.strategy.decide.carrier.impl;\r\n\r\nimport com.alibaba.delivery.logistics.ability.shiptime.strategy.decide.carrier.IDecideCarrierShipTimeStrategy;\r\nimport com.alibaba.delivery.logistics.entity.core.constant.ShipTypeEnum;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeDO;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeDTO;\r\nimport com.alibaba.delivery.logistics.entity.params.channel.ClientChannelDTO;\r\nimport com.alibaba.delivery.logistics.entity.params.targets.DeliveryCarrierDTO;\r\nimport com.alibaba.delivery.logistics.utils.ShipTimeUtils;\r\n\r\n/**\r\n * @author Qingheng\r\n * @date 2024/4/8\r\n */\r\npublic class PromotionDeliveryShipTimingDecideStrategy implements IDecideCarrierShipTimeStrategy {\r\n    @Override\r\n    public ShipTimeDTO decide(ShipTimeDO shipTimeDO, ClientChannelDTO clientChannelDTO, Integer userType, DeliveryCarrierDTO carrierDTO) {\r\n        if (shipTimeDO == null) {\r\n            return null;\r\n        }\r\n        return ShipTimeUtils.shipTimeDO2DTO(shipTimeDO);\r\n    }\r\n\r\n    @Override\r\n    public ShipTypeEnum getType() {\r\n        return ShipTypeEnum.PROMOTION_DELIVERY_SHIP_TIMING;\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779954527938}}
{"type":"message","id":"67c2cb67","parentId":"a95421c9","timestamp":"2026-05-28T07:48:47.938Z","message":{"role":"toolResult","toolCallId":"call_604330e51b494af69fabeb0a","toolName":"read","content":[{"type":"text","text":"package com.alibaba.delivery.logistics.ability.shiptime.strategy.render.carrier.impl;\r\n\r\nimport com.alibaba.delivery.logistics.ability.shiptime.strategy.render.carrier.ICarrierShipTimeRenderStrategy;\r\nimport com.alibaba.delivery.logistics.entity.core.constant.ShipTypeEnum;\r\nimport com.alibaba.delivery.logistics.entity.core.timing.ShipTimeDTO;\r\nimport com.alibaba.delivery.logistics.entity.params.channel.ClientChannelDTO;\r\nimport com.alibaba.delivery.logistics.entity.params.option.AdpOption;\r\nimport com.alibaba.delivery.logistics.entity.params.targets.DeliveryCarrierDTO;\r\nimport com.alibaba.delivery.logistics.utils.ShipTimeUtils;\r\nimport com.alibaba.delivery.rule.diamond.shiptime.AdpShipTimeConfig;\r\nimport com.taobao.delivery.common.transfer.ShipTimeTO;\r\nimport org.apache.commons.lang3.StringUtils;\r\nimport org.apache.commons.lang3.math.NumberUtils;\r\nimport org.apache.commons.lang3.tuple.Pair;\r\n\r\n/**\r\n * @author Qingheng\r\n * @date 2024/4/8\r\n */\r\npublic class PromotionDeliveryShipTimingRenderStrategy implements ICarrierShipTimeRenderStrategy {\r\n    @Override\r\n    public ShipTimeTO render(ShipTimeDTO shipTimeDTO, ClientChannelDTO clientChannelDTO, Integer userType, AdpOption adpOption, Long sellerId, DeliveryCarrierDTO deliveryCarrierDTO) {\r\n        if (shipTimeDTO == null || userType == null) {\r\n            return null;\r\n        }\r\n\r\n        Pair<String, String> timePair = ShipTimeUtils.getStructShipTime(shipTimeDTO.getShipTime());\r\n        if (timePair == null) {\r\n            return null;\r\n        }\r\n\r\n        String type = timePair.getLeft();\r\n        String time = timePair.getRight();\r\n\r\n        if (StringUtils.isBlank(type) || StringUtils.isBlank(time)) {\r\n            return null;\r\n        }\r\n\r\n        String text = null;\r\n        // ���ʱ��\r\n        if (ShipTimeUtils.isRelativeTime(type)) {\r\n            if (!NumberUtils.isCreatable(time) || Integer.parseInt(time) < 1) {\r\n                //���Сʱ��û��\r\n                return null;\r\n            }\r\n            int shipDay = Integer.parseInt(time);\r\n            if (shipDay <= AdpShipTimeConfig.getInstance().getShipTimeConverterHourMaxDay()) {\r\n                text = String.format(AdpShipTimeConfig.getInstance().getConsignInHour(), 24 * shipDay);\r\n            } else {\r\n                text = String.format(AdpShipTimeConfig.getInstance().getConsignInDay(), time);\r\n            }\r\n        }\r\n\r\n        // ����ʱ��\r\n        if (ShipTimeUtils.isAbsoluteTime(type)) {\r\n            // Y��Y��24��ǰ����\r\n            String format = ShipTimeUtils.formatAbsoluteText(time, ShipTimeUtils.DATE_FMT, AdpShipTimeConfig.getInstance().getPromotionDeliveryShipAbsoluteFormat());\r\n            if (StringUtils.isNotBlank(format)) {\r\n                text = String.format(AdpShipTimeConfig.getInstance().getPromotionDeliveryShipAbsoluteText(), format);\r\n            }\r\n        }\r\n\r\n        if (StringUtils.isNotBlank(text)) {\r\n            return ShipTimeUtils.shipTimeDTO2TO(shipTimeDTO, text);\r\n        }\r\n        return null;\r\n    }\r\n\r\n    @Override\r\n    public ShipTypeEnum getType() {\r\n        return ShipTypeEnum.PROMOTION_DELIVERY_SHIP_TIMING;\r\n    }\r\n}\r\n"}],"isError":false,"timestamp":1779954527938}}
